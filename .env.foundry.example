# Foundry / fork RPC keys — copy values into a root `.env` (gitignored).
# Never commit real keys. GitHub Actions uses repository secret ALCHEMY_KEY (same name).

# Required for named Alchemy RPC endpoints in foundry.toml
ALCHEMY_KEY=

# Optional Infura (if you use *_infura endpoints)
# INFURA_KEY=

# Optional fork block pins (TestBase_BaseFork and eth equivalents)
# BASE_FORK_BLOCK=
# ETH_FORK_BLOCK=

# Optional full RPC URL fallbacks used by some TestBases
# BASE_RPC_URL=
# ETH_RPC_URL=
# ROBINHOOD_RPC_URL=
