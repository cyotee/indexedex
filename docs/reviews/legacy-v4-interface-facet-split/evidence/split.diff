+/// @notice Owns all eight ERC-5115 methods on the legacy V4 vault proxy.
+contract UniswapV4StandardYieldFacet is UniswapV4StandardYieldTarget, IFacet {
+    function facetName() public pure override returns (string memory name) {
+        return type(UniswapV4StandardYieldFacet).name;
+    }
+
