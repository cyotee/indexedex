@@ -0,0 +1,44 @@
+// SPDX-License-Identifier: BSL-1.1
+pragma solidity ^0.8.0;
+
+import {IERC20} from "@crane/contracts/interfaces/IERC20.sol";
+import {ERC20Repo} from "@crane/contracts/tokens/ERC20/ERC20Repo.sol";
+import {FixedPointMathLib} from "@crane/contracts/utils/FixedPointMathLib.sol";
+import {Math} from "@crane/contracts/utils/Math.sol";
+import {UniswapV4StandardExchangeConfig as Config} from "./internal/UniswapV4StandardExchangeConfig.sol";
+import {UniswapV4StandardExchangeAccounting as Accounting} from "./internal/UniswapV4StandardExchangeAccounting.sol";
+import {UniswapV4StandardYieldExecutionTarget} from "./UniswapV4StandardYieldExecutionTarget.sol";
+
+/// @notice Complete ERC-5115 surface for the legacy V4 Standard Exchange.
+contract UniswapV4StandardYieldTarget is UniswapV4StandardYieldExecutionTarget {
+    function getTokensIn() public view override returns (address[] memory tokens) {
+        tokens = new address[](2);
+        tokens[0] = Config._token0();
+        tokens[1] = Config._token1();
+    }
+
+    function getTokensOut() public view override returns (address[] memory) {
+        return getTokensIn();
+    }
+
+    function yieldToken() external pure override returns (address) {
+        return address(0);
+    }
+
+    function exchangeRate() external view override returns (uint256) {
+        uint256 supply = ERC20Repo._totalSupply();
+        if (supply == 0) return 1e18;
+        (uint256 reserve0, uint256 reserve1) = Accounting._totalVaultReserves();
+        return Math.mulDiv(FixedPointMathLib.mulSqrt(reserve0, reserve1), 1e18, supply);
+    }
+
+    function previewDeposit(address tokenIn_, uint256 amount_) external view override returns (uint256) {
+        if (!Config._isValidToken(tokenIn_)) return 0;
+        return Accounting._previewExchangeIn(IERC20(tokenIn_), amount_, IERC20(address(this)));
+    }
+
+    function previewRedeem(address tokenOut_, uint256 shares_) external view override returns (uint256) {
+        if (!Config._isValidToken(tokenOut_)) return 0;
+        return Accounting._previewExchangeIn(IERC20(address(this)), shares_, IERC20(tokenOut_));
+    }
+}
