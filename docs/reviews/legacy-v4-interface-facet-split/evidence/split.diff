+    UniswapV4StandardExchangeCustody as Custody
+} from "contracts/protocols/dexes/uniswap/v4/internal/UniswapV4StandardExchangeCustody.sol";
+import {
+    UniswapV4StandardExchangePoolOps as PoolOps
+} from "contracts/protocols/dexes/uniswap/v4/internal/UniswapV4StandardExchangePoolOps.sol";
+
+/// @notice Internal exact-input execution without an external interface entrypoint.
+abstract contract UniswapV4StandardExchangeInExecution is ReentrancyLockModifiers, StandardExchangeInExecutionBase {
+    function _exchangeIn(
+        IERC20 tokenIn,
+        uint256 amountIn,
+        IERC20 tokenOut,
+        uint256 minAmountOut,
+        address recipient,
+        bool pretransferred,
+        uint256 deadline
+    ) internal override nonReentrant returns (uint256 amountOut) {
+        Config._requireNotDisabled();
+        if (deadline < block.timestamp) revert Config.UniswapV4ExchangeIn_DeadlineExceeded();
+
+        address token0 = Config._token0();
+        address token1 = Config._token1();
+
+        if (
+            (address(tokenIn) == token0 && address(tokenOut) == token1)
+                || (address(tokenIn) == token1 && address(tokenOut) == token0)
+        ) {
+            uint256 actualIn = Custody._secureTokenTransfer(tokenIn, amountIn, pretransferred);
+            amountOut = PoolOps._executeDirectSwapIn(address(tokenIn), actualIn, recipient);
+            if (amountOut < minAmountOut) revert Config.UniswapV4ExchangeIn_SlippageExceeded();
+            Config._pokeBoundPoolTwap();
+            return amountOut;
+        }
+
+        if ((address(tokenIn) == token0 || address(tokenIn) == token1) && address(tokenOut) == address(this)) {
+            uint256 actualIn = Custody._secureTokenTransfer(tokenIn, amountIn, pretransferred);
+            amountOut = PoolOps._executeZapInDeposit(address(tokenIn), actualIn, minAmountOut, recipient);
+            Config._pokeBoundPoolTwap();
+            return amountOut;
+        }
+
+        if (address(tokenIn) == address(this) && (address(tokenOut) == token0 || address(tokenOut) == token1)) {
+            uint256 actualIn = Custody._secureShareDelivery(amountIn, pretransferred);
+            amountOut =
+                PoolOps._executeZapOutExactIn(address(tokenOut), actualIn, minAmountOut, recipient, address(this));
+            Config._pokeBoundPoolTwap();
+            return amountOut;
+        }
+
+        revert IStandardExchangeIn.ExchangeInNotAvailable();
+    }
+}
