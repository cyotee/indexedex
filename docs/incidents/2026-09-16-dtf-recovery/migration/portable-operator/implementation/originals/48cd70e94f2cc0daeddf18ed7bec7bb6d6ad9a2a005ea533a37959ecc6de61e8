on()":{"details":"Expiration delay for scheduled proposals. Defaults to 1 week.\n     *\n     * IMPORTANT: Avoid overriding the expiration with 0. Otherwise every contract proposal will be expired immediately,\n     * disabling any scheduling usage.\n     "},"getAccess(uint64,address)":{"details":"Get the access details for a given account for a given role. These details include the timepoint at which\n     * membership becomes active, and the delay applied to all operations by this user that requires this permission\n     * level.\n     *\n     * Returns:\n     * [0] Timestamp at which the account membership becomes valid. 0 means role is not granted.\n     * [1] Current execution delay for the account.\n     * [2] Pending execution delay for the account.\n     * [3] Timestamp at which the pending execution delay will become active. 0 means no delay update is scheduled.\n     "},"getAdminRole(uint256)":{"details":"`ADMIN_ROLE` is not accessible via any index.Admin roles with no assigned members or managed roles are also accessible.","params":{"index":"The index in the admin role list."},"returns":{"_0":"The identifier of the admin role."}},"getAdminRoleCount()":{"details":"`ADMIN_ROLE` is not included in the admin role count.Admin roles with no assigned members or managed roles are also taken into account.","returns":{"_0":"The number of admin roles."}},"getAdminRoles(uint256,uint256)":{"details":"`ADMIN_ROLE` is not accessible via any index.Admin roles with no assigned members or managed roles are also accessible.","params":{"start":"The starting index for the admin role list.","end":"The ending index for the admin role list."},"returns":{"_0":"The list of admin role identifiers."}},"getLabelOfRole(uint64)":{"details":"`PUBLIC_ROLE` and `ADMIN_ROLE` cannot be labeled.Reverts with `AccessManagerUnlabeledRole` if the role has no assigned label.","params":{"roleId":"The identifier of the role."},"returns":{"_0":"The label of the role."}},"getNonce(bytes32)":{"details":"Return the nonce for the latest scheduled operation with a given id. Returns 0 if the operation has never\n     * been scheduled.\n     "},"getRole(uint256)":{"details":"`PUBLIC_ROLE` and `ADMIN_ROLE` are not accessible via any index.Roles with no assigned members are also accessible.","params":{"index":"The index in the role list."},"returns":{"_0":"The identifier of the role."}},"getRoleAdmin(uint64)":{"details":"Get the id of the role that acts as an admin for the given role.\n     *\n     * The admin permission is required to grant the role, revoke the role and update the execution delay to execute\n     * an operation that is restricted to this role.\n     "},"getRoleCount()":{"details":"`PUBLIC_ROLE` and `ADMIN_ROLE` are not included in the role count.Roles with no assigned members are also taken into account.","returns":{"_0":"The number of roles."}},"getRoleGrantDelay(uint64)":{"details":"Get the role current grant delay.\n     *\n     * Its value may change at any point without an event emitted following a call to {setGrantDelay}.\n     * Changes to this value, including effect timepoint are notified in advance by the {RoleGrantDelayChanged} event.\n     "},"getRoleGuardian(uint64)":{"details":"Get the role that acts as a guardian for a given role.\n     *\n     * The guardian permission allows canceling operations that have been scheduled under the role.\n     "},"getRoleLabel(uint256)":{"params":{"index":"The index in the labeled role list."},"returns":{"_0":"The label at the index."}},"getRoleLabels(uint256,uint256)":{"params":{"start":"The starting index for the labeled role list.","end":"The ending index for the labeled role list."},"returns":{"_0":"The list of role labels."}},"getRoleMember(uint64,uint256)":{"params":{"roleId":"The identifier of the role.","index":"The index in the role member list."},"returns":{"_0":"The address of the role member."}},"getRoleMemberCount(uint64)":{"params":{"roleId":"The identifier of the role."},"returns":{"_0":"The number of members for the role."}},"getRoleMembers(uint64,uint256,uint256)":{"params":{"roleId":"The identifier of the role.","start":"The starting index for the member list.","end":"The ending index for the member list."},"returns":{"_0":"The list of members for the role."}},"getRoleOfAdminRole(uint64,uint256)":{"details":"Roles managed by the `ADMIN_ROLE` are not accessible.","params":{"adminRoleId":"The identifier of the admin role.","index":"The index in the list of roles managed by the admin role."},"returns":{"_0":"The identifier of the role."}},"getRoleOfAdminRoleCount(uint64)":{"details":"Roles managed by the `ADMIN_ROLE` are not accessible.","params":{"adminRoleId":"The identifier of the admin role."},"returns":{"_0":"The number of roles managed by the admin role."}},"getRoleOfLabel(string)":{"details":"Reverts with `AccessManagerUnregisteredLabel` if the label is not assigned to any role.","params":{"label":"The label string."},"returns":{"_0":"The identifier of the role."}},"getRoleOfTargetSelector(address,bytes4)":{"params":{"target":"The address of the target contract.","selector":"The function selector."},"returns":{"_0":"The identifier of the role."}},"getRoleTarget(uint64,uint256)":{"details":"Target contracts assigned to `ADMIN_ROLE` are not accessible.","params":{"roleId":"The identifier of the role.","index":"The index in the role target list."},"returns":{"_0":"The address of the target contract."}},"getRoleTargetCount(uint64)":{"details":"Target contracts assigned to `ADMIN_ROLE` are not accessible.","params":{"roleId":"The identifier of the role."},"returns":{"_0":"The number of target contracts for the role."}},"getRoleTargetSelector(uint64,address,uint256)":{"details":"Target selectors assigned to `ADMIN_ROLE` are not accessible.","params":{"roleId":"The identifier of the role.","target":"The address of the target contract.","index":"The index in the role member list."},"returns":{"_0":"The selector at the index."}},"getRoleTargetSelector