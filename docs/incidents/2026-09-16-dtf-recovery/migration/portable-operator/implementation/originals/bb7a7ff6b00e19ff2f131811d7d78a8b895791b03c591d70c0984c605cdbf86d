etCuts\",\"inputs\":[],\"outputs\":[{\"name\":\"facetCuts_\",\"type\":\"tuple[]\",\"internalType\":\"struct IDiamond.FacetCut[]\",\"components\":[{\"name\":\"facetAddress\",\"type\":\"address\",\"internalType\":\"address\"},{\"name\":\"action\",\"type\":\"uint8\",\"internalType\":\"enum IDiamond.FacetCutAction\"},{\"name\":\"functionSelectors\",\"type\":\"bytes4[]\",\"internalType\":\"bytes4[]\"}]}],\"stateMutability\":\"view\"},{\"type\":\"function\",\"name\":\"facetInterfaces\",\"inputs\":[],\"outputs\":[{\"name\":\"interfaces\",\"type\":\"bytes4[]\",\"internalType\":\"bytes4[]\"}],\"stateMutability\":\"pure\"},{\"type\":\"function\",\"name\":\"initAccount\",\"inputs\":[],\"outputs\":[{\"name\":\"\",\"type\":\"bool\",\"internalType\":\"bool\"}],\"stateMutability\":\"nonpayable\"},{\"type\":\"function\",\"name\":\"initAccount\",\"inputs\":[{\"name\":\"pkg\",\"type\":\"address\",\"internalType\":\"contract IDiamondFactoryPackage\"},{\"name\":\"pkgArgs\",\"type\":\"bytes\",\"internalType\":\"bytes\"}],\"outputs\":[{\"name\":\"\",\"type\":\"bool\",\"internalType\":\"bool\"}],\"stateMutability\":\"nonpayable\"},{\"type\":\"function\",\"name\":\"pkgArgsOfAccount\",\"inputs\":[{\"name\":\"account\",\"type\":\"address\",\"internalType\":\"address\"}],\"outputs\":[{\"name\":\"pkgArgs\",\"type\":\"bytes\",\"internalType\":\"bytes\"}],\"stateMutability\":\"view\"},{\"type\":\"function\",\"name\":\"pkgConfig\",\"inputs\":[],\"outputs\":[{\"name\":\"pkg\",\"type\":\"address\",\"internalType\":\"contract IDiamondFactoryPackage\"},{\"name\":\"args\",\"type\":\"bytes\",\"internalType\":\"bytes\"}],\"stateMutability\":\"view\"},{\"type\":\"function\",\"name\":\"pkgOfAccount\",\"inputs\":[{\"name\":\"account\",\"type\":\"address\",\"internalType\":\"address\"}],\"outputs\":[{\"name\":\"pkg\",\"type\":\"address\",\"internalType\":\"contract IDiamondFactoryPackage\"}],\"stateMutability\":\"view\"},{\"type\":\"function\",\"name\":\"postDeploy\",\"inputs\":[{\"name\":\"account\",\"type\":\"address\",\"internalType\":\"address\"}],\"outputs\":[{\"name\":\"\",\"type\":\"bool\",\"internalType\":\"bool\"}],\"stateMutability\":\"nonpayable\"},{\"type\":\"function\",\"name\":\"postDeployFacetCuts\",\"inputs\":[],\"outputs\":[{\"name\":\"facetCuts_\",\"type\":\"tuple[]\",\"internalType\":\"struct IDiamond.FacetCut[]\",\"components\":[{\"name\":\"facetAddress\",\"type\":\"address\",\"internalType\":\"address\"},{\"name\":\"action\",\"type\":\"uint8\",\"internalType\":\"enum IDiamond.FacetCutAction\"},{\"name\":\"functionSelectors\",\"type\":\"bytes4[]\",\"internalType\":\"bytes4[]\"}]}],\"stateMutability\":\"view\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"constructor\":{\"details\":\"These facets are installed on *every* Diamond proxy deployed via this factory (see facetCuts).\\n     *      The factory itself does not use storage Repos; uses immutables for facets + transient mappings (pkgOfAccount etc) only during init callback.\\n     *      Matches IDiamondPackageCallBackFactoryInit.InitArgs.\",\"params\":{\"init\":\"Struct holding the four required immutable facet references (must be pre-deployed, non-zero).\"},\"custom:throws\":\"(none)\",\"custom:selector\":\"(constructor)\\n     \"},\"deploy(address,bytes)\":{\"details\":\"Flow (see IDiamondPackageCallBackFactory diagram):\\n     *      1. Compute salt via pkg.calcSalt (via adaptor), then combine with pkg for unique salt.\\n     *      2. Predict address; early return if already deployed.\\n     *      3. processArgs, record (pkg, args) for the callback context (pkgConfig), call updatePkg.\\n     *      4. CREATE2 the MinimalDiamondCallBackProxy (which delegatecalls factory.initAccount on construction).\\n     *      5. Inside initAccount: install base facets + package's diamondConfig facets, call pkg._initAccount.\\n     *      6. Call pkg.postDeploy and the hook removal.\\n     *      This factory is intended to be deployed *once* per ecosystem and reused across chains/consumers.\",\"params\":{\"pkg\":\"The IDiamondFactoryPackage providing facets, cuts, init logic, and salt calc.\",\"pkgArgs\":\"Package-specific arguments (ABI encoded PkgArgs typically); not part of salt for recalc simplicity.\"},\"returns\":{\"proxy\":\"The deterministic address of the deployed (or pre-existing) Diamond proxy.\"},\"custom:signature\":\"deploy(address,bytes)\",\"custom:selector\":\"0xe97fac05\",\"custom:emits\":\"IDiamond.DiamondCut (multiple times: base + package config + post-deploy removal)\",\"custom:throws\":\"DeploymentAddressMismatch if CREATE2 address math fails.\"},\"facetInterfaces()\":{\"details\":\"These are declared via ERC165 on the proxy during initAccount; enables external discovery of base capabilities.\",\"returns\":{\"interfaces\":\"Array of 3 interface IDs.\"},\"custom:signature\":\"facetInterfaces()\",\"custom:selector\":\"0x2ea80826\\n     \"},\"facetCuts()\":{\"details\":\"Used in the base phase of initAccount before package config is applied. Corresponds to the facets from constructor InitArgs.\",\"returns\":{\"facetCuts_\":\"The base cuts used for the factory's contribution to proxy diamond config.\"},\"custom:signature\":\"facetCuts()\",\"custom:selector\":\"0xa4b3ad35\\n     \"},\"erc8109Funcs()\":{\"details\":\"Helper to avoid hardcoding; used by facetCuts for the ERC8109Introspection facet.\",\"returns\":{\"funcs\":\"Array containing IERC8109Introspection.functionFacetPairs.selector .\"},\"custom:signature\":\"erc8109Funcs()\",\"custom:selector\":\"0x7cbde55d\\n     \"},\"calcAddress(address,bytes)\":{\"details\":\"Uses same salt logic as deploy (but note calcSalt on pkg, not _calcSalt adaptor necessarily). Does not consume gas for deploy.\\n     *      Matches the early-return path in deploy().\",\"params\":{\"pkg\":\"The package.\",\"pkgArgs\":\"The args (will be passed through pkg.calcSalt inside).\"},\"returns\":{\"_0\":\"The CREATE2 predicted proxy address.\"},\"custom:signature\":\"calcAddress(address,bytes)\",\"custom:selector\":\"0x33a41d70\"},\"initAccount()\":{\"details\":\"Resolves the pending (pkg, args) via pkgConfig (which uses msg.sender == the new proxy)\\n     *      then delegates to the two-arg variant. Historical code paths are commented for reference.\\n     *      This 0-arg version is the one the MinimalDiamondCallBackProxy actually delegatecalls during construction.\",\"returns\":{\"_0\":\"success Always true on completion.\"},\"custom:signature\":\"initAccount()\",\"custom:selector\":\"0x4ec1ce21\"},\"initAccount(address,bytes)\":{\"details\":\"This is the two-arg variant called by the 0-arg callback after resolving pkgConfig.\\n     *      It performs the actual ERC2535 cuts and interface registration + package _initAccount.\",\"params\":{\"pkg\":\"The package.\",\"pkgArgs\":\"The processed init args.\"},\"returns\":{\"_0\":\"success True.\"},\"custom:signature\":\"initAccount(address,bytes)\",\"custom:selector\":\"0x8e85783e\",\"custom:emits\":\"IDiamond.DiamondCut (for base via SELF, and for package config)\"},\"pkgConfig()\":{\"details\":\"Uses msg.sender to lookup the transient registration done in deploy(). Only valid during the init delegatecall window.\\n     *      After postDeploy the mappings still hold the values (for off-chain query).\",\"returns\":{\"pkg\":\"The package for the caller proxy.\",\"args\":\"The processed args.\"},\"custom:signature\":\"pkgConfig()\",\"custom:selector\":\"0x8072e14e\"},\"postDeploy(address)\":{\"details\":\"Removes the POST_DEPLOY_HOOK_FACET via a Remove cut. Virtual for overrides.\\n     *      Called by the proxy itself via the hook facet (which delegates back).\",\"params\":{\"account\":\"The account (ignored; impl uses msg.sender).\"},\"returns\":{\"_0\":\"success True.\"},\"custom:signature\":\"postDeploy(address)\",\"custom:selector\":\"0x70068fcf\\n     \"},\"postDeployFacetCuts()\":{\"details\":\"Virtual to allow potential overrides in subclasses. The remove uses the facet's funcs to clean all its selectors.\",\"returns\":{\"facetCuts_\":\"Single Remove cut for POST_DEPLOY_HOOK_FACET.\"},\"custom:signature\":\"postDeployFacetCuts()\",\"custom:selector\":\"0xd5a7944d\\n     \"}},\"author\":\"cyotee doge <not_cyotee@proton.me>\",\"details\":\"Deployed once via Create3Factory (see Create3Factory.diamondPackageFactory()). Safe and intended for reuse by any consumer on any chain.\\n *      The callback flow (user -> deploy -> proxy ctor delegatecalls initAccount -> cuts + pkg init -> postDeploy) is documented in IDiamondPackageCallBackFactory.\\n *      No storage Repos used; state is immutables + per-account transient mappings cleared post-init.\",\"errors\":{\"DeploymentAddressMismatch(address,address)\":[{\"params\":{\"expected\":\"The address predicted before CREATE2.\",\"actual\":\"The address that was actually created.\"},\"custom:selector\":\"0x37dd4fb4\\n     \"}]},\"stateVariables\":{\"PROXY_INIT_HASH\":{\"return\":\"The keccak256 hash of the proxy creationCode.\",\"returns\":{\"_0\":\"The keccak256 hash of the proxy creationCode.\"},\"custom:signature\":\"PROXY_INIT_HASH()\",\"custom:selector\":\"0x1c8b7630\"},\"ERC165_FACET\":{\"return\":\"The ERC165 facet address.\",\"returns\":{\"_0\":\"The ERC165 facet address.\"},\"custom:signature\":\"ERC165_FACET()\",\"custom:selector\":\"0x421d0c7b\"},\"DIAMOND_LOUPE_FACET\":{\"return\":\"The DiamondLoupe facet address.\",\"returns\":{\"_0\":\"The DiamondLoupe facet address.\"},\"custom:signature\":\"DIAMOND_LOUPE_FACET()\",\"custom:selector\":\"0x978d23cf\"},\"ERC8109_INTROSPECTION_FACET\":{\"details\":\"Note: exposed publicly for introspection but the getter on interface is POST_DEPLOY_HOOK etc. (not part of public IDiamondPackageCallBackFactory surface).\",\"custom:signature\":\"ERC8109_INTROSPECTION_FACET()\\n     \"},\"POST_DEPLOY_HOOK_FACET\":{\"custom:signature\":\"POST_DEPLOY_HOOK_FACET()\",\"custom:selector\":\"0xbce46817\"},\"pkgOfAccount\":{\"custom:signature\":\"pkgOfAccount(address)\",\"custom:selector\":\"0x8a648684\"},\"pkgArgsOfAccount\":{\"custom:signature\":\"pkgArgsOfAccount(address)\",\"custom:selector\":\"0x3f58dd6d\"}},\"title\":\"DiamondPackageCallBackFactory\",\"custom:interfaceid\":\"0x949da331\",\"custom:see\":\"IDiamondPackageCallBackFactory\\n \",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"constructor\":{\"notice\":\"Constructs the factory wiring the required base facets (ERC165, Loupe, ERC8109, PostDeployHook).\"},\"PROXY_INIT_HASH()\":{\"notice\":\"The initCode hash of the MinimalDiamondCallBackProxy used for CREATE2 address prediction.\"},\"ERC165_FACET()\":{\"notice\":\"Immutable reference to the ERC165 facet installed on every proxy by this factory.\"},\"DIAMOND_LOUPE_FACET()\":{\"notice\":\"Immutable reference to the DiamondLoupe facet installed on every proxy by this factory.\"},\"ERC8109_INTROSPECTION_FACET()\":{\"notice\":\"Immutable reference to the ERC8109 introspection facet installed on every proxy.\"},\"POST_DEPLOY_HOOK_FACET()\":{\"notice\":\"Immutable reference to the post-deploy hook facet (temporarily installed, removed after init).\"},\"pkgOfAccount(address)\":{\"notice\":\"Returns the package that was used to deploy (or is deploying) the given proxy account.\"},\"pkgArgsOfAccount(address)\":{\"notice\":\"Returns the (processed) package args associated with a deployed proxy account.\"},\"deploy(address,bytes)\":{\"notice\":\"Deploys (or returns existing) a Diamond proxy instance for the given DFPkg + args.\"},\"facetInterfaces()\":{\"notice\":\"Returns the base interfaces installed by this factory on all proxies (ERC165 + Loupe + ERC8109).\"},\"facetCuts()\":{\"notice\":\"Returns the 4 base facet cuts (Add) applied to every new proxy during initAccount (ERC165, Loupe, ERC8109, PostHook).\"},\"erc8109Funcs()\":{\"notice\":\"Returns the single function selector from the ERC8109 facet used in base cuts.\"},\"calcAddress(address,bytes)\":{\"notice\":\"Predicts the deterministic proxy address for a pkg + pkgArgs without deploying.\"},\"initAccount()\":{\"notice\":\"Callback entrypoint invoked by the proxy constructor (via delegatecall).\"},\"initAccount(address,bytes)\":{\"notice\":\"Core initialization logic (can also be called directly in tests).\\n     *         Applies factory base cuts, package config cuts, registers interfaces, invokes package init.\"},\"pkgConfig()\":{\"notice\":\"Called by the proxy (during its init callback) to retrieve the package/args for *this* deployment.\"},\"postDeploy(address)\":{\"notice\":\"Post deploy hook invoked on the proxy (after package postDeploy) to clean up the temp hook facet.\"},\"postDeployFacetCuts()\":{\"notice\":\"Returns the cut used to remove the temporary post-deploy hook facet after init.\"}},\"errors\":{\"DeploymentAddressMismatch(address,address)\":[{\"notice\":\"Thrown when the predicted CREATE2 address does not match the actually deployed address.\"}]},\"notice\":\"Deploys deterministic Diamond proxy instances from IDiamondFactoryPackage (DFPkg) bundles using CREATE2 + delegatecall callback for init.\\n *         This is the main factory for instantiating user accounts/proxies from packages. It installs a standard set of base facets on every proxy\\n *         (ERC165, DiamondLoupe, ERC8109Introspection, and a temporary PostDeploy hook) before delegating to the package for its config + initAccount.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"lib/crane/contracts/factories/diamondPkg/DiamondPackageCallBackFactory.sol\":\"DiamondPackageCallBackFactory\"},\"evmVersion\":\"osaka\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":1},\"remappings\":[\"@battlechain-contracts/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/src/\",\"@crane/=lib/crane/\",\"@matterlabs/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/lib/battlechain-contracts/lib/\",\"@nomicfoundation/=node_modules/@nomicfoundation/\",\"@opengsn/=node_modules/@opengsn/\",\"@openzeppelin/=no