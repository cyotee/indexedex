rameter` have to be corrected to account for this when comparing to `rawEndValue`.\n     *","params":{"rawEndValue":"The desired ending value of the amplification parameter","endTime":"The timestamp when the amplification parameter update is complete\n     "}},"stopAmplificationParameterUpdate()":{"details":"Stops the amplification parameter change process, keeping the current value."},"supportsInterface(bytes4)":{"details":"See {IERC165-supportsInterface}.\n     "},"version()":{"returns":{"_0":"version The stored contract version\n     "}}},"version":1},"userdoc":{"kind":"user","methods":{"computeBalance(uint256[],uint256,uint256)":{"notice":"Computes a new token balance, given the invariant growth ratio and all other balances."},"computeInvariant(uint256[],uint8)":{"notice":"Computes the pool's invariant."},"getAggregateFeePercentages()":{"notice":"Gets the aggregate swap and yield fee percentages for a pool."},"getAmplificationParameter()":{"notice":"Get all the amplification parameters."},"getAmplificationState()":{"notice":"Get the full state of any ongoing or scheduled amplification parameter update."},"getCurrentLiveBalances()":{"notice":"Gets the current live balances of the pool as fixed point, 18-decimal numbers."},"getStablePoolDynamicData()":{"notice":"Get dynamic pool data relevant to swap/add/remove calculations."},"getStablePoolImmutableData()":{"notice":"Get immutable pool data relevant to swap/add/remove calculations."},"getStaticSwapFeePercentage()":{"notice":"Fetches the static swap fee percentage for the pool."},"getTokenInfo()":{"notice":"Gets the raw data for the pool: tokens, token info, raw balances, and last live balances."},"getTokens()":{"notice":"Gets the tokens registered in the pool."},"onSwap((uint8,uint256,uint256[],uint256,uint256,address,bytes))":{"notice":"Execute a swap in the pool."},"startAmplificationParameterUpdate(uint256,uint256)":{"notice":"Begins changing the amplification parameter to `rawEndValue` over time."},"version()