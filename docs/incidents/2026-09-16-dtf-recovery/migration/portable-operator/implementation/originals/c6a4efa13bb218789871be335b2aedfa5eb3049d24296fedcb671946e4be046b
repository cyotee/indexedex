tails\":\"Called once per launch by the factory, immediately after minting\\n     * the full-range position directly to this locker's address.\\n     \"},\"pendingOwner()\":{\"details\":\"Returns the address of the pending owner.\\n     \"},\"transferOwnership(address)\":{\"details\":\"Starts the ownership transfer of the contract to a new account. Replaces the pending transfer if there is one.\\n     * Can only be called by the current owner.\\n     *\\n     * Setting `newOwner` to the zero address is allowed; this can be used to cancel an initiated ownership transfer.\\n     \"},\"acceptOwnership()\":{\"details\":\"The new owner accepts the ownership transfer.\\n     \"},\"owner()\":{\"details\":\"Returns the address of the current owner.\\n     \"}},\"errors\":{\"OwnableUnauthorizedAccount(address)\":[{\"details\":\"The caller account is not authorized to perform an operation.\\n     \"}],\"OwnableInvalidOwner(address)\":[{\"details\":\"The owner is not a valid owner account. (eg. `address(0)`)\\n     \"}]},\"title\":\"PonsV2LaunchLocker\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"setFactory(address)\":{\"notice\":\"One-time wiring of the v2 factory, set after both are deployed.\\n     \"},\"renounceOwnership()\":{\"notice\":\"Permanently disabled. Ownership here exists only to perform the\\n     * one-time factory wiring, and renouncing before that wiring would leave\\n     * the locker unable to ever accept a graduated position.\\n     \"},\"onERC721Received(address,address,uint256,bytes)\":{\"notice\":\"Rejects safe transfers of anything but a canonical position NFT.\"},\"lockPosition(address,uint256)\":{\"notice\":\"Registers and verifies permanent custody of a graduated position.\"},\"lockTokenSupply(address,uint256)\":{\"notice\":\"Permanently locks the virtual-reserve token remainder that\\n     * cannot enter the graduated pool without lowering its opening price.\\n     \"},\"isLocked(address)\":{\"notice\":\"Returns whether a launch's position has been locked here.\\n     \"}},\"notice\":\"Permanently holds the graduated Uniswap V4 position NFT for every\\n * pons v2 launch. Unlike v1's locker, there is no `collectFees()` here: fee\\n * collection and distribution belong entirely to PonsV2MemeHook and\\n * PonsV2FeeEscrow, since a V4 position accrues fees inside the singleton\\n * PoolManager rather than on the NFT itself. This contract exposes no\\n * withdrawal or arbitrary-call function, so locked liquidity can never be\\n * removed by an administrator.\\n \",\"version\":1}},\"settings\":{\"compilationTarget\":{\"lib/crane/contracts/protocols/launchpads/ponsFamily/v2/PonsV2LaunchLocker.sol\":\"PonsV2LaunchLocker\"},\"evmVersion\":\"osaka\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":1},\"remappings\":[\"@battlechain-contracts/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/src/\",\"@crane/=lib/crane/\",\"@matterlabs/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/lib/battlechain-contracts/lib/\",\"@nomicfoundation/=node_modules/@nomicfoundation/\",\"@opengsn/=node_modules/@opengsn/\",\"@openzeppelin/=node_modules/@openzeppelin/\",\"@oz/=lib/crane/lib/openzeppelin-contracts/\",\"@ozu/=lib/crane/contracts/external/openzeppelin-upgradeable/\",\"battlechain-contracts/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/lib/battlechain-contracts/\",\"battlechain-lib-mocks/=lib/crane/lib/battlechain-lib/test/mocks/\",\"battlechain-lib/=lib/crane/lib/battlechain-lib/src/\",\"battlechain-safe-harbor-contracts/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/\",\"chainlink-ccip/=lib/crane/lib/chainlink-local/lib/chainlink-ccip/chains/evm/contracts/vendor/optimism/interop-lib/v0/src/\",\"chainlink-evm/=lib/crane/lib/chainlink-local/lib/chainlink-evm/\",\"chainlink-local/=lib/crane/lib/chainlink-local/src/\",\"clones/=lib/crane/contracts/external/clones-with-immutable-args/