8.38+commit.e7a91fc7.solar.0.3.0-dev\"},\"language\":\"Solidity\",\"output\":{\"abi\":[{\"type\":\"error\",\"name\":\"GraduationSeedNotViable\",\"inputs\":[]},{\"type\":\"error\",\"name\":\"InvalidTick\",\"inputs\":[{\"name\":\"tick\",\"type\":\"int24\",\"internalType\":\"int24\"}]},{\"type\":\"error\",\"name\":\"SafeCastOverflow\",\"inputs\":[]},{\"type\":\"error\",\"name\":\"SqrtPriceOutOfBounds\",\"inputs\":[]},{\"type\":\"error\",\"name\":\"UnsupportedPrice\",\"inputs\":[]},{\"type\":\"error\",\"name\":\"ZeroAmount\",\"inputs\":[]},{\"type\":\"function\",\"name\":\"assertSeedable\",\"inputs\":[{\"name\":\"token\",\"type\":\"address\",\"internalType\":\"address\"},{\"name\":\"pairToken\",\"type\":\"address\",\"internalType\":\"address\"},{\"name\":\"tickSpacing\",\"type\":\"int24\",\"internalType\":\"int24\"},{\"name\":\"quoteAmount\",\"type\":\"uint256\",\"internalType\":\"uint256\"},{\"name\":\"tokenAmount\",\"type\":\"uint256\",\"internalType\":\"uint256\"}],\"outputs\":[],\"stateMutability\":\"pure\"},{\"type\":\"function\",\"name\":\"assertSeedableEitherOrdering\",\"inputs\":[{\"name\":\"tickSpacing\",\"type\":\"int24\",\"internalType\":\"int24\"},{\"name\":\"quoteAmount\",\"type\":\"uint256\",\"internalType\":\"uint256\"},{\"name\":\"tokenAmount\",\"type\":\"uint256\",\"internalType\":\"uint256\"}],\"outputs\":[],\"stateMutability\":\"pure\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"assertSeedable(address,address,int24,uint256,uint256)\":{\"params\":{\"token\":\"Launch token being seeded.\",\"pairToken\":\"Quote asset of the pool; the zero address for native ETH.\",\"tickSpacing\":\"Pool tick spacing the position spans.\",\"quoteAmount\":\"Quote-asset side of the seed.\",\"tokenAmount\":\"Launch-token side of the seed.\\n     \"}},\"assertSeedableEitherOrdering(int24,uint256,uint256)\":{\"details\":\"Launch terms are checked before the launch token exists, so the\\n     * ordering the PoolKey will use is not yet known. Requiring both is the\\n     * conservative reading, and the two agree in practice: the sqrt price\\n     * range is symmetric about 1 and the liquidity formula is invariant under\\n     * inverting the price and swapping the amounts with it.\",\"params\":{\"tickSpacing\":\"Pool tick spacing the position spans.\",\"quoteAmount\":\"Quote-asset side of the seed.\",\"tokenAmount\":\"Launch-token side of the seed.\\n     \"}}},\"stateVariables\":{\"MAX_SEED_AMOUNT\":{\"details\":\"V4 carries pool balance changes in a `BalanceDelta` whose halves are\\n     * `int128`, and `Pool.modifyLiquidity` narrows each side with\\n     * `SafeCast.toInt128`. The PositionManager's `MINT_POSITION` ABI accepts\\n     * `uint128`, so an amount in between passes every field-width check and\\n     * still reverts inside V4 core. The signed bound is the real one.\\n     \"}},\"title\":\"PonsV2GraduationGuard\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"assertSeedable(address,address,int24,uint256,uint256)\":{\"notice\":\"Verifies a launch can initialize and mint a nonzero, full-range\\n     * V4 position without lossy amount narrowing.\"},\"assertSeedableEitherOrdering(int24,uint256,uint256)\":{\"notice\":\"Verifies a seed of these proportions mints under either currency\\n     * ordering.\"}},\"notice\":\"Stateless preflight for a graduation's Uniswap V4 seed. It keeps\\n * the tick and liquidity math outside PonsV2LaunchFactory's runtime bytecode\\n * while modelling the rejections of the real mint, so a launch can never\\n * drain its curve into a seed the PositionManager or V4 core would reject.\\n *\\n * The preflight has to mirror the whole downstream call graph rather than the\\n * PositionManager's ABI field widths alone. Phase one is irreversible: it\\n * marks the curve graduated and moves its reserves to the factory, so a seed\\n * that passes here and reverts in V4 leaves the launch permanently unseedable\\n * and recoverable only through the owner's delayed rescue path.\\n \",\"version\":1}},