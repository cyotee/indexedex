\"},\"dropReserve(address)\":{\"notice\":\"Drop a reserve\"},\"syncIndexesState(address)\":{\"notice\":\"Accumulates interest to all indexes of the reserve\"},\"syncRatesState(address)\":{\"notice\":\"Updates interest rates on the reserve data\"},\"setConfiguration(address,(uint256))\":{\"notice\":\"Sets the configuration bitmap of the reserve as a whole\"},\"getConfiguration(address)\":{\"notice\":\"Returns the configuration of the reserve\"},\"getUserConfiguration(address)\":{\"notice\":\"Returns the configuration of the user across all the reserves\"},\"getReserveNormalizedIncome(address)\":{\"notice\":\"Returns the normalized income of the reserve\"},\"getReserveNormalizedVariableDebt(address)\":{\"notice\":\"Returns the normalized variable debt per unit of asset\"},\"getReserveData(address)\":{\"notice\":\"Returns the state and configuration of the reserve\"},\"getVirtualUnderlyingBalance(address)\":{\"notice\":\"Returns the virtual underlying balance of the reserve\"},\"finalizeTransfer(address,address,address,uint256,uint256)\":{\"notice\":\"Validates and finalizes an aToken transfer\"},\"getReservesList()\":{\"notice\":\"Returns the list of the underlying assets of all the initialized reserves\"},\"getReservesCount()\":{\"notice\":\"Returns the number of initialized reserves\"},\"getReserveAddressById(uint16)\":{\"notice\":\"Returns the address of the underlying asset of a reserve by the reserve id as stored in the DataTypes.ReserveData struct\"},\"ADDRESSES_PROVIDER()\":{\"notice\":\"Returns the PoolAddressesProvider connected to this contract\"},\"RESERVE_INTEREST_RATE_STRATEGY()\":{\"notice\":\"Returns the ReserveInterestRateStrategy connected to all the reserves\"},\"updateFlashloanPremium(uint128)\":{\"notice\":\"Updates flash loan premium. All this premium is collected by the protocol treasury.\"},\"configureEModeCategory(uint8,(uint16,uint16,uint16,string))\":{\"notice\":\"Configures a new or alters an existing collateral configuration of an eMode.\"}