ction\",\"name\":\"weth\",\"inputs\":[],\"outputs\":[{\"name\":\"\",\"type\":\"address\",\"internalType\":\"contract HermeticWETH\"}],\"stateMutability\":\"view\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"constructor\":{\"params\":{\"existingPkg\":\"Package deployed by an earlier fixture of the same family (multi-leg\"}},\"fund(address,uint256)\":{\"details\":\"HermeticWETH has no mint: deal ETH to the fixture, wrap, forward.\"},\"limitCapacity(uint256)\":{\"details\":\"Remaining deposit-pool capacity in ETH; the SE's soft stake takes `min(overage, allow)`\"},\"armOperativeRevert()\":{\"details\":\"The SE's operative stake is `deposit()` on the deposit pool, called after the capacity\"}},\"details\":\"WETH→SE mints then soft-stakes the overage above the liquid target through the deposit\\n *      pool, capped by `getMaximumDepositAmount()` (D22 / D31). `limitCapacity(allow)` sets that\\n *      cap on the hermetic pool, so input above `allow` stays booked as WETH on the SE;\\n *      `seBooked()` reports the SE's booked WETH reserve (`reserveOfToken(weth)`, synced to the\\n *      WETH balance at the end of every route). `armOperativeRevert` rejects the pool's\\n *      `deposit()` after both prechecks (capacity, minimum) pass. rETH burn collateral is\\n *      pre-funded so the WETH pay ladder can cover an exit larger than the sleeve.\\n \",\"errors\":{\"DependencyRejected(bytes32)\":[{\"details\":\"Non-SUT dependency failure payload used by `armOperativeRevert` implementations.\"}]},\"stateVariables\":{\"DEFAULT_LIQUID_PCT\":{\"details\":\"Mirrors `TestBase_RocketPoolRETHStandardExchange.DEFAULT_LIQUID_PCT` (20% sleeve).\"},\"BURN_COLLATERAL\":{\"details\":\"ETH collateral on the hermetic rETH so `burn` can back any WETH exit in these rows.\"}},\"title\":\"SeMatrix_RocketFixture\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"constructor\":{\"notice\":\"        hooks build one fixture per leg); `address(0)` deploys the package.\"},\"pkg()\":{\"n