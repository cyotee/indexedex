,\"type\":\"address[]\",\"internalType\":\"address[]\"},{\"name\":\"wethIsEth\",\"type\":\"bool\",\"internalType\":\"bool\"},{\"name\":\"userData\",\"type\":\"bytes\",\"internalType\":\"bytes\"}],\"outputs\":[{\"name\":\"amountsOut\",\"type\":\"uint256[]\",\"internalType\":\"uint256[]\"}],\"stateMutability\":\"payable\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"addLiquidityUnbalancedToERC4626Pool(address,bool[],uint256[],uint256,bool,bytes)\":{\"details\":\"An \\\"ERC4626 pool\\\" contains IERC4626 yield-bearing tokens (e.g., waDAI). Ensure that any buffers associated\\n     * with the wrapped tokens in the ERC4626 pool have been initialized before initializing or adding liquidity to\\n     * the \\\"parent\\\" pool, and also make sure limits are set properly.\\n     *\",\"params\":{\"pool\":\"Address of the liquidity pool\",\"wrapUnderlying\":\"Flags indicating whether the corresponding token should be wrapped or used as an ERC20\",\"exactAmountsIn\":\"Exact amounts of underlying/wrapped tokens in, sorted in token registration order\",\"minBptAmountOut\":\"Minimum amount of pool tokens to be received\",\"wethIsEth\":\"If true, incoming ETH will be wrapped to WETH and outgoing WETH will be unwrapped to ETH\",\"userData\":\"Additional (optional) data required for adding liquidity\"},\"returns\":{\"bptAmountOut\":\"Actual amount of pool tokens received\\n     \"}},\"queryAddLiquidityUnbalancedToERC4626Pool(address,bool[],uint256[],address,bytes)\":{\"details\":\"An \\\"ERC4626 pool\\\" contains IERC4626 yield-bearing tokens (e.g., waDAI).\",\"params\":{\"pool\":\"Address of the liquidity pool\",\"wrapUnderlying\":\"Flags indicating whether the corresponding token should be wrapped or used as an ERC20\",\"exactAmountsIn\":\"Exact amounts of underlying/wrapped tokens in, sorted in token registration order\",\"sender\":\"The sender passed to the operation. It can influence results (e.g., with user-dependent hooks)\",\"userData\":\"Additional (optional) data required for the query\"},\"returns\":{\"bptAmountOut\":\"Expected amount of pool tokens to receive\\n     \"}},\"addLiquidityProportionalToERC4626Pool(address,bool[],uint256[],uint256,bool,bytes)\":{\"details\":\"An \\\"ERC4626 pool\\\" contains IERC4626 yield-bearing tokens (e.g., waDAI). Ensure that any buffers associated\\n     * with the wrapped tokens in the ERC4626 pool have been initialized before initializing or adding liquidity to\\n     * the \\\"parent\\\" pool, and also make sure limits are set properly.\\n     *\",\"params\":{\"pool\":\"Address of the liquidity pool\",\"wrapUnderlying\":\"Flags indicating whether the corresponding token should be wrapped or used as an ERC20\",\"maxAmountsIn\":\"Maximum amounts of underlying/wrapped tokens in, sorted in token registration order\",\"exactBptAmountOut\":\"Exact amount of pool tokens to be received\",\"wethIsEth\":\"If true, incoming ETH will be wrapped to WETH and outgoing WETH will be unwrapped to ETH\",\"userData\":\"Additional (optional) data required for adding liquidity\"},\"returns\":{\"amountsIn\":\"Actual amounts of tokens added to the pool\\n     \"}},\"queryAddLiquidityProportionalToERC4626Pool(address,bool[],uint256,address,bytes)\":{\"details\":\"An \\\"ERC4626 pool\\\" contains IERC4626 yield-bearing tokens (e.g., waDAI).\",\"params\":{\"pool\":\"Address of the liquidity pool\",\"wrapUnderlying\":\"Flags indicating whether the corresponding token should be wrapped or used as an ERC20\",\"exactBptAmountOut\":\"Exact amount of pool tokens to be received\",\"sender\":\"The sender passed to the operation. It can influence results (e.g., with user-dependent hooks)\",\"userData\":\"Additional (optional) data required for the query\"},\"returns\":{\"amountsIn\":\"Expected amounts of tokens added to the pool\\n     \"}},\"removeLiquidityProportionalFromERC4626Pool(address,bool[],uint256,uint256[],bool,bytes)\":{\"details\":\"An \\\"ERC4626 pool\\\" contains IERC4626 yield-bearing tokens (e.g., waDAI).\",\"params\":{\"pool\":\"Address of the liquidity pool\",\"unwrapWrapped\":\"Flags indicating whether the corresponding token should be unwrapped or used as an ERC20\",\"exactBptAmountIn\":\"Exact amount of pool tokens provided\",\"minAmountsOut\":\"Minimum amounts of each token, sorted in token registration order\",\"wethIsEth\":\"If true, incoming ETH will be wrapped to WETH and outgoing WETH will be unwrapped to ETH\",\"userData\":\"Additional (optional) data required for removing liquidity\"},\"returns\":{\"amountsOut\":\"Actual amounts of tokens received\\n     \"}},\"queryRemoveLiquidityProportionalFromERC4626Pool(address,bool[],uint256,address,bytes)\":{\"details\":\"An \\\"ERC4626 pool\\\" contains IERC4626 yield-bearing tokens (e.g., waDAI).\",\"params\":{\"pool\":\"Address of the liquidity pool\",\"unwrapWrapped\":\"Flags indicating whether the corresponding token should be unwrapped or used as an ERC20\",\"exactBptAmountIn\":\"Exact amount of pool tokens provided for the query\",\"sender\":\"The sender passed to the operation. It can influence results (e.g., with user-dependent hooks)\",\"userData\":\"Additional (optional) data required for the query\"},\"returns\":{\"amountsOut\":\"Expected amounts of tokens to receive\\n     \"}},\"addLiquidityUnbalancedNestedPool(address,address[],uint256[],address[],uint256,bool,bytes)\":{\"details\":\"A nested pool is one in which one or more tokens are BPTs from another pool (child pool). Since there are\\n     * multiple pools involved, the token order is not well-defined, and must be specified by the caller. If the parent\\n     * or nested pools contain ERC4626 tokens that appear in the `tokensToWrap` list, they will be wrapped and their\\n     * underlying tokens pulled as input, and expected to appear in `tokensIn`. Otherwise, they will be treated as\\n     * regular tokens.\\n     *\\n     * NB: Pools with \\\"overlapping\\\" tokens (i.e., both the parent and a child pool contain one or more of the tokens in\\n     * `tokensIn`), are not supported! The gas cost to explicitly detect this rare edge case would be prohibitive, so\\n     * behavior in this case is undefined.\\n     *\",\"params\":{\"parentPool\":\"The address of the parent pool (which contains BPTs of other pools)\",\"tokensIn\":\"An array with all tokens from the child pools, and all non-BPT parent tokens, in arbitrary order\",\"exactAmountsIn\":\"An array with the amountIn of each token, sorted in the same order as tokensIn\",\"tokensToWrap\":\"A list of ERC4626 tokens which should be wrapped if encountered during pool traversal\",\"minBptAmountOut\":\"Expected minimum amount of parent pool tokens to receive\",\"wethIsEth\":\"If true, incoming ETH will be wrapped to WETH and outgoing WETH will be unwrapped to ETH\",\"userData\":\"Additional (optional) data required for the operation\"},\"returns\":{\"bptAmountOut\":\"The actual amount of parent pool tokens received\\n     \"}},\"queryAddLiquidityUnbalancedNestedPool(address,address[],uint256[],address[],address,bytes)\":{\"params\":{\"parentPool\":\"The address of the parent pool (which contains BPTs of other pools)\",\"tokensIn\":\"An array with all tokens from the child pools, and all non-BPT parent tokens, in arbitrary order\",\"exactAmountsIn\":\"An array with the amountIn of each token, sorted in the same order as tokensIn\",\"tokensToWrap\":\"A list of ERC4626 tokens which should be wrapped if encountered during pool traversal\",\"sender\":\"The sender passed to the operation. It can influence results (e.g., with user-dependent hooks)\",\"userData\":\"Additional (optional) data required for the operation\"},\"returns\":{\"bptAmountOut\":\"The actual amount of parent pool tokens received\\n     \"}},\"removeLiquidityProportionalNestedPool(address,uint256,address[],uint256[],address[],bool,bytes)\":{\"details\":\"A nested pool is one in which one or more tokens are BPTs from another pool (child pool). Since there are\\n     * multiple pools involved, the token order is not well-defined, and must be specified by the caller. If the parent\\n     * or nested pools contain ERC4626 tokens that appear in the `tokensToUnwrap` list, they will be unwrapped and\\n     * their underlying tokens sent to the output. Otherwise, they will be treated as regular tokens.\\n     *\",\"params\":{\"parentPool\":\"The address of the parent pool (which contains BPTs of other pools)\",\"exactBptAmountIn\":\"The exact amount of `parentPool` tokens provided\",\"tokensOut\":\"An array with all tokens from the child pools, and all non-BPT parent tokens, in arbitrary order\",\"minAmountsOut\":\"An array with the minimum amountOut of each token, sorted in the same order as tokensOut\",\"tokensToUnwrap\":\"A list of ERC4626 tokens which should be unwrapped if encountered during pool traversal\",\"wethIsEth\":\"If true, incoming ETH will be wrapped to WETH and outgoing WETH will be unwrapped to ETH\",\"userData\":\"Additional (optional) data required for the operation\"},\"returns\":{\"amountsOut\":\"An array with the actual amountOut of each token, sorted in the same order as tokensOut\\n     \"}},\"queryRemoveLiquidityProportionalNestedPool(address,uint256,address[],address[],address,bytes)\":{\"params\":{\"parentPool\":\"The address of the parent pool (which contains BPTs of other pools)\",\"exactBptAmountIn\":\"The exact amount of `parentPool` tokens provided\",\"tokensOut\":\"An array with all tokens from the child pools, and all non-BPT parent tokens, in arbitrary order\",\"tokensToUnwrap\":\"A list of ERC4626 tokens which should be unwrapped if encountered during pool traversal\",\"sender\":\"The sender passed to the operation. It can influence results (e.g., with user-dependent hooks)\",\"userData\":\"Additional (optional) data required for the operation\"},\"returns\":{\"amountsOut\":\"An array with the expected amountOut of each token, sorted in the same order as tokensOut\\n     \"}}},\"details\":\"This contract allow interacting with ERC4626 Pools (which contain wrapped ERC4626 tokens) using only underlying\\n * standard tokens. For instance, with `addLiquidityUnbalancedToERC4626Pool` it is possible to add liquidity to an\\n * ERC4626 Pool with [waDAI, waUSDC], using only DAI, only USDC, or an arbitrary amount of both. If the ERC4626 buffers\\n * in the Vault have liquidity, these will be used to avoid wrapping/unwrapping through the wrapped token interface,\\n * saving gas.\\n *\\n * For instance, adding only DAI to the pool above (and assuming a waDAI buffer with enough liquidity), would pull in\\n * the DAI from the user, swap it for waDAI in the internal Vault buffer, and deposit the waDAI into the ERC4626 pool:\\n * 1) without having to do any expensive ERC4626 wrapping operations; and\\n * 2) without requiring the user to construct a batch operation containing the buffer swap.\\n \",\"errors\":{\"WrongTokensOut(address[],address[])\":[{\"params\":{\"actualTokensOut\":\"The set of tokens derived from pool traversal\",\"expectedTokensOut\":\"The set of tokens supplied by the user\\n     \"}}],\"DuplicateTokenIn(address)\":[{\"details\":\"Note that it's technically possible to have duplicate tokens with 0 amounts, as those are ignored.\",\"params\":{\"duplicateToken\":\"The address of the duplicate token\\n     \"}}]},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"addLiquidityUnbalancedToERC4626Pool(address,bool[],uint256[],uint256,bool,bytes)\":{\"notice\":\"Add arbitrary amounts of tokens to an ERC4626 pool through the buffer.\"},\"queryAddLiquidityUnbalancedToERC4626Pool(address,bool[],uint256[],address,bytes)\":{\"notice\":\"Queries an `addLiquidityUnbalancedToERC4626Pool` operation without actually executing it.\"},\"addLiquidityProportionalToERC4626Pool(address,bool[],uint256[],uint256,bool,bytes)\":{\"notice\":\"Add proportional amounts of tokens to an ERC4626 pool through the buffer.\"},\"queryAddLiquidityProportionalToERC4626Pool(address,bool[],uint256,address,bytes)\":{\"notice\":\"Queries an `addLiquidityProportionalToERC4626Pool` operation without actually executing it.\"},\"removeLiquidityProportionalFromERC4626Pool(address,bool[],uint256,uint256[],bool,bytes)\":{\"notice\":\"Remove proportional amounts of tokens from an ERC4626 pool, burning an exact pool token amount.\"},\"queryRemoveLiquidityProportionalFromERC4626Pool(address,bool[],uint256,address,bytes)\":{\"notice\":\"Queries a `removeLiquidityProportionalFromERC4626Pool` operation without actually executing it.\"},\"addLiquidityUnbalancedNestedPool(address,address[],uint256[],address[],uint256,bool,bytes)\":{\"notice\":\"Adds liquidity unbalanced to a nested pool.\"},\"queryAddLiquidityUnbalancedNestedPool(address,address[],uint256[],address[],address,bytes)\":{\"notice\":\"Queries an `addLiquidityUnbalancedNestedPool` operation without actually executing it.\"},\"removeLiquidityProportionalNestedPool(address,uint256,address[],uint256[],address[],bool,bytes)\":{\"notice\":\"Removes liquidity from a nested pool.\"},\"queryRemoveLiquidityProportionalNestedPool(address,uint256,address[],address[],address,bytes)\":{\"notice\":\"Queries an `removeLiquidityProportionalNestedPool` operation without actually executing it.\"}},\"errors\":{\"WrongTokensOut(address[],address[])\":[{\"notice\":\"The actual result of the liquidity removal operation does not match the expected set of tokens.\"}],\"DuplicateTokenIn(address)\":[{\"notice\":\"The `tokensIn` array contains a duplicate token.\"}]},\"notice\":\"The composite liquidity router supports add/remove liquidity operations on ERC4626 and nested pools.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"lib/crane/contracts/external/balancer/v3/interfaces/contracts/vault/ICompositeLiquidityRouter.sol\":\"ICompositeLiquidityRouter\"},\"evmVersion\":\"osaka\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":1},\"remappings\":[\"@battlechain-contracts/=lib/crane/lib/battlechain-lib/lib/