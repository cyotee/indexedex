:{\"kind\":\"dev\",\"methods\":{\"exchangeIn(address,uint256,address,uint256,address,bool,uint256)\":{\"details\":\"Minimum and returned output are SY units; receipt/input units are DETF.\"},\"name()\":{\"details\":\"Returns the name of the token.\\n     \"},\"symbol()\":{\"details\":\"Returns the symbol of the token, usually a shorter version of the\\n     * name.\\n     \"},\"totalSupply()\":{\"details\":\"Returns the value of tokens in existence.\\n     \"},\"balanceOf(address)\":{\"details\":\"Returns the value of tokens owned by `account`.\\n     \"},\"transfer(address,uint256)\":{\"details\":\"See {IERC20-transfer}.\\n     *\\n     * Requirements:\\n     *\\n     * - `to` cannot be the zero address.\\n     * - the caller must have a balance of at least `value`.\\n     \"},\"allowance(address,address)\":{\"details\":\"Returns the remaining number of tokens that `spender` will be\\n     * allowed to spend on behalf of `owner` through {transferFrom}. This is\\n     * zero by default.\\n     *\\n     * This value changes when {approve} or {transferFrom} are called.\\n     \"},\"transferFrom(address,address,uint256)\":{\"details\":\"See {IERC20-transferFrom}.\\n     *\\n     * Skips emitting an {Approval} event indicating an allowance update. This is not\\n     * required by the ERC. See {xref-ERC20-_approve-address-address-uint256-bool-}[_approve].\\n     *\\n     * NOTE: Does not update the allowance if the current allowance\\n     * is the maximum `uint256`.\\n     *\\n     * Requirements:\\n     *\\n     * - `from` and `to` cannot be the zero address.\\n     * - `from` must have a balance of at least `value`.\\n     * - the caller must have allowance for ``from``'s tokens of at least\\n     * `value`.\\n     \"}},\"details\":\"Owner-approved exception: standalone constructor deployment with `new`, no diamond/package/CREATE3.\",\"events\":{\"Transfer(address,address,uint256)\":{\"details\":\"Emitted when `amount` tokens are moved from one account (`from`) to\\n     * another (`to`).\\n     *\\n     * Note that `amount` may be zero.\\n     \"},\"Approval(address,address,uint256)\":{\"details\":\"Emitted when the allowance of a `spender` for an `owner` is set by\\n     * a call to {approve}. `amount` is the new allowance.\\n     \"}},\"errors\":{\"ERC20InsufficientBalance(address,uint256,uint256)\":[{\"details\":\"Indicates an error related to the current `balance` of a `sender`. Used in transfers.\",\"params\":{\"sender\":\"Address whose tokens are being transferred.\",\"balance\":\"Current balance for the interacting account.\",\"needed\":\"Minimum amount required to perform a transfer.\\n     \"}}],\"ERC20InvalidSender(address)\":[{\"details\":\"Indicates a failure with the token `sender`. Used in transfers.\",\"params\":{\"sender\":\"Address whose tokens are being transferred.\\n     \"}}],\"ERC20InvalidReceiver(address)\":[{\"details\":\"Indicates a failure with the token `receiver`. Used in transfers.\",\"params\":{\"receiver\":\"Address to which tokens are being transferred.\\n     \"}}],\"ERC20InsufficientAllowance(address,uint256,uint256)\":[{\"details\":\"Indicates a failure with the `spender`'s `allowance`. Used in transfers.\",\"params\":{\"spender\":\"Address that may be allowed to operate on tokens without being their owner.\",\"allowance\":\"Amount of tokens a `spender` is allowed to operate with.\",\"needed\":\"Minimum amount required to perform a transfer.\\n     \"}}],\"ERC20InvalidApprover(address)\":[{\"details\":\"Indicates a failure with the `approver` of a token to be approved. Used in approvals.\",\"params\":{\"approver\":\"Address initiating an approval operation.\\n     \"}}],\"ERC20InvalidSpender(address)\":[{\"details\":\"Indicates a failure with the `spender` to be approved. Used in approvals.\",\"params\":{\"spender\":\"Address that may be allowed to operate on tokens without being their owner.\\n     \"}}]},\"title\":\"TokenStakingMigrationAdapter\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"rebasingClaimToken()\":{\"notice\":\"Historical discovery getter; intentionally returns STATIC staking SY, the claim-vault asset.\"},\"fundedStakingToken()\":{\"notice\":\"Actual funded, rebasing sDETF backing the canonical staking SY.\"},\"mint(address,uint256,uint256,address,bool,uint256)\":{\"notice\":\"Historical six-argument mint ABI; returns one uint256 as expected by deployed staking.\"},\"exchangeIn(address,uint256,address,uint256,address,bool,uint256)\":{\"notice\":\"Consume the entire approved receipt batch and deliver static staking SY directly to staking.\"},\"decimals()\":{\"notice\":\"Receipt units match native DETF units.\"},\"approve(address,uint256)\":{\"notice\":\"Only the legacy self-approval, bounded by the outstanding receipt balance, is supported.\"}},\"notice\":\"Bridges historical TokenStaking mint/approve/exchangeIn calls to canonical DETF and static staking SY routes.      Only the pinned staking contract can mint or consume nontransferable DETF-backed receipts.      A native migrateToClaimVault call creates and consumes the entire receipt supply atomically,      then wraps static staking SY. Users withdraw SY and redeem it for real sDETF. No fee, owner, rescue or arbitrary call path.      Donations are never credited as migration input and cannot be recovered through this adapter.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/protocols/staking/token/TokenStakingMigrationAdapter.sol\":\"TokenStakingMigrationAdapter\"},\"evmVersion\":\"osaka\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":1},\"remappings\":[\"@battlechain-contracts/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/src/\",\"@crane/=lib/crane/\",\"@matterlabs/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/lib/battlechain-contracts/lib/\",\"@nomicfoundation/=node_modules/@nomicfoundation/\",\"@opengsn/=node_modules/@opengsn/\",\"@openzeppelin/=node_