etails\":\"`msg.sender` must be `PonsLaunchFactory`; we store it as `launchFactory`.\\n     \"},\"maxWalletAmount()\":{\"details\":\"Alias kept for clients that already expect this name.\"},\"maxTxAmount()\":{\"details\":\"Alias kept for clients that already expect this name.\"},\"name()\":{\"details\":\"Returns the name of the token.\\n     \"},\"symbol()\":{\"details\":\"Returns the symbol of the token, usually a shorter version of the\\n     * name.\\n     \"},\"decimals()\":{\"details\":\"Returns the number of decimals used to get its user representation.\\n     * For example, if `decimals` equals `2`, a balance of `505` tokens should\\n     * be displayed to a user as `5.05` (`505 / 10 ** 2`).\\n     *\\n     * Tokens usually opt for a value of 18, imitating the relationship between\\n     * Ether and Wei. This is the default value returned by this function, unless\\n     * it's overridden.\\n     *\\n     * NOTE: This information is only used for _display_ purposes: it in\\n     * no way affects any of the arithmetic of the contract, including\\n     * {IERC20-balanceOf} and {IERC20-transfer}.\\n     \"},\"totalSupply()\":{\"details\":\"See {IERC20-totalSupply}.\\n     \"},\"balanceOf(address)\":{\"details\":\"See {IERC20-balanceOf}.\\n     \"},\"transfer(address,uint256)\":{\"details\":\"See {IERC20-transfer}.\\n     *\\n     * Requirements:\\n     *\\n     * - `to` cannot be the zero address.\\n     * - the caller must have a balance of at least `value`.\\n     \"},\"allowance(address,address)\":{\"details\":\"See {IERC20-allowance}.\\n     \"},\"approve(address,uint256)\":{\"details\":\"See {IERC20-approve}.\\n     *\\n     * NOTE: If `value` is the maximum `uint256`, the allowance is not updated on\\n     * `transferFrom`. This is semantically equivalent to an infinite approval.\\n     *\\n     * Requirements:\\n     *\\n     * - `spender` cannot be the zero address.\\n     \"},\"transferFrom(address,address,uint256)\":{\"details\":\"See {IERC20-transferFrom}.\\n     *\\n     * Skips emitting an {Approval} event indicating an allowance update. This is not\\n     * required by the ERC. See {xref-ERC20-_approve-address-address-uint256-bool-}[_approve].\\n     *\\n     * NOTE: Does not update the allowance if the current allowance\\n     * is the maximum `uint256`.\\n     *\\n     * Requirements:\\n     *\\n     * - `from` and `to` cannot be the zero address.\\n     * - `from` must have a balance of at least `value`.\\n     * - the caller must have allowance for ``from``'s tokens of at least\\n     * `value`.\\n     \"}},\"author\":\"Pons Family\",\"details\":\"The factory mints the full supply to itself, seeds the Uniswap V3\\n * position, then lets normal trading begin. During `restrictionBlocks`\\n * we only throttle buys that come out of the paired V3 pool — transfers\\n * between EOAs and LP repositioning stay unrestricted.\\n *\\n * Crane adaptation: constructor takes a single `Init` struct (same fields as\\n * upstream flat args) so legacy codegen can compile without viaIR.\\n \",\"events\":{\"Transfer(address,address,uint256)\":{\"details\":\"Emitted when `value` tokens are moved from one account (`from`) to\\n     * another (`to`).\\n     *\\n     * Note that `value` may be zero.\\n     \"},\"Approval(address,address,uint256)\":{\"details\":\"Emitted when the allowance of a `spender` for an `owner` is set by\\n     * a call to {approve}. `value` is the new allowance.\\n     \"}},\"errors\":{\"ERC20InsufficientBalance(address,uint256,uint256)\":[{\"details\":\"Indicates an error related to the current `balance` of a `sender`. Used in transfers.\",\"params\":{\"sender\":\"Address whose tokens are being transferred.\",\"balance\":\"Current balance for the interacting account.\",\"needed\":\"Minimum amount required to perform a transfer.\\n     \"}}],\"ERC20InvalidSender(address)\":[{\"details\":\"Indicates a failure with the token `sender`. Used in transfers.\",\"params\":{\"sender\":\"Address whose tokens are being transferred.\\n     \"}}],\"ERC20InvalidReceiver(address)\":[{\"details\":\"Indicates a failure with the token `receiver`. Used in transfers.\",\"params\":{\"receiver\":\"Address to which tokens are being transferred.\\n     \"}}],\"ERC20InsufficientAllowance(address,uint256,uint256)\":[{\"details\":\"Indicates a failure with the `spender`’s `allowance`. Used in transfers.\",\"params\":{\"spender\":\"Address that may be allowed to operate on tokens without being their owner.\",\"allowance\":\"Amount of tokens a `spender` is allowed to operate with.\",\"needed\":\"Minimum amount required to perform a transfer.\\n     \"}}],\"ERC20InvalidApprover(address)\":[{\"details\":\"Indicates a failure with the `approver` of a token to be approved. Used in approvals.\",\"params\":{\"approver\":\"Address initiating an approval operation.\\n     \"}}],\"ERC20InvalidSpender(address)\":[{\"details\":\"Indicates a failure with the `spender` to be approved. Used in approvals.\",\"params\":{\"spender\":\"Address that may be allowed to operate on tokens without being their owner.\\n     \"}}]},\"title\":\"PonsLauncherToken\",\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"constructor\":{\"notice\":\"Creates a launch token and mints its entire supply to the factory.\"},\"deployer()\":{\"notice\":\"Creator wallet recorded for the pons.family UI.\"},\"launchFactory()\":{\"notice\":\"Parent factory; only this address may flip the seed-buy exemption.\"},\"liquidityPool()\":{\"notice\":\"Canonical V3 pool for this token / pair / fee tier.\\n     \"},\"socials()\":{\"notice\":\"Social links shown on the pons.family token page.\\n     \"},\"getTokenInfo()\":{\"notice\":\"Creator + metadata bundle for frontend display.\\n     \"},\"maxWalletLimit()\":{\"notice\":\"Max recipient balance during the restricted launch window.\\n     \"},\"maxTxLimit()\":{\"notice\":\"Cumulative pool-buy cap during the restricted window.\\n     \"},\"setInitialBuyRecipient(address)\":{\"notice\":\"Factory-only toggle for the atomic seed-buy recipient.\\n     \"}},\"notice\":\"Fixed-supply ERC-20 used by every pons.family launch.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"lib/crane/contracts/protocols/launchpads/ponsFamily/v1/PonsLauncherToken.sol\":\"PonsLauncherToken\"},\"evmVersion\":\"osaka\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":1},\"remappings\":[\"@battlechain-contracts/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/src/\",\"@crane/=lib/crane/\",\"@matterlabs/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/lib/battlechain-contracts/lib/\",\"@nomicfoundation/=node_modules/@nomicfoundation/\",\"@opengsn/=node_modules/@opengsn/\",\"@openzeppelin/=node_modules/@openzeppelin/\",\"@oz/=lib/crane/lib/openzeppelin-contracts/\",\"@ozu/=lib/crane/contracts/external/openzeppelin-upgradeable/\",\"battlechain-contracts/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/lib/battlechain-contracts/\",\"battlechain-lib-mocks/=lib/crane/lib/battlechain-lib/test/mocks/\",\"battlechain-lib/=lib/crane/lib/battlechain-lib/src/\",\"battlechain-safe-harbor-contracts/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/\",\"chainlink-ccip/=lib/crane/lib/chainlink-local/lib/chainlink-ccip/chains/evm/contracts/vendor/optimism/interop-lib/v0/src/\",\"chainlink-evm/=lib/crane/lib/chainlink-local/lib/chainlink-evm/\",\"chainlink-local/=lib/crane/lib/chainlink-local/src/\",\"clones/=lib/crane/contracts/external/clones-with-immutable-args/\",\"contracts/external/solady/=lib/crane/contracts/external/solady/\",\"contracts/protocols/launchpads/uniswap/continuous-clearing/=lib/crane/contracts/protocols/launchpads/uniswap/continuous-clearing/\",\"contracts/solady/=lib/crane/contracts/external/solady/\",\"crane/=lib/crane/\",\"createx/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/lib/createx/src/\",\"ds-test/=lib/crane/l