+++ b/contracts/vaults/detf/protocols/dexes/uniswap/v4/migration/bondNft/UniswapV4DetfMigrationBondNFTVaultTarget.sol
@@ -0,0 +1,112 @@
+// SPDX-License-Identifier: BSL-1.1
+pragma solidity ^0.8.0;
+
+import {ReentrancyLockRepo} from "@crane/contracts/access/reentrancy/ReentrancyLockRepo.sol";
+import {IStakedDETF} from "contracts/interfaces/IStakedDETF.sol";
+import {DETFFundedBondTarget} from "contracts/vaults/detf/common/bondNft/DETFFundedBondTarget.sol";
+import {DETFFundedBondRepo as BondRepo} from "contracts/vaults/detf/common/bondNft/DETFFundedBondRepo.sol";
+import {DETFFundedStakingMath as StakingMath} from "contracts/vaults/detf/common/core/DETFFundedStakingMath.sol";
+import {IUniswapV4DetfMigration, IUniswapV4DetfMigrationAccounting as Accounting}
+    from "../interfaces/IUniswapV4DetfMigration.sol";
+import {IUniswapV4DetfMigrationStakedDETF} from "../claimToken/IUniswapV4DetfMigrationStakedDETF.sol";
+import {IUniswapV4DetfMigrationBondNFTVault} from "./IUniswapV4DetfMigrationBondNFTVault.sol";
+import {UniswapV4DetfMigrationBondNFTRepo as MigrationRepo} from "./UniswapV4DetfMigrationBondNFTRepo.sol";
+
+/// @notice Real funded bond custody with fresh Migration cliffs and gated reward delivery.
+/// @dev Inherited claims and all three ERC721 transfers consume the synchronization overrides.
+contract UniswapV4DetfMigrationBondNFTVaultTarget is DETFFundedBondTarget {
+    /// @notice Ordinary active purchases retain linear terms and never acquire a Migration marker.
+    function createFundedPosition(uint256 principal_, uint256 duration_, address recipient_)
+        external override onlyDetf synchronized nonReentrant returns (uint256 tokenId_)
+    {
+        _requireActivated();
+        return _createFundedPosition(principal_, duration_, recipient_);
+    }
+
+    /// @notice Only the wired parent can fund a fresh 90-day cliff, using actual pulled DETF.
+    function createMigrationPosition(uint256 principal_, address recipient_)
+        external onlyDetf synchronized nonReentrant returns (uint256 tokenId_)
+    {
+        tokenId_ = _createFundedPosition(principal_, 90 days, recipient_);
+        MigrationRepo._layoutStruct().migrationPosition[tokenId_] = true;
+        emit IUniswapV4DetfMigrationBondNFTVault.MigrationPositionCreated(
+            tokenId_, recipient_, principal_, block.timestamp, block.timestamp + 90 days
+        );
+    }
+
+    /// @notice Persistent policy identity, including after canonical retirement; no eligibility cache.
+    function isMigrationPosition(uint256 tokenId_) external view returns (bool) {
+        return MigrationRepo._layoutStruct().migrationPosition[tokenId_];
+    }
+
+    /// @notice Actual post-debit position aggregate, read by receipt delivery and dust retirement.
+    function attributedBondGons() external view returns (uint256) {
+        return BondRepo._layoutStruct().attributedGons;
+    }
+
+    /// @notice Include inherited custody/donation locks, not just explicitly synchronized entries.
+    function migrationAccountingPhase() external view returns (uint8) {
+        return uint8(_accountingPhase());
+    }
+
+    function _calculateClaim(uint256 tokenId_, uint256 k_)
+        internal view override returns (StakingMath.BondClaim memory claim_)
+    {
+        // Canonical math remains the sole staking-value, deficit and reward calculation.
+        claim_ = super._calculateClaim(tokenId_, k_);
+        if (MigrationRepo._layoutStruct().migrationPosition[tokenId_]) {
+            StakingMath.BondPosition storage position_ = BondRepo._layoutStruct().positions[tokenId_];
+            claim_.vestedPrincipal = block.timestamp >= position_.startTimestamp + position_.vestingDuration
+                ? position_.principal : 0;
+            claim_.principalDue = claim_.vestedPrincipal - position_.claimedPrincipal;
+        }
+    }
+
+    function _claim(uint256 tokenId_, address recipient_, bool principalClaim_, bool rewardClaim_)
+        internal override returns (uint256 principal_, uint256 rewards_)
+    {
+        // Combined/rewards-only requests reject even when their computed reward is zero.
+        if (rewardClaim_) _requireActivated();
+        return super._claim(tokenId_, recipient_, principalClaim_, rewardClaim_);
+    }
+
+    function _deliverClaim(
+        IStakedDETF staking_, address recipient_, uint256 principal_, uint256 rewards_, uint256 k_
+    ) internal override {
+        IUniswapV4DetfMigrationStakedDETF(address(staking_)).deliverBondClaim(
+            recipient_, principal_, rewards_, k_
+        );
+    }
+
+    function _beforeSynchronized() internal override {
+        Accounting.AccountingPhase phase_ = _accountingPhase();
+        if (phase_ != Accounting.AccountingPhase.Idle) {
+            revert Accounting.MigrationAccountingBusy(address(this), uint8(phase_));
+        }
+        MigrationRepo.Storage storage s_ = MigrationRepo._layoutStruct();
+        s_.phase = Accounting.AccountingPhase.Synchronizing;
+        // Also exclude inherited donation/custody entries while the parent can call out.
+        // The entry's normal nonReentrant modifier takes over after synchronization.
+        ReentrancyLockRepo._lock();
+        super._beforeSynchronized();
+        ReentrancyLockRepo._unlock();
+        s_.phase = Accounting.AccountingPhase.Accounting;
+    }
+
+    function _afterSynchronized() internal override {
+        MigrationRepo._layoutStruct().phase = Accounting.AccountingPhase.Idle;
+    }
+
+    function _accountingPhase() internal view returns (Accounting.AccountingPhase phase_) {
+        phase_ = MigrationRepo._layoutStruct().phase;
+        if (phase_ == Accounting.AccountingPhase.Idle && ReentrancyLockRepo._isLocked()) {
+            return Accounting.AccountingPhase.Accounting;
+        }
+    }
+
+    function _requireActivated() private view {
+        if (!IUniswapV4DetfMigration(BondRepo._layoutStruct().detf).migrationActivated()) {
+            revert Accounting.MigrationRewardsClosed();
+        }
+    }
+}
diff --git a/contracts/vaults/detf/protocols/dexes/uniswap/v4/migration/claimToken/IUniswapV4DetfMigrationStakedDETF.sol b/contracts/vaults/detf/protocols/dexes/uniswap/v4/migration/claimToken/IUniswapV4DetfMigrationStakedDETF.sol
new file mode 100644
index 00000000..36ea4b81
--- /dev/null
+++ b/contracts/vaults/detf/protocols/dexes/uniswap/v4/migration/claimToken/IUniswapV4DetfMigrationStakedDETF.sol
@@ -0,0 +1,93 @@
+// SPDX-License-Identifier: BSL-1.1
+pragma solidity ^0.8.0;
+
+import {IStakedDETF} from "contracts/interfaces/IStakedDETF.sol";
+import {IUniswapV4DetfMigrationAccounting} from "../interfaces/IUniswapV4DetfMigration.sol";
+
+/// @notice R3 funded receipt: canonical staking state plus native principal basis and escrowed reward gons.
+/// @dev Reuse IStakedDETF.StakingState and its real funding/SE ABI. Q=1e36; k is current gons
+/// per native sDETF, 1<=k<=Q. P is native nine-decimal principal; R0/R1/R2, E and U are exact gons.
+/// Receipt escrow holds sum(R0+R1+R2)+E+U; those gons are already in canonical totalGons.
+interface IUniswapV4DetfMigrationStakedDETF is IStakedDETF, IUniswapV4DetfMigrationAccounting {
+    /// @dev Keep uint8 method parameters exactly as R3; these ordinals name the admitted domains.
+    enum RewardDomain {
+        Wallet,
+        Role,
+        SY
+    }
+
+    error InvalidRewardDomain(uint8 domain);
+    error InvalidRewardBeneficiary(address beneficiary);
+    error InsufficientLiquidPrincipal(uint256 requested, uint256 available);
+    error InsufficientDeferredRewardGons(uint256 requested, uint256 available);
+    error MigrationCustodyUnderfunded(address custodian, uint256 heldGons, uint256 requiredGons);
+
+    event RewardGonsDeferred(
+        address indexed source, address indexed beneficiary, uint8 indexed domain, uint256 gons, uint256 k
+    );
+    event DeferredRewardRightsTransferred(
+        address indexed from, address indexed to, uint8 indexed domain, uint256 gons
+    );
+    event DeferredRewardsPaid(
+        address indexed beneficiary, uint8 indexed domain, uint256 nativeSDETF, uint256 gons, uint256 k
+    );
+    event SelfHeldSyRewardsDeferred(address indexed sy, uint256 gons, uint256 k);
+    event SyRewardsTokenized(address indexed beneficiary, uint256 nativeRT, uint256 gons, uint256 k);
+    event SyRewardRemainderPaid(address indexed beneficiary, uint256 nativeSDETF, uint256 gons, uint256 k);
+    event MigrationGonsRetired(address indexed custodian, uint256 gons, uint256 stakingDustAdded, uint256 k);
+
+    /// @notice Stored physical gons, native basis, latent surplus, R0/R1/R2 and executable native cap.
+    /// @dev Ordinary balanceOf remains floor(physicalGons/k), not a promise of Stage-1 reward
+    /// spendability. Protected custody accounts have zero public maxUnstake and no wallet surplus.
+    function egressState(address account_) external view returns (
+        uint256 physicalGons, uint256 liquidBasis, uint256 latentGons,
+        uint256 walletGons, uint256 roleGons, uint256 syGons, uint256 maxUnstake
+    );
+
+    /// @notice Synchronize then move the caller's existing wallet surplus into R0 under receipt custody.
+    function checkpointRewards() external returns (uint256 movedGons);
+
+    /// @notice Exact attributed beneficiary gons in domain 0, 1 or 2; excludes tokenized E and self-held U.
+    function deferredRewardGons(uint8 domain_, address beneficiary_) external view returns (uint256);
+
+    /// @notice E = 1e18 * RT.totalSupply(), already physically held by receipt escrow.
+    function tokenizedSyRewardGons() external view returns (uint256);
+
+    /// @notice Activated native-sDETF release of caller's R0 or R1, debiting only paid*k.
+    function claimDeferredRewards(uint8 domain_) external returns (uint256 nativePaid);
+
+    /// @notice Anyone may trigger activated R1 release, but only to the recorded beneficiary.
+    function claimDeferredRoleRewards(address beneficiary_) external returns (uint256 nativePaid);
+
+    /// @notice Actual owner assigns exact R0 or R2 rights; no native allowance, mint or custody movement.
+    /// @dev R1 cannot be reassigned. Reject protected recipients. Valid before and after activation.
+    function transferDeferredRewardRights(uint8 domain_, address to_, uint256 gons_) external;
+
+    /// @notice Fixed bond-only delivery after position/aggregate debit, checked against actual remaining gons.
+    /// @dev principal_/reward_ are native sDETF. Independently require activation for positive reward_.
+    function deliverBondClaim(address recipient_, uint256 principal_, uint256 reward_, uint256 expectedK_) external;
+
+    /// @notice Fixed staking-SY-only checkpoint after debiting its authoritative backingGons.
+    /// @dev Move existing physical gons to escrow/R2; beneficiary_ == stakingSY credits U instead.
+    function deferSyRewards(address beneficiary_, uint256 gons_, uint256 expectedK_) external;
+
+    /// @notice Fixed staking-SY-only transfer of principal_*k actual gons and principal_ native basis.
+    function transferSyPrincipal(address recipient_, uint256 principal_, uint256 expectedK_) external;
+
+    /// @notice Fixed staking-SY-only burn of principal_*k and payment of principal_ held DETF.
+    function withdrawSyPrincipal(address recipient_, uint256 principal_, uint256 expectedK_) external;
+
+    /// @notice Fixed staking-SY-only, activation-gated R2 -> E transition and receipt-only RT mint.
+    /// @dev Return floor(R2/1e18) native RT, not native sDETF; retain R2%1e18.
+    function issueSyRewardTokens(address beneficiary_, uint256 expectedK_) external returns (uint256 nativeRT);
+
+    /// @notice Fixed staking-SY-only, activation-gated native payout from R2%1e18, retaining unpaid gons.
+    function paySyRewardRemainder(address beneficiary_, uint256 expectedK_) external returns (uint256 nativeSDETF);
+
+    /// @notice Fixed RT-only synchronized redemption for RT's actual caller; no public owner substitution.
+    /// @dev Synchronize before local accounting, require activation, fix k, call receipt-only RT burn,
+    /// verify post-burn supply against E, pay floor(nativeRT_*1e18/k) existing sDETF to receiver_.
+    /// Credit every unpaid gon to owner's R0, not receiver_. Enforce minNative_ atomically.
+    function redeemSyRewardTokens(address owner_, address receiver_, uint256 nativeRT_, uint256 minNative_)
+        external returns (uint256 nativeSDETF, uint256 retainedGons);
+}
