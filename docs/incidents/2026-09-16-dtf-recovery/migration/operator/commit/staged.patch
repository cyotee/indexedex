+import { afterEach, test } from "node:test";
+import assert from "node:assert/strict";
+import { writeFile } from "node:fs/promises";
+import { spawn } from "node:child_process";
+import { once } from "node:events";
+import { text } from "node:stream/consumers";
+import { join } from "node:path";
+import { fixture, h, a } from "./preparation.fixture.js";
+import { canonical, fingerprint } from "./provenance.js";
+import { buildPayloads, configurationId, dispositions } from "./payloads.js";
+import { normalize, prepareDomain, prepareFile, validateManifest } from "./preparation.js";
+import { preparationInput, uint } from "./schema.js";
+import { main } from "./cli.js";
+
+const fixtures: Awaited<ReturnType<typeof fixture>>[] = [];
+async function setup() {
+  const f = await fixture();
+  fixtures.push(f);
+  return f;
+}
+afterEach(async () => {
+  for (const f of fixtures.splice(0)) await f.close();
+});
+
+test("normalizes native integer strings without floating point", () => {
+  assert.equal(uint.parse("00090071992547409931234"), "90071992547409931234");
+});
+for (const value of ["", "-1", "1.5", "1e18", 0, null, (2n ** 256n).toString()]) {
+  test(`rejects unknown or non-native amount ${value}`, () => {
+    assert.equal(uint.safeParse(value).success, false);
+  });
+}
+test("emits full separate replacements and independently quoted native credits", async () => {
+  const f = await setup();
+  const result = await prepareDomain(f.input);
+  assert.equal(result.payloads.configure.independent[0]?.input.entitlements[0]?.originalEth, "90071992547409931234");
+  assert.deepEqual(result.quoteEvidence.quotes, [
+    { originalEth: "100", originalDtf: "22", ethCredit: "10", dtfCredit: "2", credit: "12" },
+    { originalEth: "90071992547409931234", originalDtf: "110", ethCredit: "9007199254740993123",
+      dtfCredit: "10", credit: "9007199254740993133" },
+  ]);
+  assert.deepEqual(result.payloads.configure.nfts.map((r) => r.input),
+    [...f.input.nfts.map((r) => r.original)].sort((a, b) => a.collection.localeCompare(b.collection)));
+  assert.deepEqual(result.payloads.independentIssue.requests, [{
+    recipient: a(20), configurationId: result.payloads.configure.independent[0]?.configurationId,
+  }]);
+  assert.equal(result.dispositions.filter((d) => d.disposition === "blocked").length, 10);
+  assert.equal(f.methods.every((m) => ["eth_chainId", "eth_getBlockByNumber", "eth_getCode", "eth_call"].includes(m)), true);
+});
+test("normalization is stable under reordered records and source bindings", async () => {
+  const f = await setup();
+  const reordered = { ...f.input, sources: [...f.input.sources].reverse(), exposures: [...f.input.exposures].reverse(),
+    domain: { ...f.input.domain, bindings: [...f.input.domain.bindings].reverse() } };
+  assert.equal(canonical(normalize(reordered)), canonical(normalize(f.input)));
+});
+test("full replacements change identities instead of generating credit deltas", async () => {
+  const f = await setup();
+  const payload = buildPayloads(f.input).independent[0];
+  assert.ok(payload);
+  const replacement = { ...payload, evidenceId: h(500) };
+  assert.notEqual(configurationId(f.input.domain, replacement), configurationId(f.input.domain, payload));
+  assert.notEqual(configurationId({ ...f.input.domain, proxy: a(50) }, payload), configurationId(f.input.domain, payload));
+});
+for (const kind of ["chain", "block", "snapshot", "proxy", "package"] as const) {
+  test(`rejects wrong ${kind} domain before accepting payloads`, async () => {
+    const f = await setup();
+    const input = {
+      ...f.input, nfts: [], exposures: f.input.exposures.filter((e) => e.category === "independent"), domain: {
+        ...f.input.domain,
+        chainId: kind === "chain" ? "1" : f.input.domain.chainId,
+        blockHash: kind === "block" ? h(3) : f.input.domain.blockHash,
+        snapshotId: kind === "snapshot" ? h(4) : f.input.domain.snapshotId,
+        proxy: kind === "proxy" ? a(99) : f.input.domain.proxy,
+        bindings: f.input.domain.bindings.map((b) => kind === "package" && b.role === "package" ? { ...b, codeHash: h(5) } : b),
+      },
+    };
+    const expected = { chain: /wrong chain/, block: /wrong canonical block/, snapshot: /snapshot identity/,
+      proxy: /wrong proxy binding/, package: /wrong package code/ };
+    await assert.rejects(prepareDomain(input), expected[kind]);
+  });
+}
+test("rejects source tampering rather than trusting quoted originals", async () => {
+  const f = await setup();
+  await writeFile(f.evidencePath, "{}");
+  await assert.rejects(prepareDomain(f.input), /source bytes differ/);
+});
+test("rejects originals that do not match their raw proof", async () => {
+  const f = await setup();
+  const row = f.input.nfts[0];
+  assert.ok(row);
+  await assert.rejects(prepareDomain({ ...f.input, nfts: [{ ...row, original: { ...row.original, originalEth: "101" } }] }),
+    /proof does not match/);
+});
+test("rejects unknown contributions and arbitrary credit fields at the schema boundary", async () => {
+  const f = await setup();
+  const row = f.input.nfts[0];
+  assert.equal(preparationInput.safeParse({ ...f.input,
+    nfts: [{ ...row, original: { ...row?.original, contributionsKnown: false, credit: "100" } }] }).success, false);
+});
+test("rejects overlapping originals and missing origin partitions", async () => {
+  const f = await setup();
+  const row = f.input.independent[0];
+  assert.ok(row);
+  assert.throws(() => buildPayloads({ ...f.input, independent: [row, { ...row, recipient: a(25) }] }), /overlapping original/);
+  assert.throws(() => buildPayloads({ ...f.input, nfts: [] }), /unassigned origin/);
+});
+for (const category of ["weighted-liquid", "earlier-liquid", "weighted-receipt", "earlier-receipt",
+  "weighted-sy", "token-staking", "claim-vault", "underlying-se", "fungible-lp", "earlier-liquidation"] as const) {
+  test(`blocks ${category} without forging executable config`, async () => {
+    const f = await setup();
+    const row = f.input.exposures[0];
+    assert.ok(row);
+    assert.throws(() => buildPayloads({ ...f.input, exposures: [{ ...row, category }] }), new RegExp(category));
+  });
+}
+test("rejects a nonconserving origin partition", async () => {
+  const f = await setup();
+  const exposures = f.input.exposures.map(({ proof, ...e }, i) => i === 0 ? { ...e, recoveredUnits: "11" } : e);
+  const body = canonical({ originals: [f.input.independent[0]?.entitlements[0]?.original,
+    ...f.input.nfts.map((n) => n.original)], exposures });
+  await writeFile(f.evidencePath, body);
+  const input = preparationInput.parse({ ...f.input,
+    sources: f.input.sources.map((s) => s.id === "proof" ? { ...s, sha256: fingerprint(body), bytes: Buffer.byteLength(body).toString() } : s),
+    exposures: f.input.exposures.map((e, i) => i === 0 ? { ...e, recoveredUnits: "11" } : e) });
+  await assert.rejects(prepareDomain(input), /origin partition differs/);
+});
+test("rejects combined quotes that differ from independent frozen component quotes", async () => {
+  const f = await setup();
+  f.changes.combinedMismatch = true;
+  await assert.rejects(prepareDomain(f.input), /component quote mismatch/);
+});
+test("revalidates persisted manifest payloads and refuses overwrite", async () => {
+  const f = await setup();
+  const inputPath = join(f.root, "input.json");
+  await writeFile(inputPath, canonical(f.input));
+  await prepareFile(inputPath, f.root);
+  const manifestPath = join(f.root, "manifest.json");
+  const result = await validateManifest(manifestPath);
+  await writeFile(manifestPath, canonical({ ...result, payloadHash: "f".repeat(64) }));
+  await assert.rejects(validateManifest(manifestPath), /binding differs/);
+  await assert.rejects(prepareFile(inputPath, f.root), /EEXIST/);
+});
+test("actual CLI prepares and validates through read-only transport", async () => {
+  const f = await setup();
+  const input = join(f.root, "input.json");
+  await writeFile(input, canonical(f.input));
+  for (const args of [["prepare", "--input", input, "--output", f.root], ["validate", "--manifest", join(f.root, "manifest.json")]]) {
+    const child = spawn(process.execPath, ["scripts/recovery/dtf-migration/cli.ts", ...args], {
+      env: process.env, stdio: ["ignore", "pipe", "pipe"],
+    });
+    const done = once(child, "exit", { signal: AbortSignal.timeout(5000) });
+    assert.ok(child.stdout);
+    assert.ok(child.stderr);
+    const [stdout, stderr, [exit]] = await Promise.all([text(child.stdout), text(child.stderr), done]);
+    assert.deepEqual({ exit, stderr }, { exit: 0, stderr: "" });
+    assert.equal(JSON.parse(stdout).mode, "read-only");
+  }
+});
+test("rejects missing RPC and synthetic nonlocal endpoints", async () => {
+  const f = await setup();
+  await assert.rejects(prepareDomain({ ...f.input, domain: { ...f.input.domain, rpcEnv: "DTF_MISSING_RPC" } }), /missing RPC/);
+  const envName = f.input.domain.rpcEnv;
+  const previous = process.env[envName];
+  process.env[envName] = "https://example.invalid";
+  try {
+    await assert.rejects(prepareDomain(f.input), /loopback RPC/);
+  } finally {
+    process.env[envName] = previous;
+  }
+});
+for (const args of [
+  ["prepare", "--input", "a", "--input", "b", "--output", "c"],
+  ["validate", "--manifest", "x", "--broadcast"],
+  ["validate", "--manifest", "x", "--execute-local"],
+  ["prepare", "--input", "a"],
+]) {
+  test(`rejects ambiguous or executing preparation arguments ${args.join(" ")}`, async () => {
+    await assert.rejects(main(args));
+  });
+}
+test("rejects invalid recovery fields and unproved multi-conversion batches", async () => {
+  const f = await setup();
+  const step = { stage: "WeightedUnstake", tokenId: "0", amount: "1", minimum: "0" } as const;
+  assert.throws(() => buildPayloads({ ...f.input, harvest: { steps: [{ ...step, tokenId: "3" }], deadline: "100" } }),
+    /invalid conversion/);
+  assert.throws(() => buildPayloads({ ...f.input, harvest: { steps: [step, step], deadline: "100" } }),
+    /batch bound/);
+});
+test("preserves all category dispositions but emits no manifest for blocked exposure", async () => {
+  const f = await setup();
+  const exposures = f.input.exposures.map(({ proof, ...e }) => ({ ...e, category: "token-staking" }));
+  const raw = canonical({ originals: [f.input.independent[0]?.entitlements[0]?.original,
+    ...f.input.nfts.map((n) => n.original)], exposures });
+  await writeFile(f.evidencePath, raw);
+  const input = preparationInput.parse({ ...f.input,
+    sources: f.input.sources.map((s) => s.id === "proof" ? { ...s, sha256: fingerprint(raw), bytes: Buffer.byteLength(raw).toString() } : s),
+    exposures: f.input.exposures.map((e) => ({ ...e, category: "token-staking" })) });
+  const inputPath = join(f.root, "input.json");
+  await writeFile(inputPath, canonical(input));
+  await assert.rejects(prepareFile(inputPath, f.root), /token-staking/);
+  const { readFile } = await import("node:fs/promises");
+  const report = JSON.parse(await readFile(join(f.root, "blocked.json"), "utf8"));
+  assert.deepEqual(report.dispositions, dispositions(input));
+  await assert.rejects(readFile(join(f.root, "manifest.json")), { code: "ENOENT" });
+});
diff --git a/scripts/recovery/dtf-migration/preparation.ts b/scripts/recovery/dtf-migration/preparation.ts
new file mode 100644
index 00000000..1ba3a1ae
--- /dev/null
+++ b/scripts/recovery/dtf-migration/preparation.ts
@@ -0,0 +1,113 @@
+import { mkdir, readFile, writeFile } from "node:fs/promises";
+import { resolve } from "node:path";
+import { z } from "zod";
+import { buildPayloads, configurationId, dispositions, nftOrigin } from "./payloads.js";
+import { canonical, fingerprint, loadInput, validateProvenance } from "./provenance.js";
+import { quoteOriginals } from "./quotes.js";
+import { PreparationError, preparationInput, sha256 } from "./schema.js";
+import type { PreparationInput } from "./schema.js";
+
+export function normalize(input: PreparationInput): PreparationInput {
+  return preparationInput.parse({
+    ...input,
+    sources: [...input.sources].sort((a, b) => a.id.localeCompare(b.id)),
+    exposures: input.exposures.map((e) => ({ ...e, descendants: [...e.descendants].sort((a, b) => a.id.localeCompare(b.id)) }))
+      .sort((a, b) => a.originId.localeCompare(b.originId)),
+    independent: input.independent.map((r) => ({ ...r,
+      entitlements: [...r.entitlements].sort((a, b) => a.original.entitlementId.localeCompare(b.original.entitlementId)) }))
+      .sort((a, b) => a.recipient.localeCompare(b.recipient)),
+    nfts: [...input.nfts].sort((a, b) => a.original.collection.localeCompare(b.original.collection)
+      || (BigInt(a.original.tokenId) < BigInt(b.original.tokenId) ? -1 : BigInt(a.original.tokenId) > BigInt(b.original.tokenId) ? 1 : 0)),
+    issueRecipients: [...input.issueRecipients].sort(),
+    domain: { ...input.domain, bindings: [...input.domain.bindings]
+      .sort((a, b) => a.role.localeCompare(b.role) || a.address.localeCompare(b.address)) },
+  });
+}
+
+export async function prepareDomain(input: PreparationInput) {
+  const normalized = normalize(input);
+  await validateProvenance(normalized);
+  const payloads = buildPayloads(normalized);
+  const quotes = await quoteOriginals(normalized, payloads);
+  const creditOf = (original: { readonly originalEth: string; readonly originalDtf: string }): bigint => {
+    const quote = quotes.quotes.find((q) => q.originalEth === original.originalEth && q.originalDtf === original.originalDtf);
+    if (!quote) throw new PreparationError("QUOTE", "missing original quote");
+    return BigInt(quote.credit);
+  };
+  const independent = payloads.independent.map((r) => {
+    const total = r.entitlements.reduce((sum, e) => sum + creditOf(e), 0n);
+    if (total >= 2n ** 256n) throw new PreparationError("QUOTE", "recipient total overflows uint256");
+    return { input: r, configurationId: configurationId(normalized.domain, r), quotedCredit: total.toString() };
+  });
+  const nfts = payloads.nfts.map((r) => ({
+    input: r, configurationId: configurationId(normalized.domain, r), originalId: nftOrigin(normalized.domain, r),
+    quotedCredit: creditOf(r).toString(),
+  }));
+  const requests = normalized.issueRecipients.map((recipient) => {
+    const config = independent.find((r) => r.input.recipient === recipient);
+    if (!config) throw new PreparationError("INPUT", "missing selected recipient");
+    if (config.quotedCredit === "0") throw new PreparationError("QUOTE", "invalid issuance credit");
+    return { recipient, configurationId: config.configurationId };
+  });
+  return {
+    version: "dtf-operator-manifest-v1" as const,
+    input: normalized,
+    normalizedHash: fingerprint(canonical(normalized)),
+    payloads: {
+      configure: { independent, nfts },
+      independentIssue: { requests },
+      harvest: normalized.harvest,
+    },
+    payloadHash: fingerprint(canonical({ independent, nfts, requests, harvest: normalized.harvest })),
+    quoteEvidence: quotes,
+    dispositions: dispositions(normalized),
+    fullTask9: "open" as const,
+  };
+}
+export type PreparedDomain = Awaited<ReturnType<typeof prepareDomain>>;
+
+const envelope = z.object({
+  version: z.literal("dtf-operator-manifest-v1"),
+  input: preparationInput,
+  normalizedHash: sha256,
+  payloads: z.unknown(),
+  payloadHash: sha256,
+  quoteEvidence: z.unknown(),
+  dispositions: z.unknown(),
+  fullTask9: z.literal("open"),
+}).strict();
+
+export async function prepareFile(inputPath: string, outputDirectory: string): Promise<PreparedDomain> {
+  const input = await loadInput(resolve(inputPath));
+  let prepared: PreparedDomain;
+  try {
+    prepared = await prepareDomain(input);
+  } catch (error) {
+    if (error instanceof PreparationError && error.code === "BLOCKED") {
+      await mkdir(outputDirectory, { recursive: true });
+      await writeFile(resolve(outputDirectory, "blocked.json"), `${canonical({
+        status: "blocked", error: error.message, normalizedHash: fingerprint(canonical(normalize(input))),
+        dispositions: dispositions(input), fullTask9: "open",
+      })}\n`, { flag: "wx" });
+    }
+    throw error;
+  }
+  await mkdir(outputDirectory, { recursive: true });
+  await writeFile(resolve(outputDirectory, "independent.json"),
+    `${canonical(prepared.payloads.configure.independent.map((r) => r.input))}\n`, { flag: "wx" });
+  await writeFile(resolve(outputDirectory, "nfts.json"),
+    `${canonical(prepared.payloads.configure.nfts.map((r) => r.input))}\n`, { flag: "wx" });
+  // Exclusive creation protects a prior accepted dataset from accidental overwrite.
+  // Manifest is the acceptance marker, written only after all review mirrors.
+  await writeFile(resolve(outputDirectory, "manifest.json"), `${canonical(prepared)}\n`, { flag: "wx" });
+  return prepared;
+}
+
+export async function validateManifest(path: string): Promise<PreparedDomain> {
+  const supplied = envelope.parse(JSON.parse(await readFile(path, "utf8")));
+  const current = await prepareDomain(supplied.input);
+  if (canonical(supplied) !== canonical(current)) {
+    throw new PreparationError("DOMAIN", "manifest, source, snapshot, quote or payload binding differs");
+  }
+  return current;
+}
diff --git a/scripts/recovery/dtf-migration/provenance.ts b/scripts/recovery/dtf-migration/provenance.ts
new file mode 100644
index 00000000..0bf60811
--- /dev/null
+++ b/scripts/recovery/dtf-migration/provenance.ts
@@ -0,0 +1,80 @@
+import { createHash } from "node:crypto";
+import { readFile } from "node:fs/promises";
+import { dirname, resolve } from "node:path";
+import { z } from "zod";
+import { PreparationError, preparationInput } from "./schema.js";
+import type { PreparationInput, Proof } from "./schema.js";
+
+export function canonical(value: unknown): string {
+  if (value === null || typeof value !== "object") return JSON.stringify(value);
+  if (Array.isArray(value)) return `[${value.map(canonical).join(",")}]`;
+  return `{${Object.entries(value).sort(([a], [b]) => a < b ? -1 : a > b ? 1 : 0)
+    .map(([key, item]) => `${JSON.stringify(key)}:${canonical(item)}`).join(",")}}`;
+}
+
+export function fingerprint(value: string | Uint8Array): string {
+  return createHash("sha256").update(value).digest("hex");
+}
+
+export async function loadInput(path: string): Promise<PreparationInput> {
+  const input = preparationInput.parse(JSON.parse(await readFile(path, "utf8")));
+  return preparationInput.parse({
+    ...input,
+    domain: { ...input.domain, snapshotArtifact: resolve(dirname(path), input.domain.snapshotArtifact) },
+    sources: input.sources.map((s) => ({ ...s, path: resolve(dirname(path), s.path) })),
+  });
+}
+
+function pointerValue(root: unknown, pointer: string): unknown {
+  return pointer.split("/").slice(1).reduce<unknown>((current, part) => {
+    const key = part.replace(/~1/g, "/").replace(/~0/g, "~");
+    if (Array.isArray(current)) {
+      if (!/^(0|[1-9][0-9]*)$/.test(key)) throw new PreparationError("PROVENANCE", "invalid array pointer");
+      return current[Number(key)];
+    }
+    const object = z.record(z.unknown()).parse(current);
+    if (!Object.hasOwn(object, key)) throw new PreparationError("PROVENANCE", `missing pointer ${pointer}`);
+    return object[key];
+  }, root);
+}
+
+export async function validateProvenance(input: PreparationInput): Promise<void> {
+  const sources = new Map<string, Uint8Array>();
+  for (const source of input.sources) {
+    if (sources.has(source.id)) throw new PreparationError("PROVENANCE", `duplicate source ${source.id}`);
+    const bytes = await readFile(source.path);
+    if (BigInt(bytes.byteLength) !== BigInt(source.bytes) || fingerprint(bytes) !== source.sha256) {
+      throw new PreparationError("PROVENANCE", `source bytes differ: ${source.id}`);
+    }
+    sources.set(source.id, bytes);
+  }
+  if (!input.sources.some((s) => s.path === input.domain.snapshotArtifact)) {
+    throw new PreparationError("PROVENANCE", "snapshot ABI artifact must be fingerprinted");
+  }
+  const check = (proof: Proof, value: unknown): void => {
+    const raw = sources.get(proof.sourceId);
+    if (!raw) throw new PreparationError("PROVENANCE", `missing source ${proof.sourceId}`);
+    const recorded = pointerValue(JSON.parse(new TextDecoder().decode(raw)), proof.pointer);
+    if (canonical(recorded) !== canonical(value)) {
+      throw new PreparationError("PROVENANCE", `proof does not match full original: ${proof.sourceId}${proof.pointer}`);
+    }
+  };
+  for (const row of input.independent) for (const item of row.entitlements) check(item.proof, item.original);
+  for (const row of input.nfts) check(row.proof, row.original);
+  const descendants = new Set<string>();
+  for (const row of input.exposures) {
+    const { proof, ...record } = row;
+    check(proof, record);
+    const ids = row.descendants.map((d) => d.id);
+    if (new Set(ids).size !== ids.length) throw new PreparationError("PROVENANCE", "duplicate descendant");
+    for (const id of ids) {
+      if (descendants.has(id)) throw new PreparationError("PROVENANCE", "descendant overlaps another origin");
+      descendants.add(id);
+    }
+    const partition = row.descendants.reduce((sum, d) => sum + BigInt(d.units), 0n)
+      + BigInt(row.recoveredUnits) + BigInt(row.excludedUnits);
+    if (partition !== BigInt(row.originalUnits)) {
+      throw new PreparationError("PROVENANCE", `origin partition differs: ${row.originId}`);
+    }
+  }
+}
diff --git a/scripts/recovery/dtf-migration/quotes.ts b/scripts/recovery/dtf-migration/quotes.ts
new file mode 100644
index 00000000..72c9462e
--- /dev/null
+++ b/scripts/recovery/dtf-migration/quotes.ts
@@ -0,0 +1,115 @@
+import { AbiCoder, FetchRequest, Interface, JsonRpcProvider, Network, Result, keccak256 } from "ethers";
+import { readFile } from "node:fs/promises";
+import { z } from "zod";
+import { address, hash, hex, PreparationError, uint } from "./schema.js";
+import type { PreparationInput } from "./schema.js";
+import type { ConfigurationPayload } from "./payloads.js";
+
+const preview = new Interface(["function previewOriginalCredit(uint256,uint256) view returns (uint256)"]);
+const quantity = z.string().regex(/^0x[0-9a-fA-F]+$/);
+const header = z.object({ number: quantity, hash, parentHash: hash }).passthrough();
+export type Quote = {
+  readonly originalEth: string;
+  readonly originalDtf: string;
+  readonly ethCredit: string;
+  readonly dtfCredit: string;
+  readonly credit: string;
+};
+export type QuoteEvidence = {
+  readonly snapshot: string;
+  readonly snapshotId: string;
+  readonly blockHash: string;
+  readonly quotes: readonly Quote[];
+};
+
+// No signer is created. Only these explicit eth_* reads are sent by this module.
+export async function quoteOriginals(input: PreparationInput, payloads: ConfigurationPayload): Promise<QuoteEvidence> {
+  const url = process.env[input.domain.rpcEnv];
+  if (!url) throw new PreparationError("INPUT", `missing RPC environment variable ${input.domain.rpcEnv}`);
+  const endpoint = new URL(url);
+  if (!["http:", "https:"].includes(endpoint.protocol)) throw new PreparationError("DOMAIN", "HTTP RPC required");
+  if (input.purpose === "synthetic-local"
+    && !["localhost", "127.0.0.1", "[::1]"].includes(endpoint.hostname)) {
+    throw new PreparationError("DOMAIN", "synthetic inputs require loopback RPC");
+  }
+  const request = new FetchRequest(url);
+  request.timeout = 15000;
+  const provider = new JsonRpcProvider(request, new Network("dtf-operator", BigInt(input.domain.chainId)),
+    { batchMaxCount: 1, staticNetwork: true });
+  try {
+    const chain = quantity.parse(await provider.send("eth_chainId", []));
+    if (BigInt(chain).toString() !== input.domain.chainId) throw new PreparationError("DOMAIN", "wrong chain");
+    const blockTag = `0x${BigInt(input.domain.blockNumber).toString(16)}`;
+    const before = header.parse(await provider.send("eth_getBlockByNumber", [blockTag, false]));
+    if (before.hash !== input.domain.blockHash || BigInt(before.number).toString() !== input.domain.blockNumber) {
+      throw new PreparationError("DOMAIN", "wrong canonical block");
+    }
+    for (const role of ["proxy", "registry", "package", "facet"] as const) {
+      if (!input.domain.bindings.some((b) => b.role === role)) throw new PreparationError("DOMAIN", `missing ${role} binding`);
+    }
+    const proxies = input.domain.bindings.filter((b) => b.role === "proxy");
+    if (proxies.length !== 1 || proxies[0]?.address !== input.domain.proxy) {
+      throw new PreparationError("DOMAIN", "wrong proxy binding");
+    }
+    for (const binding of input.domain.bindings) {
+      const code = hex.parse(await provider.send("eth_getCode", [binding.address, blockTag]));
+      if (code === "0x" || keccak256(code) !== binding.codeHash) {
+        throw new PreparationError("DOMAIN", `wrong ${binding.role} code`);
+      }
+    }
+    const artifact = z.object({ abi: z.array(z.unknown()) }).parse(
+      JSON.parse(await readFile(input.domain.snapshotArtifact, "utf8")));
+    const iface = new Interface(JSON.stringify(artifact.abi));
+    const fragment = iface.getFunction("migrationSnapshot");
+    const output = fragment?.outputs[0];
+    if (!fragment || !output?.components) throw new PreparationError("INPUT", "missing snapshot ABI");
+    const encoded = hex.parse(await provider.send("eth_call", [
+      { to: input.domain.proxy, data: iface.encodeFunctionData(fragment) }, blockTag,
+    ]));
+    const snapshot: unknown = iface.decodeFunctionResult(fragment, encoded)[0];
+    if (!(snapshot instanceof Result)) throw new PreparationError("QUOTE", "invalid snapshot tuple");
+    const id = hash.parse(snapshot.getValue("id"));
+    const values = snapshot.toArray();
+    const idIndex = output.components.findIndex((p) => p.name === "id");
+    if (idIndex < 0) throw new PreparationError("INPUT", "missing snapshot ID ABI");
+    values[idIndex] = `0x${"0".repeat(64)}`;
+    const sealed = keccak256(AbiCoder.defaultAbiCoder().encode(["string", output],
+      ["IndexedEx.frozen-original-credit", values]));
+    const source: unknown = snapshot.getValue("source");
+    if (!(source instanceof Result) || sealed !== id || id !== input.domain.snapshotId
+      || address.parse(snapshot.getValue("consumer")) !== input.domain.proxy
+      || address.parse(source.getValue("subject")) !== input.domain.proxy
+      || BigInt(snapshot.getValue("chainId")).toString() !== input.domain.chainId
+      || BigInt(snapshot.getValue("version")) !== 1n) {
+      throw new PreparationError("DOMAIN", "snapshot identity/source mismatch");
+    }
+    const originals = [...payloads.independent.flatMap((r) => r.entitlements), ...payloads.nfts];
+    const pairs = new Map(originals.map((r) => [`${r.originalEth}:${r.originalDtf}`, r]));
+    const quotes: Quote[] = [];
+    for (const [, original] of [...pairs].sort(([a], [b]) => a.localeCompare(b))) {
+      const evaluate = async (eth: string, dtf: string): Promise<string> => {
+        const result = hex.parse(await provider.send("eth_call", [{
+          to: input.domain.proxy, data: preview.encodeFunctionData("previewOriginalCredit", [eth, dtf]),
+        }, blockTag]));
+        const decoded: unknown = preview.decodeFunctionResult("previewOriginalCredit", result)[0];
+        return z.bigint().transform((v) => uint.parse(v.toString())).parse(decoded);
+      };
+      const ethCredit = await evaluate(original.originalEth, "0");
+      const dtfCredit = await evaluate("0", original.originalDtf);
+      const credit = await evaluate(original.originalEth, original.originalDtf);
+      if (BigInt(ethCredit) + BigInt(dtfCredit) !== BigInt(credit)) {
+        throw new PreparationError("QUOTE", "independent component quote mismatch");
+      }
+      quotes.push({ originalEth: original.originalEth, originalDtf: original.originalDtf, ethCredit, dtfCredit, credit });
+    }
+    const after = header.parse(await provider.send("eth_getBlockByNumber", [blockTag, false]));
+    if (after.hash !== before.hash) throw new PreparationError("DOMAIN", "block changed during reads");
+    return { snapshot: encoded, snapshotId: id, blockHash: before.hash, quotes };
+  } catch (error) {
+    if (error instanceof PreparationError || error instanceof z.ZodError) throw error;
+    // RPC libraries can include private endpoints in errors; retain no resolved URL.
+    throw new PreparationError("QUOTE", "read-only RPC/ABI acquisition failed; no payload accepted");
+  } finally {
+    provider.destroy();
+  }
+}
