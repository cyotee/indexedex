+// SPDX-License-Identifier: BSL-1.1
+pragma solidity ^0.8.0;
+
+import {Script} from "forge-std/Script.sol";
+import {IERC20} from "@crane/contracts/interfaces/IERC20.sol";
+import {IUniswapV4DetfMigration as Migration, IUniswapV4DetfMigrationAllocation as Allocation}
+    from "contracts/vaults/detf/protocols/dexes/uniswap/v4/migration/interfaces/IUniswapV4DetfMigration.sol";
+import {IUniswapV4DetfMigrationDFPkg as Package}
+    from "contracts/vaults/detf/protocols/dexes/uniswap/v4/migration/interfaces/IUniswapV4DetfMigrationDFPkg.sol";
+import {IUniswapV4DetfMigrationRecovery as Recovery}
+    from "contracts/vaults/detf/protocols/dexes/uniswap/v4/migration/interfaces/IUniswapV4DetfMigrationRecovery.sol";
+
+/// @notice Typed stage simulations. The CLI owns durable intents and submission.
+/// @dev No target/calldata executor and no implicit run() or broadcast flag.
+contract Phase_08_Stage_01_MigrationExecution is Script {
+    function deploy(Package package_, Package.PkgArgs calldata args_) external returns (address proxy_) {
+        vm.startBroadcast(vm.envAddress("SENDER"));
+        proxy_ = package_.deployVault(args_);
+        vm.stopBroadcast();
+    }
+
+    function fund(
+        Migration proxy_, IERC20[] calldata tokens_, uint256[] calldata amounts_,
+        uint256 nativeAmount_, uint256 minimum_, uint256 deadline_
+    ) external returns (uint256 lpOut_) {
+        require(tokens_.length == amounts_.length, "donation arrays");
+        vm.startBroadcast(vm.envAddress("SENDER"));
+        for (uint256 i_; i_ < tokens_.length; ++i_) {
+            require(tokens_[i_].approve(address(proxy_), amounts_[i_]), "donation approval");
+        }
+        lpOut_ = proxy_.donateMigrationCapital{value: nativeAmount_}(
+            tokens_, amounts_, nativeAmount_, minimum_, deadline_
+        );
+        vm.stopBroadcast();
+    }
+
+    function bootstrap(
+        Allocation proxy_, Migration.GenesisLeg[] calldata legs_, uint256 anchor_,
+        uint256 minimum_, uint256 deadline_
+    ) external returns (uint256 selfMinted_, uint256 lpOut_) {
+        vm.startBroadcast(vm.envAddress("SENDER"));
+        (selfMinted_, lpOut_) = proxy_.bootstrapMigrationReserve(legs_, anchor_, minimum_, deadline_);
+        vm.stopBroadcast();
+    }
+
+    function capture(Allocation proxy_) external returns (bytes32 snapshot_) {
+        vm.startBroadcast(vm.envAddress("SENDER"));
+        snapshot_ = proxy_.captureMigrationSnapshot();
+        vm.stopBroadcast();
+    }
+
+    function configureIndependent(Allocation proxy_, Migration.IndependentAllocationInput[] calldata inputs_) external {
+        vm.startBroadcast(vm.envAddress("SENDER"));
+        proxy_.configureIndependentAllocations(inputs_);
+        vm.stopBroadcast();
+    }
+
+    function configureNfts(Allocation proxy_, Migration.NftEntitlementInput[] calldata inputs_) external {
+        vm.startBroadcast(vm.envAddress("SENDER"));
+        proxy_.configureNftEntitlements(inputs_);
+        vm.stopBroadcast();
+    }
+
+    function independentIssue(Allocation proxy_, Migration.IndependentIssuanceRequest[] calldata requests_)
+        external returns (uint256[] memory ids_)
+    {
+        vm.startBroadcast(vm.envAddress("SENDER"));
+        ids_ = proxy_.issueIndependentAllocations(requests_);
+        vm.stopBroadcast();
+    }
+
+    function activate(Allocation proxy_) external {
+        vm.startBroadcast(vm.envAddress("SENDER"));
+        proxy_.activateMigration();
+        vm.stopBroadcast();
+    }
+
+    function harvest(Recovery proxy_, Recovery.Step[] calldata steps_, uint256 deadline_) external {
+        vm.startBroadcast(vm.envAddress("SENDER"));
+        proxy_.recoverMigrationNfts(steps_, deadline_);
+        vm.stopBroadcast();
+    }
+}
diff --git a/scripts/recovery/dtf-migration/cli.ts b/scripts/recovery/dtf-migration/cli.ts
new file mode 100644
index 00000000..29227c55
--- /dev/null
+++ b/scripts/recovery/dtf-migration/cli.ts
@@ -0,0 +1,121 @@
+#!/usr/bin/env bun
+import { parseArgs } from "node:util";
+import { z } from "zod";
+import { prepareFile, validateManifest } from "./preparation.js";
+import { PreparationError } from "./schema.js";
+import { execute } from "./execution.js";
+import { ExecutionError, stage } from "./execution-schema.js";
+import type { Mode } from "./execution-schema.js";
+import { rehearse } from "./rehearse.js";
+
+export const help = `Bounded Migration operator
+  bun scripts/recovery/dtf-migration/cli.ts prepare --input <file> --output <directory>
+  bun scripts/recovery/dtf-migration/cli.ts validate --manifest <file>
+  bun scripts/recovery/dtf-migration/cli.ts <stage> --manifest <file> --checkpoint <directory>
+  bun scripts/recovery/dtf-migration/cli.ts resume --manifest <file> --checkpoint <directory>
+
+prepare reads caller-pinned evidence and the actual immutable snapshot.
+validate rereads evidence, code identities, snapshot and independent ETH/DTF quotes.
+RPC comes only from the manifest's rpcEnv environment variable. No signer is loaded.
+All integers are decimal strings. Inputs are full replacements, not deltas.
+Unsupported categories fail closed. Synthetic datasets are loopback-only.
+Stages: deploy, fund, capture, configure, independent-issue, verify, activate, harvest.
+Every stage and resume defaults to read-only validation; no signer is loaded.
+Local execution: --execute-local --instance-id <exact observed Anvil instance ID>.
+Public execution: --broadcast --confirm-chain <id> --confirm-proxy <address>
+  --confirm-snapshot <id> --signer-key-env <selected environment variable name>.
+--reverse reorders only independent unsettled configuration/issuance rows.
+--fault-after-mined is restricted to synthetic-local interruption rehearsal.
+  bun scripts/recovery/dtf-migration/cli.ts rehearse --rpc-alias robinhood_mainnet_alchemy
+    --fork-block 108944663 --port 18560 --checkpoint <directory> --evidence <directory>
+`;
+
+export async function main(args: readonly string[]): Promise<void> {
+  const { values, positionals, tokens } = parseArgs({
+    args: [...args], allowPositionals: true, strict: true, tokens: true,
+    options: { input: { type: "string" }, output: { type: "string" },
+      manifest: { type: "string" }, checkpoint: { type: "string" }, help: { type: "boolean" },
+      "execute-local": { type: "boolean" }, "instance-id": { type: "string" },
+      broadcast: { type: "boolean" }, "confirm-chain": { type: "string" },
+      "confirm-proxy": { type: "string" }, "confirm-snapshot": { type: "string" },
+      "signer-key-env": { type: "string" }, reverse: { type: "boolean" },
+      "fault-after-mined": { type: "boolean" }, "rpc-alias": { type: "string" },
+      "fork-block": { type: "string" }, port: { type: "string" }, evidence: { type: "string" } },
+  });
+  const suppliedOptions = tokens.filter((token) => token.kind === "option").map((token) => token.name);
+  if (new Set(suppliedOptions).size !== suppliedOptions.length) {
+    throw new PreparationError("INPUT", "duplicate options are not accepted");
+  }
+  if (values.help && positionals.length === 0) {
+    console.log(help);
+    return;
+  }
+  if (positionals.length !== 1) throw new PreparationError("INPUT", "exactly one command required");
+  if (["prepare", "validate"].includes(positionals[0] ?? "")
+    && suppliedOptions.some((name) => !["input", "output", "manifest", "help"].includes(name))) {
+    throw new PreparationError("INPUT", "preparation commands accept no execution flags");
+  }
+  switch (positionals[0]) {
+    case "rehearse": {
+      if (!values["rpc-alias"] || !values["fork-block"] || !values.port || !values.checkpoint || !values.evidence
+        || suppliedOptions.some((name) => !["rpc-alias", "fork-block", "port", "checkpoint", "evidence"].includes(name))) {
+        throw new PreparationError("INPUT", "rehearse requires the exact pinned invocation");
+      }
+      console.log(JSON.stringify(await rehearse({ rpcAlias: values["rpc-alias"], forkBlock: values["fork-block"],
+        port: values.port, checkpoint: values.checkpoint, evidence: values.evidence })));
+      return;
+    }
+    case "prepare": {
+      if (!values.input || !values.output || values.manifest || values.help) {
+        throw new PreparationError("INPUT", "prepare requires only --input and --output");
+      }
+      const result = await prepareFile(values.input, values.output);
+      console.log(JSON.stringify({ command: "prepare", manifestHash: result.normalizedHash,
+        payloadHash: result.payloadHash, fullTask9: result.fullTask9, mode: "read-only" }));
+      return;
+    }
+    case "validate": {
+      if (!values.manifest || values.input || values.output || values.help) {
+        throw new PreparationError("INPUT", "validate requires only --manifest");
+      }
+      const result = await validateManifest(values.manifest);
+      console.log(JSON.stringify({ command: "validate", payloadHash: result.payloadHash,
+        fullTask9: result.fullTask9, mode: "read-only" }));
+      return;
+    }
+    default: {
+      const command = positionals[0] === "resume" ? "resume" : stage.parse(positionals[0]);
+      if (!values.manifest || !values.checkpoint || values.input || values.output || values.help) {
+        throw new PreparationError("INPUT", "stage requires only manifest, checkpoint, and explicit execution options");
+      }
+      if (values["rpc-alias"] || values["fork-block"] || values.port || values.evidence) throw new PreparationError("INPUT", "rehearsal flags require rehearse");
+      if (values["execute-local"] && values.broadcast) throw new PreparationError("INPUT", "execution modes are exclusive");
+      let mode: Mode = { kind: "simulate" };
+      if (values["execute-local"]) {
+        if (!values["instance-id"] || values["confirm-chain"] || values["confirm-proxy"]
+          || values["confirm-snapshot"] || values["signer-key-env"]) throw new PreparationError("INPUT", "local requires only exact instance confirmation");
+        mode = { kind: "local", instanceId: values["instance-id"] };
+      } else if (values.broadcast) {
+        if (!values["confirm-chain"] || !values["confirm-proxy"] || !values["confirm-snapshot"]
+          || !values["signer-key-env"] || values["instance-id"]) throw new PreparationError("INPUT", "all fresh public confirmations required");
+        mode = { kind: "broadcast", chainId: values["confirm-chain"], proxy: values["confirm-proxy"].toLowerCase(),
+          snapshotId: values["confirm-snapshot"].toLowerCase(), keyEnv: values["signer-key-env"] };
+      } else if (values["instance-id"] || values["confirm-chain"] || values["confirm-proxy"]
+        || values["confirm-snapshot"] || values["signer-key-env"]) throw new PreparationError("INPUT", "confirmation requires explicit mode");
+      console.log(JSON.stringify(await execute({ command, manifestPath: values.manifest, checkpoint: values.checkpoint,
+        mode, reverse: values.reverse ?? false, faultAfterMined: values["fault-after-mined"] ?? false })));
+      return;
+    }
+  }
+}
+
+if (import.meta.main) {
+  try {
+    await main(process.argv.slice(2));
+  } catch (error) {
+    if (error instanceof PreparationError || error instanceof ExecutionError) console.error(JSON.stringify({ error: error.code, message: error.message }));
+    else if (error instanceof z.ZodError) console.error(JSON.stringify({ error: "INPUT", issues: error.issues }));
+    else console.error(JSON.stringify({ error: "INPUT", message: "command or file acquisition failed" }));
+    process.exitCode = 1;
+  }
+}
diff --git a/scripts/recovery/dtf-migration/execution-domain.ts b/scripts/recovery/dtf-migration/execution-domain.ts
new file mode 100644
index 00000000..937b59e5
--- /dev/null
+++ b/scripts/recovery/dtf-migration/execution-domain.ts
@@ -0,0 +1,100 @@
+import { readFile } from "node:fs/promises";
+import { resolve } from "node:path";
+import { Interface, Result, keccak256 } from "ethers";
+import { z } from "zod";
+import { canonical, fingerprint } from "./provenance.js";
+import { validateManifest } from "./preparation.js";
+import { address, hex } from "./schema.js";
+import { ExecutionError, executionManifest } from "./execution-schema.js";
+import type { ExecutionManifest } from "./execution-schema.js";
+import type { Rpc } from "./execution-rpc.js";
+
+export const registryAbi = new Interface(["function vaultsOfPackage(address) view returns (address[])"]);
+export const loupeAbi = new Interface([
+  "function facetAddress(bytes4) view returns (address)",
+  "function facets() view returns ((address facetAddress,bytes4[] functionSelectors)[])",
+]);
+
+export async function loadExecution(path: string) {
+  const manifest = executionManifest.parse(JSON.parse(await readFile(resolve(path), "utf8")));
+  for (const source of manifest.sources) {
+    if (!source.path.startsWith("/")) throw new ExecutionError("DOMAIN", "execution source paths must be absolute");
+    const bytes = await readFile(source.path);
+    if (fingerprint(bytes) !== source.sha256 || String(bytes.length) !== source.bytes) {
+      throw new ExecutionError("DOMAIN", `source binding differs: ${source.id}`);
+    }
+  }
+  const prepared = manifest.preparedManifest ? await validateManifest(manifest.preparedManifest) : undefined;
+  if (prepared && (prepared.input.domain.chainId !== manifest.chainId
+    || prepared.input.domain.proxy !== manifest.proxy || prepared.input.domain.snapshotId !== manifest.snapshotId
+    || prepared.input.purpose !== manifest.purpose || prepared.input.domain.rpcEnv !== manifest.rpcEnv
+    || canonical(prepared.input.domain.bindings) !== canonical([...manifest.bindings].sort(
+      (a, b) => a.role.localeCompare(b.role) || a.address.localeCompare(b.address))))) {
+    throw new ExecutionError("DOMAIN", "preparation and execution domains disagree");
+  }
+  if (!prepared && manifest.snapshotId) throw new ExecutionError("DOMAIN", "snapshot requires validated preparation");
+  const artifact = async (name: string) => {
+    const item = manifest.sources.find((s) => s.id === name);
+    if (!item) throw new ExecutionError("DOMAIN", `missing bound ABI artifact ${name}`);
+    const value = z.object({ abi: z.array(z.unknown()) }).parse(JSON.parse(await readFile(item.path, "utf8")));
+    return new Interface(JSON.stringify(value.abi));
+  };
+  const migration = await artifact("migration-abi");
+  const allocation = await artifact("allocation-abi");
+  const recovery = await artifact("recovery-abi");
+  const pkg = await artifact("package-abi");
+  return { manifest, prepared, abis: { migration, allocation, recovery, pkg },
+    domain: { manifest, preparedHash: prepared?.normalizedHash ?? null, payloadHash: prepared?.payloadHash ?? null } };
+}
+export type ExecutionDomain = Awaited<ReturnType<typeof loadExecution>>;
+
+export async function checkRelationships(rpc: Rpc, domain: ExecutionDomain, allowUndeployed: boolean): Promise<void> {
+  const m = domain.manifest;
+  for (const role of ["proxy", "registry", "package", "facet"] as const) {
+    const bindings = m.bindings.filter((b) => b.role === role);
+    if (bindings.length === 0 || (role !== "facet" && bindings.length !== 1)) {
+      throw new ExecutionError("DOMAIN", `missing or ambiguous ${role} identity`);
+    }
+  }
+  for (const binding of m.bindings) {
+    if (binding.role !== "facet" && binding.address !== m[binding.role]) throw new ExecutionError("DOMAIN", "wrong role address");
+    const code = hex.parse(await rpc.send("eth_getCode", [binding.address, "latest"]));
+    if (allowUndeployed && binding.role === "proxy" && code === "0x") continue;
+    if (code === "0x" || keccak256(code) !== binding.codeHash) throw new ExecutionError("DOMAIN", `${binding.role} runtime changed`);
+  }
+  if (allowUndeployed && hex.parse(await rpc.send("eth_getCode", [m.proxy, "latest"])) === "0x") return;
+  const registered = z.array(address).parse((await rpc.call(m.registry, registryAbi, "vaultsOfPackage", [m.package]))[0]);
+  if (!registered.includes(m.proxy)) throw new ExecutionError("DOMAIN", "proxy is not registered under bound package");
+  const facets: unknown = (await rpc.call(m.proxy, loupeAbi, "facets"))[0];
+  const rows = z.array(z.tuple([address, z.array(z.string())])).parse(facets);
+  for (const [facet] of rows) {
+    if (!m.bindings.some((b) => b.role === "facet" && b.address === facet)) {
+      throw new ExecutionError("DOMAIN", "installed facet not in reviewed bindings");
+    }
+  }
+  const activated = (await rpc.call(m.proxy, domain.abis.migration, "migrationActivated"))[0] === true;
+  const cuts: unknown = (await rpc.call(m.package, new Interface([
+    "function facetCuts() view returns((address facetAddress,uint8 action,bytes4[] functionSelectors)[])",
+  ]), "facetCuts"))[0];
+  if (!Array.isArray(cuts)) throw new ExecutionError("DOMAIN", "invalid package cuts");
+  for (const raw of cuts) {
+    if (!(raw instanceof Result)) throw new ExecutionError("DOMAIN", "invalid facet cut");
+    const expected = address.parse(raw.getValue("facetAddress"));
+    for (const selector of z.array(z.string()).parse(raw.getValue("functionSelectors"))) {
+      const removable = domain.abis.allocation.getFunction(selector) !== null;
+      const actual = String((await rpc.call(m.proxy, loupeAbi, "facetAddress", [selector]))[0]).toLowerCase();
+      if (actual !== (activated && removable ? "0x0000000000000000000000000000000000000000" : expected)) {
+        throw new ExecutionError("DOMAIN", "installed selector differs from bound package");
+      }
+    }
+  }
+  if (m.snapshotId) {
+    const snapshot = await rpc.call(m.proxy, domain.abis.migration, "migrationSnapshot");
+    if (snapshot[0].id !== m.snapshotId) throw new ExecutionError("DOMAIN", "current snapshot changed");
+  }
+}
+
+export function requirePrepared(domain: ExecutionDomain) {
+  if (!domain.prepared) throw new ExecutionError("DOMAIN", "stage requires actual post-capture preparation");
+  return domain.prepared;
+}
diff --git a/scripts/recovery/dtf-migration/execution-plan.ts b/scripts/recovery/dtf-migration/execution-plan.ts
new file mode 100644
index 00000000..5665652f
--- /dev/null
+++ b/scripts/recovery/dtf-migration/execution-plan.ts
@@ -0,0 +1,80 @@
+import { Interface } from "ethers";
+import { canonical, fingerprint } from "./provenance.js";
+import { requirePrepared } from "./execution-domain.js";
+import type { ExecutionDomain } from "./execution-domain.js";
+import { assertNever } from "./execution-rpc.js";
+import { ExecutionError } from "./execution-schema.js";
+import type { Operation, Stage } from "./execution-schema.js";
+
+export const erc20Abi = new Interface([
+  "function approve(address,uint256) returns (bool)",
+  "function allowance(address,address) view returns (uint256)",
+  "function balanceOf(address) view returns (uint256)",
+  "function totalSupply() view returns (uint256)",
+]);
+export function plan(domain: ExecutionDomain, stage: Stage): readonly Operation[] {
+  const { manifest: m, abis } = domain;
+  const operations: Operation[] = [];
+  const add = (method: string, args: readonly unknown[], iface = abis.allocation, to = m.proxy, value = "0") => {
+    const transaction = { from: m.signer, to, data: iface.encodeFunctionData(method, args), value };
+    operations.push({ id: fingerprint(canonical({ stage, method, transaction })), stage, method, transaction });
+  };
+  switch (stage) {
+    case "deploy":
+      if (!m.deployment) throw new ExecutionError("DOMAIN", "deploy requires complete typed package arguments");
+      add("deployVault", [m.deployment], abis.pkg, m.package);
+      break;
+    case "fund":
+      if (new Set(m.funding.donations.map((r) => r.id)).size !== m.funding.donations.length) {
+        throw new ExecutionError("DOMAIN", "duplicate funding identity");
+      }
+      for (const donation of m.funding.donations) {
+        if (donation.tokens.length !== donation.amounts.length
+          || new Set(donation.tokens).size !== donation.tokens.length) throw new ExecutionError("DOMAIN", "invalid donation token amounts");
+        for (const [i, token] of donation.tokens.entries()) {
+          const amount = donation.amounts[i];
+          if (!amount) throw new ExecutionError("DOMAIN", "missing donation amount");
+          add("approve", [m.proxy, amount], erc20Abi, token);
+          const approval = operations.pop();
+          if (!approval) throw new ExecutionError("DOMAIN", "missing approval plan");
+          operations.push({ ...approval, id: fingerprint(canonical({ donation: donation.id, token, transaction: approval.transaction })) });
+        }
+        add("donateMigrationCapital", [donation.tokens, donation.amounts, donation.nativeAmount, donation.minimum,
+          donation.deadline], abis.migration, m.proxy, donation.nativeAmount);
+        // Distinct intentional donations must remain distinct even with equal values.
+        const last = operations.pop();
+        if (!last) throw new ExecutionError("DOMAIN", "missing donation plan");
+        operations.push({ ...last, id: fingerprint(canonical({ id: donation.id, transaction: last.transaction })) });
+      }
+      if (m.funding.genesis) {
+        const g = m.funding.genesis;
+        add("bootstrapMigrationReserve", [g.legs, g.anchorIndex, g.minimum, g.deadline]);
+      }
+      if (!operations.length) throw new ExecutionError("DOMAIN", "no funding operation selected");
+      break;
+    case "capture": add("captureMigrationSnapshot", []); break;
+    case "configure": {
+      const p = requirePrepared(domain);
+      for (const row of p.payloads.configure.independent) add("configureIndependentAllocations", [[row.input]]);
+      for (const row of p.payloads.configure.nfts) add("configureNftEntitlements", [[row.input]]);
+      if (!operations.length) throw new ExecutionError("DOMAIN", "no supported configuration selected");
+      break;
+    }
+    case "independent-issue":
+      for (const row of requirePrepared(domain).payloads.independentIssue.requests) add("issueIndependentAllocations", [[row]]);
+      if (!operations.length) throw new ExecutionError("DOMAIN", "no independent issuance selected");
+      break;
+    case "activate": requirePrepared(domain); add("activateMigration", []); break;
+    case "harvest": {
+      const h = requirePrepared(domain).payloads.harvest;
+      if (!h.steps.length) throw new ExecutionError("DOMAIN", "no admitted recovery step selected");
+      const names = ["WeightedClaim", "WeightedPrincipal", "WeightedRewards", "WeightedUnstake",
+        "WeightedConvert", "EarlierClaim", "EarlierSale", "Donate"] as const;
+      add("recoverMigrationNfts", [h.steps.map((s) => ({ ...s, stage: names.indexOf(s.stage) })), h.deadline], abis.recovery);
+      break;
+    }
+    case "verify": requirePrepared(domain); break;
+    default: assertNever(stage);
+  }
+  return operations;
+}
diff --git a/scripts/recovery/dtf-migration/execution-rpc.ts b/scripts/recovery/dtf-migration/execution-rpc.ts
new file mode 100644
index 00000000..7fb6f904
--- /dev/null
+++ b/scripts/recovery/dtf-migration/execution-rpc.ts
@@ -0,0 +1,161 @@
+import { FetchRequest, Interface, JsonRpcProvider, Network, Wallet } from "ethers";
+import { z } from "zod";
+import { hash, hex } from "./schema.js";
+import { ExecutionError, quantity, receipt } from "./execution-schema.js";
+import type { ExecutionManifest, Mode, Receipt } from "./execution-schema.js";
+
+export const DEV = "0xf39fd6e51aad88f6f4ce6ab8827279cfffb92266";
+// Public Anvil development key. Never selected for nonlocal execution.
+const DEV_KEY = "0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80";
+const headerSchema = z.object({ hash, number: quantity }).passthrough();
+
+export class Rpc {
+  readonly provider: JsonRpcProvider;
+  readonly endpoint: URL;
+  constructor(readonly manifest: ExecutionManifest) {
+    const endpoint = process.env[manifest.rpcEnv];
+    if (!endpoint) throw new ExecutionError("DOMAIN", "missing selected RPC environment variable");
+    this.endpoint = new URL(endpoint);
+    if (!["http:", "https:"].includes(this.endpoint.protocol)) throw new ExecutionError("DOMAIN", "HTTP RPC required");
+    const request = new FetchRequest(endpoint);
+    request.timeout = 15000;
+    this.provider = new JsonRpcProvider(request, new Network("migration", BigInt(manifest.chainId)),
+      { staticNetwork: true, batchMaxCount: 1, cacheTimeout: -1 });
+  }
+
+  async send(method: string, params: readonly unknown[]): Promise<unknown> {
+    try { return await this.provider.send(method, [...params]); }
+    catch (error) {
+      if (error instanceof Error) {
+        const revert = "data" in error && typeof error.data === "string" && /^0x[0-9a-f]*$/i.test(error.data) ? error.data : "unavailable";
+        throw new ExecutionError("RPC", `${method} failed; revert=${revert}; endpoint redacted`);
+      }
+      throw error;
+    }
+  }
+
+  async guard(mode: Mode): Promise<void> {
+    if (BigInt(quantity.parse(await this.send("eth_chainId", []))).toString() !== this.manifest.chainId) {
+      throw new ExecutionError("DOMAIN", "wrong chain");
+    }
+    const loopback = ["127.0.0.1", "localhost", "[::1]"].includes(this.endpoint.hostname);
+    if (this.manifest.purpose === "synthetic-local" && !loopback) throw new ExecutionError("DOMAIN", "synthetic input is local only");
+    if (this.manifest.local) {
+      if (!loopback) throw new ExecutionError("DOMAIN", "local identity requires loopback");
+      const metadata = z.object({
+        instanceId: z.string(),
+        forkedNetwork: z.object({
+          chainId: z.number().int().safe(), forkBlockNumber: z.number().int().safe(), forkBlockHash: hash,
+        }),
+      }).passthrough().parse(await this.send("anvil_metadata", []));
+      const expected = this.manifest.local;
+      if (metadata.instanceId !== expected.instanceId
+        || String(metadata.forkedNetwork.chainId) !== this.manifest.chainId
+        || String(metadata.forkedNetwork.forkBlockNumber) !== expected.forkBlockNumber
+        || metadata.forkedNetwork.forkBlockHash !== expected.forkBlockHash) {
+        throw new ExecutionError("DOMAIN", "Anvil instance or fork identity changed");
+      }
+      const block = await this.header(`0x${BigInt(expected.forkBlockNumber).toString(16)}`);
+      if (block.hash !== expected.forkBlockHash) throw new ExecutionError("DOMAIN", "historical fork header changed");
+    }
+    switch (mode.kind) {
+      case "simulate": return;
+      case "local":
+        if (!loopback || !this.manifest.local || mode.instanceId !== this.manifest.local.instanceId
+          || this.manifest.signer !== DEV) throw new ExecutionError("DOMAIN", "explicit exact local identity required");
+        return;
+      case "broadcast":
+        if (this.manifest.purpose !== "operational-review" || this.manifest.local || loopback
+          || mode.chainId !== this.manifest.chainId || mode.proxy !== this.manifest.proxy
+          || mode.snapshotId !== (this.manifest.snapshotId ?? "uncaptured")) {
+          throw new ExecutionError("DOMAIN", "fresh chain/proxy/snapshot confirmations required");
+        }
+        return;
+      default: return assertNever(mode);
+    }
+  }
+
+  wallet(mode: Mode): Wallet {
+    switch (mode.kind) {
+      case "simulate": throw new ExecutionError("DOMAIN", "simulation cannot load a signer");
+      case "local": return new Wallet(DEV_KEY);
+      case "broadcast": {
+        const key = process.env[mode.keyEnv];
+        if (!key) throw new ExecutionError("DOMAIN", "selected signing key unavailable");
+        const wallet = new Wallet(key);
+        if (wallet.address.toLowerCase() !== this.manifest.signer) throw new ExecutionError("DOMAIN", "wrong signer");
+        return wallet;
+      }
+      default: return assertNever(mode);
+    }
+  }
+
+  async header(tag = "latest") { return headerSchema.parse(await this.send("eth_getBlockByNumber", [tag, false])); }
+  async nonce(tag: "latest" | "pending"): Promise<bigint> {
+    return BigInt(quantity.parse(await this.send("eth_getTransactionCount", [this.manifest.signer, tag])));
+  }
+  async call(to: string, iface: Interface, method: string, args: readonly unknown[] = [], block = "latest") {
+    const value = hex.parse(await this.send("eth_call", [{ to, data: iface.encodeFunctionData(method, args) }, block]));
+    return iface.decodeFunctionResult(method, value);
+  }
+  async canonicalReceipt(txHash: string): Promise<Receipt | undefined> {
+    const value = await this.send("eth_getTransactionReceipt", [txHash]);
+    if (value === null) return undefined;
+    const mined = receipt.parse(value);
+    if (mined.transactionHash !== txHash || (await this.header(mined.blockNumber)).hash !== mined.blockHash) {
+      throw new ExecutionError("AMBIGUOUS", "receipt is not canonical");
+    }
+    return mined;
+  }
+  close(): void { this.provider.destroy(); }
+}
+export function assertNever(value: never): never { throw new ExecutionError("DOMAIN", `unknown variant ${String(value)}`); }
+
+// Subscription acknowledgement precedes the caller's send. A single immediate
+// receipt read also covers automining between the subscription and send response.
+export async function subscribeReceipt(rpc: Pick<Rpc, "endpoint" | "canonicalReceipt">, txHash: string) {
+  const endpoint = new URL(rpc.endpoint);
+  endpoint.protocol = endpoint.protocol === "https:" ? "wss:" : "ws:";
+  const socket = new WebSocket(endpoint);
+  const signal = AbortSignal.timeout(60000);
+  let acknowledge: () => void = () => undefined;
+  let fail: (reason: unknown) => void = () => undefined;
+  const ready = new Promise<void>((resolve, reject) => { acknowledge = resolve; fail = reject; });
+  let deliver: (value: Receipt) => void = () => undefined;
+  let rejectReceipt: (reason: unknown) => void = () => undefined;
+  const result = new Promise<Receipt>((resolve, reject) => { deliver = resolve; rejectReceipt = reject; });
+  // A rejection can precede caller await during send; keep it handled, not swallowed.
+  void result.catch(() => undefined);
+  const check = async () => {
+    try { const value = await rpc.canonicalReceipt(txHash); if (value) deliver(value); }
+    catch (error) { rejectReceipt(error); }
+  };
+  const abort = () => {
+    const error = new ExecutionError("AMBIGUOUS", "bounded receipt subscription ended; resume must reconcile");
+    fail(error); rejectReceipt(error); socket.close();
+  };
+  signal.addEventListener("abort", abort, { once: true });
+  socket.addEventListener("open", () => socket.send(JSON.stringify({
+    jsonrpc: "2.0", id: 1, method: "eth_subscribe", params: ["newHeads"],
+  })), { once: true });
+  socket.addEventListener("error", abort, { once: true });
+  socket.addEventListener("close", abort, { once: true });
+  socket.addEventListener("message", (event) => {
+    try {
+      const message = z.object({ id: z.number().optional(), result: z.unknown().optional(),
+        method: z.string().optional(), error: z.unknown().optional() }).passthrough().parse(JSON.parse(String(event.data)));
+      if (message.id === 1 && typeof message.result === "string") acknowledge();
+      else if (message.error) abort();
+      else if (message.method === "eth_subscription") void check();
+    } catch (error) { fail(error); rejectReceipt(error); }
+  });
+  try { await ready; } catch (error) { socket.close(); throw error; }
+  return {
+    async mined(): Promise<Receipt> { await check(); return result; },
+    close(): void {
+      signal.removeEventListener("abort", abort);
+      socket.removeEventListener("close", abort);
+      socket.close();
+    },
+  };
+}
diff --git a/scripts/recovery/dtf-migration/execution-schema.ts b/scripts/recovery/dtf-migration/execution-schema.ts
new file mode 100644
index 00000000..86f27679
--- /dev/null
+++ b/scripts/recovery/dtf-migration/execution-schema.ts
@@ -0,0 +1,106 @@
+import { z } from "zod";
+import { address, binding, hash, hex, identity, positive, sha256, source, uint } from "./schema.js";
+
+export const stages = ["deploy", "fund", "capture", "configure", "independent-issue",
+  "verify", "activate", "harvest"] as const;
+export const stage = z.enum(stages);
+export type Stage = z.infer<typeof stage>;
+export const quantity = z.string().regex(/^0x[0-9a-fA-F]+$/);
+export const localIdentity = z.object({
+  instanceId: z.string().min(1),
+  forkBlockNumber: uint,
+  forkBlockHash: identity,
+}).strict().readonly();
+const route = z.object({ token: address, vault: address }).strict().readonly();
+const routeMode = z.enum(["0", "1"]);
+export const packageArguments = z.object({
+  baseArgs: z.object({
+    name: z.string().min(1), symbol: z.string().min(1), hook: address, ownerOnlyLiquidity: z.boolean(),
+    creationPairPerDetfWad: z.array(uint).readonly(), openingPairPerDetfWad: z.array(uint).readonly(),
+    mintThreshold: uint, burnThreshold: uint, expansionClosureRatePerYearWad: uint,
+    creator: z.string().regex(/^0x[0-9a-fA-F]{40}$/).transform((value) => value.toLowerCase()),
+    claimName: z.string(), claimSymbol: z.string(), bondName: z.string(), bondSymbol: z.string(),
+    mintRouteMode: routeMode, mintRoutes: z.array(route).readonly(),
+    burnRouteMode: routeMode, burnRoutes: z.array(route).readonly(),
+    bondRouteMode: routeMode, bondRoutes: z.array(route).readonly(),
+    donateRouteMode: routeMode, donateRoutes: z.array(route).readonly(),
+  }).strict().readonly(),
+  owner: address, ownershipBufferPeriod: uint, weth: address, originalDtf: address,
+}).strict().readonly();
+export const funding = z.object({
+  donations: z.array(z.object({
+    id: identity,
+    tokens: z.array(address).readonly(),
+    amounts: z.array(positive).readonly(),
+    nativeAmount: uint,
+    minimum: uint,
+    deadline: positive,
+  }).strict().readonly()).readonly(),
+  genesis: z.object({
+    legs: z.array(z.object({ token: address, amount: positive, minSharesOut: positive }).strict().readonly()).min(1).readonly(),
+    anchorIndex: uint, minimum: positive, deadline: positive,
+  }).strict().readonly().nullable(),
+}).strict().readonly();
+// Pre-capture work has no fabricated snapshot. Post-capture work references the
+// preparation manifest, which is reconstructed through validateManifest.
+export const executionManifest = z.object({
+  version: z.literal("dtf-operator-execution-v1"),
+  purpose: z.enum(["synthetic-local", "operational-review"]),
+  chainId: positive,
+  rpcEnv: z.string().regex(/^[A-Z][A-Z0-9_]*$/),
+  signer: address,
+  local: localIdentity.nullable(),
+  proxy: address,
+  registry: address,
+  package: address,
+  snapshotId: identity.nullable(),
+  bindings: z.array(binding).min(3).readonly(),
+  sources: z.array(source).min(1).readonly(),
+  preparedManifest: z.string().min(1).nullable(),
+  deployment: packageArguments.nullable(),
+  funding,
+}).strict().readonly();
+export type ExecutionManifest = z.infer<typeof executionManifest>;
+export type Mode =
+  | { readonly kind: "simulate" }
+  | { readonly kind: "local"; readonly instanceId: string }
+  | { readonly kind: "broadcast"; readonly chainId: string; readonly proxy: string;
+      readonly snapshotId: string; readonly keyEnv: string };
+export class ExecutionError extends Error {
+  constructor(readonly code: "DOMAIN" | "INTENT" | "AMBIGUOUS" | "REVERT" | "STATE" | "LOCK" | "RPC", message: string) {
+    super(message);
+    this.name = "ExecutionError";
+  }
+}
+export const transaction = z.object({
+  from: address, to: address, data: hex, value: uint,
+}).strict().readonly();
+export type Operation = {
+  readonly id: string;
+  readonly stage: Stage;
+  readonly method: string;
+  readonly transaction: z.infer<typeof transaction>;
+};
+export const rpcLog = z.object({
+  address, topics: z.array(hash), data: hex, logIndex: quantity,
+}).passthrough().readonly();
+export const receipt = z.object({
+  transactionHash: hash, blockHash: hash, blockNumber: quantity,
+  from: address, to: address.nullable(), status: quantity,
+  transactionIndex: quantity, logs: z.array(rpcLog),
+}).passthrough().readonly();
+export type Receipt = z.infer<typeof receipt>;
+export const intent = z.object({
+  version: z.literal("dtf-operator-intent-v1"),
+  domainHash: sha256, id: sha256, stage,
+  method: z.string(), transaction,
+  nonce: uint, startBlock: uint,
+  signedTransaction: hex, transactionHash: identity,
+}).strict().readonly();
+export type Intent = z.infer<typeof intent>;
+export const completion = z.object({
+  intentHash: sha256, receipt,
+  state: z.record(z.string(), z.string()),
+  events: z.array(z.object({ name: z.string(), values: z.array(z.string()) }).strict()),
+}).strict().readonly();
+export type Completion = z.infer<typeof completion>;
diff --git a/scripts/recovery/dtf-migration/execution-state.ts b/scripts/recovery/dtf-migration/execution-state.ts
new file mode 100644
index 00000000..9950b387
--- /dev/null
+++ b/scripts/recovery/dtf-migration/execution-state.ts
@@ -0,0 +1,204 @@
+import { Interface, Result } from "ethers";
+import { z } from "zod";
+import { requirePrepared, checkRelationships, loupeAbi } from "./execution-domain.js";
+import type { ExecutionDomain } from "./execution-domain.js";
+import { erc20Abi } from "./execution-plan.js";
+import type { Rpc } from "./execution-rpc.js";
+import { ExecutionError } from "./execution-schema.js";
+import type { Completion, Intent, Receipt } from "./execution-schema.js";
+import { canonical, fingerprint } from "./provenance.js";
+
+function tuple(value: unknown): Result {
+  if (!(value instanceof Result)) throw new ExecutionError("STATE", "invalid contract tuple");
+  return value;
+}
+function valueString(value: unknown): string {
+  if (typeof value === "bigint" || typeof value === "boolean" || typeof value === "string") return String(value);
+  if (value instanceof Result) return canonical(value.toArray(true).map(valueString));
+  if (Array.isArray(value)) return canonical(value.map(valueString));
+  throw new ExecutionError("STATE", "unsupported contract result");
+}
+
+export async function captureCompletion(rpc: Rpc, domain: ExecutionDomain, item: Intent, mined: Receipt): Promise<Completion> {
+  if (BigInt(mined.status) !== 1n) throw new ExecutionError("REVERT", `canonical transaction reverted: ${item.transactionHash}`);
+  if (mined.from !== item.transaction.from || mined.to !== item.transaction.to) {
+    throw new ExecutionError("INTENT", "receipt target or signer mismatch");
+  }
+  const { manifest: m, abis } = domain;
+  const events: { name: string; values: string[] }[] = [];
+  for (const log of mined.logs) {
+    if (log.address !== m.proxy) continue;
+    for (const abi of [abis.migration, abis.allocation, abis.recovery]) {
+      const parsed = abi.parseLog({ topics: [...log.topics], data: log.data });
+      if (parsed) { events.push({ name: parsed.name, values: [...parsed.args].map(valueString) }); break; }
+    }
+  }
+  const state: Record<string, string> = {};
+  const at = mined.blockNumber;
+  const query = async (method: string, args: readonly unknown[] = []) => {
+    const result = await rpc.call(m.proxy, abis.migration, method, args, at);
+    state[`${method}:${canonical(args.map(valueString))}`] = canonical([...result].map(valueString));
+    return result;
+  };
+  const requireEvent = (name: string) => {
+    if (!events.some((e) => e.name === name)) throw new ExecutionError("STATE", `missing actual ${name} event`);
+  };
+  switch (item.method) {
+    case "deployVault":
+      await checkRelationships(rpc, domain, false);
+      state["owner"] = String((await query("owner"))[0]).toLowerCase();
+      if (state["owner"] !== m.deployment?.owner) throw new ExecutionError("STATE", "deployed owner mismatch");
+      break;
+    case "approve": {
+      const allowance = await rpc.call(item.transaction.to, erc20Abi, "allowance", [m.signer, m.proxy], at);
+      const args = erc20Abi.decodeFunctionData("approve", item.transaction.data);
+      if (allowance[0] !== args[1]) throw new ExecutionError("STATE", "approval state mismatch");
+      state["allowance"] = valueString(allowance[0]);
+      break;
+    }
+    case "donateMigrationCapital": {
+      requireEvent("MigrationCapitalReceived");
+      const args = abis.migration.decodeFunctionData(item.method, item.transaction.data);
+      const tokens = z.array(z.string()).parse(args[0]);
+      const amounts = z.array(z.bigint()).parse(args[1]);
+      const expected = new Map(tokens.map((token, i) => [token.toLowerCase(), z.bigint().parse(amounts[i])] as const));
+      const native = z.bigint().parse(args[2]);
+      if (native > 0n) {
+        const source = tuple((await query("migrationSnapshotSource"))[0]);
+        const weth = String(source.getValue("weth")).toLowerCase();
+        expected.set(weth, (expected.get(weth) ?? 0n) + native);
+      }
+      for (const [token, amount] of expected) {
+        const received = events.filter((e) => e.name === "MigrationCapitalReceived"
+          && e.values[0]?.toLowerCase() === m.signer && e.values[1]?.toLowerCase() === token.toLowerCase())
+          .reduce((sum, e) => sum + BigInt(z.string().parse(e.values[2])), 0n);
+        if (received !== amount) throw new ExecutionError("STATE", "donation receipt amount mismatch");
+        await query("migrationDonationInventory", [token]);
+      }
+      state["nativeAmount"] = valueString(args[2]);
+      break;
+    }
+    case "bootstrapMigrationReserve":
+      requireEvent("MigrationReserveBootstrapped");
+      await query("migrationBootstrapSelfMinted");
+      break;
+    case "captureMigrationSnapshot": {
+      requireEvent("MigrationSnapshotCaptured");
+      const snapshot = tuple((await query("migrationSnapshot"))[0]);
+      if (!events.some((e) => e.name === "MigrationSnapshotCaptured" && e.values[0] === snapshot.getValue("id"))) {
+        throw new ExecutionError("STATE", "captured snapshot event/state mismatch");
+      }
+      break;
+    }
+    case "configureIndependentAllocations":
+    case "configureNftEntitlements": {
+      const p = requirePrepared(domain);
+      const independent = item.method === "configureIndependentAllocations";
+      requireEvent(independent ? "IndependentAllocationConfigured" : "NftEntitlementConfigured");
+      const args = abis.allocation.decodeFunctionData(item.method, item.transaction.data);
+      const rows: unknown = args[0];
+      if (!Array.isArray(rows)) throw new ExecutionError("STATE", "invalid configuration tuple array");
+      for (const row of rows) {
+        const r = tuple(row);
+        const expected = independent
+          ? p.payloads.configure.independent.find((x) => x.input.recipient === String(r.getValue("recipient")).toLowerCase())
+          : p.payloads.configure.nfts.find((x) => x.input.collection === String(r.getValue("collection")).toLowerCase()
+            && x.input.tokenId === String(r.getValue("tokenId")));
+        if (!expected) throw new ExecutionError("STATE", "unbound configuration");
+        const actual = tuple((await query(independent ? "independentAllocation" : "nftEntitlement",
+          independent ? [r.getValue("recipient")] : [r.getValue("collection"), r.getValue("tokenId")]))[0]);
+        if (actual.getValue("configurationId") !== expected.configurationId
+          || String(actual.getValue(independent ? "totalCredit" : "credit")) !== expected.quotedCredit) {
+          throw new ExecutionError("STATE", "configuration state differs from full payload");
+        }
+      }
+      break;
+    }
+    case "issueIndependentAllocations": {
+      requireEvent("IndependentAllocationIssued");
+      for (const event of events.filter((e) => e.name === "IndependentAllocationIssued")) {
+        const recipient = event.values[0];
+        if (!recipient) throw new ExecutionError("STATE", "missing issued recipient");
+        const issued = tuple((await query("independentIssuance", [recipient]))[0]);
+        if (issued.getValue("issued") !== true || String(issued.getValue("bondTokenId")) !== event.values[2]
+          || issued.getValue("configurationId") !== event.values[1]
+          || String(issued.getValue("credit")) !== event.values[3]) throw new ExecutionError("STATE", "issuance receipt/state mismatch");
+        const bond = String((await query("bondNftVault"))[0]);
+        const bondAbi = new Interface([
+          "function ownerOf(uint256) view returns(address)",
+          "function positionOf(uint256) view returns((uint256 principal,uint256 claimedPrincipal,uint256 stakingGons,uint256 startTimestamp,uint256 vestingDuration))",
+          "function isMigrationPosition(uint256) view returns(bool)",
+        ]);
+        const bondId = issued.getValue("bondTokenId");
+        const position = tuple((await rpc.call(bond, bondAbi, "positionOf", [bondId], at))[0]);
+        if (position.getValue("principal") !== issued.getValue("credit")
+          || position.getValue("startTimestamp") !== issued.getValue("issuedAt")
+          || position.getValue("vestingDuration") !== 7776000n
+          || String((await rpc.call(bond, bondAbi, "ownerOf", [bondId], at))[0]).toLowerCase() !== recipient.toLowerCase()
+          || (await rpc.call(bond, bondAbi, "isMigrationPosition", [bondId], at))[0] !== true) {
+          throw new ExecutionError("STATE", "actual bond identity, principal, owner or fresh cliff differs");
+        }
+        state[`bond:${bondId}`] = valueString(position);
+      }
+      break;
+    }
+    case "activateMigration":
+      requireEvent("MigrationActivated");
+      if ((await query("migrationActivated"))[0] !== true) throw new ExecutionError("STATE", "activation state mismatch");
+      for (const fragment of abis.allocation.fragments) {
+        if (fragment.type !== "function") continue;
+        const fn = abis.allocation.getFunction(fragment.format("sighash"));
+        if (!fn || String((await rpc.call(m.proxy, loupeAbi, "facetAddress", [fn.selector], at))[0])
+          !== "0x0000000000000000000000000000000000000000") throw new ExecutionError("STATE", "administration selector survived activation");
+      }
+      break;
+    case "recoverMigrationNfts": {
+      if (!events.some((e) => ["MigrationRecoveryClaimed", "MigrationRecoverySold", "MigrationRecoveryConverted",
+        "MigrationRecoveryDonated"].includes(e.name))) throw new ExecutionError("STATE", "recovery has no economic event");
+      const gons = await rpc.call(m.proxy, abis.recovery, "migrationRecoveryGons", [], at);
+      state["attributedGons"] = valueString(gons[0]);
+      for (const token of ["0x4fa4974a8a09660258b8edd430b51c1620ebfe5c",
+        "0x4a5cfdc2b07016fcf917f4ed5a51c52111a0fcc7", "0xee5576fa1bcaa380e591d01245f406f3f384eb01"]) {
+        state[`inventory:${token}`] = valueString((await rpc.call(m.proxy, abis.recovery, "migrationRecoveryInventory", [token], at))[0]);
+      }
+      const steps: unknown = abis.recovery.decodeFunctionData(item.method, item.transaction.data)[0];
+      if (!Array.isArray(steps)) throw new ExecutionError("STATE", "invalid recovery selection");
+      for (const raw of steps) {
+        const step = tuple(raw);
+        const stage = z.bigint().parse(step.getValue("stage"));
+        const tokenId = z.bigint().parse(step.getValue("tokenId"));
+        if (tokenId === 0n) continue;
+        const collection = stage <= 2n ? "0xfe4cc6d5faafdf210af4e728f4108fcaad9bb65e"
+          : "0x15666f0b4c8d09d046d2aa9048afcaf49e8cb391";
+        const surrender = tuple((await query("nftSurrender", [collection, tokenId]))[0]);
+        if (surrender.getValue("consumed") !== true) throw new ExecutionError("STATE", "recovery lacks consumed custody");
+        state[`recovery:${collection}:${tokenId}`] = valueString(
+          (await rpc.call(m.proxy, abis.recovery, "migrationNftRecovery", [collection, tokenId], at))[0]);
+      }
+      break;
+    }
+    default: throw new ExecutionError("INTENT", "method outside fixed stage plan");
+  }
+  return { intentHash: fingerprint(canonical(item)), receipt: mined, state, events };
+}
+
+export async function verifyConfiguration(rpc: Rpc, domain: ExecutionDomain) {
+  const prepared = requirePrepared(domain);
+  const rows = [];
+  for (const row of prepared.payloads.configure.independent) {
+    const actual = tuple((await rpc.call(domain.manifest.proxy, domain.abis.migration, "independentAllocation", [row.input.recipient]))[0]);
+    const issuance = tuple((await rpc.call(domain.manifest.proxy, domain.abis.migration, "independentIssuance", [row.input.recipient]))[0]);
+    if (actual.getValue("configurationId") !== row.configurationId || String(actual.getValue("totalCredit")) !== row.quotedCredit) {
+      throw new ExecutionError("STATE", "independent configuration mismatch");
+    }
+    rows.push({ recipient: row.input.recipient, issued: issuance.getValue("issued") === true,
+      bondTokenId: String(issuance.getValue("bondTokenId")) });
+  }
+  for (const row of prepared.payloads.configure.nfts) {
+    const actual = tuple((await rpc.call(domain.manifest.proxy, domain.abis.migration, "nftEntitlement",
+      [row.input.collection, row.input.tokenId]))[0]);
+    if (actual.getValue("configurationId") !== row.configurationId || actual.getValue("originalId") !== row.originalId
+      || String(actual.getValue("credit")) !== row.quotedCredit) throw new ExecutionError("STATE", "NFT configuration mismatch");
+  }
+  return { rows, totalSupply: String((await rpc.call(domain.manifest.proxy, erc20Abi, "totalSupply"))[0]) };
+}
diff --git a/scripts/recovery/dtf-migration/execution.test.ts b/scripts/recovery/dtf-migration/execution.test.ts
new file mode 100644
index 00000000..3621773e
--- /dev/null
+++ b/scripts/recovery/dtf-migration/execution.test.ts
@@ -0,0 +1,84 @@
+import { afterEach, test } from "node:test";
+import assert from "node:assert/strict";
+import { mkdtemp, readdir, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { Wallet, keccak256 } from "ethers";
+import { Journal } from "./journal.js";
+import { canonical, fingerprint } from "./provenance.js";
+import { intent, funding } from "./execution-schema.js";
+import { main } from "./cli.js";
+
+const roots: string[] = [];
+async function directory() {
+  const root = await mkdtemp(join(tmpdir(), "dtf-execution-test-"));
+  roots.push(root);
+  return root;
+}
+afterEach(async () => { for (const root of roots.splice(0)) await rm(root, { recursive: true }); });
+
+test("journal refuses live concurrent writers and changed domains", async () => {
+  const root = await directory();
+  const journal = await Journal.acquire(root, { chain: "4663", proxy: "original" });
+  await assert.rejects(Journal.acquire(root, { chain: "4663", proxy: "original" }), /live writer/);
+  await journal.close();
+  await assert.rejects(Journal.acquire(root, { chain: "4663", proxy: "different" }), /domain changed/);
+  const resumed = await Journal.acquire(root, { chain: "4663", proxy: "original" });
+  await resumed.close();
+});
+
+test("durable signed intent survives reopening without acquiring another nonce", async () => {
+  const root = await directory();
+  const domain = { chain: "4663", snapshot: "frozen", payload: "complete" };
+  const journal = await Journal.acquire(root, domain);
+  const wallet = new Wallet("0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80");
+  const transaction = { from: wallet.address.toLowerCase(), to: "0x1111111111111111111111111111111111111111", data: "0x", value: "19" };
+  const raw = await wallet.signTransaction({ to: transaction.to, value: 19n, nonce: 7, gasPrice: 2n, gasLimit: 21000n, chainId: 4663n });
+  const record = intent.parse({
+    version: "dtf-operator-intent-v1", domainHash: journal.domainHash, id: fingerprint("donation"),
+    stage: "fund", method: "donateMigrationCapital", transaction, nonce: "7", startBlock: "100",
+    signedTransaction: raw, transactionHash: keccak256(raw),
+  });
+  await journal.persistIntent(record);
+  await journal.close();
+  const resumed = await Journal.acquire(root, domain);
+  assert.deepEqual(await resumed.intents(), [record]);
+  await assert.rejects(resumed.persistIntent(record), { code: "EEXIST" });
+  assert.equal((await readdir(root)).filter((name) => name.endsWith(".intent.json")).length, 1);
+  await resumed.close();
+});
+
+test("journal rejects a foreign intent rather than accepting its receipt", async () => {
+  const root = await directory();
+  const journal = await Journal.acquire(root, { payload: "one" });
+  await writeFile(join(root, "foreign.intent.json"), "{}");
+  await assert.rejects(journal.intents());
+  await journal.close();
+  assert.equal(JSON.parse(await readFile(join(root, "domain.json"), "utf8")).payload, "one");
+});
+
+test("partial unpublished records cannot become completed operations", async () => {
+  const root = await directory();
+  const journal = await Journal.acquire(root, { payload: "one" });
+  await writeFile(join(root, "interrupted.intent.json.pending"), '{"nonce":');
+  assert.deepEqual(await journal.intents(), []);
+  await journal.close();
+});
+
+test("funding rejects arbitrary calldata and unknown native values", () => {
+  assert.equal(funding.safeParse({ donations: [], genesis: null, calldata: "0x" }).success, false);
+  assert.equal(funding.safeParse({ donations: [{
+    id: `0x${"1".repeat(64)}`, tokens: [], amounts: [], nativeAmount: null, minimum: "0", deadline: "100",
+  }], genesis: null }).success, false);
+});
+
+for (const { args, reason } of [
+  { args: ["fund", "--manifest", "unused", "--checkpoint", "unused", "--execute-local", "--broadcast"], reason: /execution modes are exclusive/ },
+  { args: ["resume", "--manifest", "unused", "--checkpoint", "unused", "--instance-id", "old"], reason: /confirmation requires explicit mode/ },
+  { args: ["activate", "--manifest", "unused", "--checkpoint", "unused", "--broadcast"], reason: /all fresh public confirmations required/ },
+  { args: ["fund", "--manifest", "unused", "--checkpoint", "unused", "--target", "0x1111111111111111111111111111111111111111"], reason: /Unknown option/ },
+]) {
+  test(`CLI rejects ambiguous authority before file or network access: ${canonical(args)}`, async () => {
+    await assert.rejects(main(args), reason);
+  });
+}
diff --git a/scripts/recovery/dtf-migration/execution.ts b/scripts/recovery/dtf-migration/execution.ts
new file mode 100644
index 00000000..2ce759db
--- /dev/null
+++ b/scripts/recovery/dtf-migration/execution.ts
@@ -0,0 +1,178 @@
+import { readFile, readdir, open } from "node:fs/promises";
+import { join } from "node:path";
+import { Transaction, keccak256 } from "ethers";
+import { z } from "zod";
+import { canonical, fingerprint } from "./provenance.js";
+import { checkRelationships, loadExecution } from "./execution-domain.js";
+import type { ExecutionDomain } from "./execution-domain.js";
+import { plan } from "./execution-plan.js";
+import { Rpc, subscribeReceipt } from "./execution-rpc.js";
+import { captureCompletion, verifyConfiguration } from "./execution-state.js";
+import { ExecutionError, intent, quantity, stage as stageSchema } from "./execution-schema.js";
+import type { Intent, Mode, Operation, Stage } from "./execution-schema.js";
+import { Journal } from "./journal.js";
+import { hash, hex } from "./schema.js";
+
+type Run = {
+  readonly command: Stage | "resume";
+  readonly manifestPath: string;
+  readonly checkpoint: string;
+  readonly mode: Mode;
+  readonly reverse: boolean;
+  readonly faultAfterMined: boolean;
+};
+const runSchema = z.object({ stage: stageSchema, operationIds: z.array(z.string()) }).strict();
+
+function validateIntent(record: Intent, operation: Operation): void {
+  const signed = Transaction.from(record.signedTransaction);
+  if (record.id !== operation.id || record.stage !== operation.stage || record.method !== operation.method
+    || canonical(record.transaction) !== canonical(operation.transaction)
+    || signed.hash !== record.transactionHash || signed.from?.toLowerCase() !== operation.transaction.from
+    || signed.to?.toLowerCase() !== operation.transaction.to || signed.data !== operation.transaction.data
+    || signed.value.toString() !== operation.transaction.value || String(signed.nonce) !== record.nonce) {
+    throw new ExecutionError("INTENT", "signed transaction does not match fixed stage operation");
+  }
+}
+
+async function reconcile(rpc: Rpc, domain: ExecutionDomain, journal: Journal, record: Intent) {
+  const saved = await journal.completed(record);
+  const mined = await rpc.canonicalReceipt(record.transactionHash);
+  if (!mined) {
+    if (saved) throw new ExecutionError("AMBIGUOUS", "completed receipt disappeared; no replay permitted");
+    const found = await rpc.send("eth_getTransactionByHash", [record.transactionHash]);
+    if (found !== null) throw new ExecutionError("AMBIGUOUS", "transaction exists without canonical receipt; no resend");
+    if (await rpc.nonce("latest") !== BigInt(record.nonce) || await rpc.nonce("pending") !== BigInt(record.nonce)) {
+      throw new ExecutionError("AMBIGUOUS", "nonce moved without known canonical receipt; no resend");
+    }
+    return undefined;
+  }
+  const actual = z.object({ hash, from: z.string(), to: z.string().nullable(), input: hex,
+    value: quantity, nonce: quantity, blockHash: hash }).passthrough().parse(
+    await rpc.send("eth_getTransactionByHash", [record.transactionHash]));
+  if (actual.hash !== record.transactionHash || actual.from.toLowerCase() !== record.transaction.from
+    || actual.to?.toLowerCase() !== record.transaction.to || actual.input !== record.transaction.data
+    || BigInt(actual.nonce).toString() !== record.nonce || actual.blockHash !== mined.blockHash
+    || BigInt(actual.value).toString() !== record.transaction.value) throw new ExecutionError("INTENT", "canonical transaction differs");
+  const result = await captureCompletion(rpc, domain, record, mined);
+  if (saved && canonical(saved) !== canonical(result)) throw new ExecutionError("STATE", "canonical receipt/state differs from checkpoint");
+  if (!saved) await journal.complete(record, result);
+  return result;
+}
+
+export async function execute(run: Run) {
+  const domain = await loadExecution(run.manifestPath);
+  const rpc = new Rpc(domain.manifest);
+  try {
+    await rpc.guard(run.mode);
+    const storedRun = run.command === "resume" ? runSchema.parse(
+      JSON.parse(await readFile(join(run.checkpoint, "run.json"), "utf8"))) : undefined;
+    const selected = storedRun?.stage ?? stageSchema.parse(run.command);
+    if (storedRun && canonical(JSON.parse(await readFile(join(run.checkpoint, "domain.json"), "utf8"))) !== canonical(domain.domain)) {
+      throw new ExecutionError("DOMAIN", "checkpoint domain changed");
+    }
+    await checkRelationships(rpc, domain, selected === "deploy");
+    if (selected === "verify") return { mode: "read-only", command: selected, verification: await verifyConfiguration(rpc, domain) };
+    if (selected === "activate") {
+      const verified = await verifyConfiguration(rpc, domain);
+      for (const request of domain.prepared?.payloads.independentIssue.requests ?? []) {
+        if (!verified.rows.some((row) => row.recipient === request.recipient && row.issued)) {
+          throw new ExecutionError("STATE", "selected independent issuance is unfinished");
+        }
+      }
+    }
+    const operations = plan(domain, selected);
+    if (new Set(operations.map((o) => o.id)).size !== operations.length) throw new ExecutionError("INTENT", "duplicate operation identity");
+    if (run.reverse && !["configure", "independent-issue"].includes(selected)) throw new ExecutionError("DOMAIN", "only independent unsettled rows may reorder");
+    if (storedRun && canonical([...storedRun.operationIds].sort()) !== canonical(operations.map((o) => o.id).sort())) {
+      throw new ExecutionError("DOMAIN", "resume plan differs");
+    }
+    if (run.faultAfterMined && (run.mode.kind !== "local" || domain.manifest.purpose !== "synthetic-local")) {
+      throw new ExecutionError("DOMAIN", "fault injection is synthetic-local only");
+    }
+    if (run.mode.kind === "simulate") {
+      // No wallet, send, inherited mode, or success receipt on the default path.
+      return { mode: "read-only", command: selected, domainHash: fingerprint(canonical(domain.domain)),
+        operationIds: operations.map((o) => o.id), fullTask9: "open" };
+    }
+    const journal = await Journal.acquire(run.checkpoint, domain.domain);
+    try {
+      const runPath = join(run.checkpoint, "run.json");
+      const expectedRun = { stage: selected, operationIds: operations.map((o) => o.id) };
+      if ((await readdir(run.checkpoint)).includes("run.json")) {
+        const previous = runSchema.parse(JSON.parse(await readFile(runPath, "utf8")));
+        if (canonical(previous) !== canonical(expectedRun)) throw new ExecutionError("DOMAIN", "checkpoint command changed");
+      } else {
+        const file = await open(runPath, "wx", 0o600);
+        try { await file.writeFile(canonical(expectedRun)); await file.sync(); } finally { await file.close(); }
+        await journal.syncDirectory();
+      }
+      const existing = await journal.intents();
+      for (const record of existing) {
+        const operation = operations.find((o) => o.id === record.id);
+        if (!operation) throw new ExecutionError("INTENT", "checkpoint contains unselected operation");
+        validateIntent(record, operation);
+        if (Transaction.from(record.signedTransaction).chainId.toString() !== domain.manifest.chainId) {
+          throw new ExecutionError("DOMAIN", "signed transaction chain changed");
+        }
+      }
+      const results = [];
+      // Resolve every prior intent before assigning another nonce, regardless of batching.
+      for (const record of existing) {
+        const result = await reconcile(rpc, domain, journal, record);
+        if (result) results.push(result);
+      }
+      for (const operation of run.reverse ? [...operations].reverse() : operations) {
+        let record = existing.find((i) => i.id === operation.id);
+        if (record && await journal.completed(record)) continue;
+        await rpc.guard(run.mode);
+        if (!record) {
+          const nonce = await rpc.nonce("pending");
+          if (nonce !== await rpc.nonce("latest")) throw new ExecutionError("AMBIGUOUS", "signer has pending unrelated transaction");
+          const { from, to, data, value } = operation.transaction;
+          // Exact finite ABI operation is simulated before signing. No retry after a revert.
+          const simulationInput = { from, to, data, value: `0x${BigInt(value).toString(16)}` };
+          let simulated: string;
+          try { simulated = hex.parse(await rpc.send("eth_call", [simulationInput, "latest"])); }
+          catch (error) {
+            if (run.mode.kind === "local") {
+              const trace = await rpc.send("debug_traceCall", [simulationInput, "latest", { tracer: "callTracer" }]);
+              const file = await open(join(run.checkpoint, `${operation.id}.simulation-failure.json`), "wx", 0o600);
+              try { await file.writeFile(canonical({ operation, trace })); await file.sync(); } finally { await file.close(); }
+            }
+            throw error;
+          }
+          if (operation.method === "deployVault"
+            && String(domain.abis.pkg.decodeFunctionResult("deployVault", simulated)[0]).toLowerCase() !== domain.manifest.proxy) {
+            throw new ExecutionError("DOMAIN", "package deployment does not predict bound proxy");
+          }
+          const estimate = BigInt(quantity.parse(await rpc.send("eth_estimateGas", [{ from, to, data, value: `0x${BigInt(value).toString(16)}` }])));
+          const gasPrice = BigInt(quantity.parse(await rpc.send("eth_gasPrice", [])));
+          if (nonce > BigInt(Number.MAX_SAFE_INTEGER)) throw new ExecutionError("INTENT", "nonce exceeds signer safe range");
+          const raw = await rpc.wallet(run.mode).signTransaction({
+            chainId: BigInt(domain.manifest.chainId), nonce: Number(nonce), to, data, value: BigInt(value),
+            gasLimit: estimate * 3n / 2n, gasPrice, type: 0,
+          });
+          record = intent.parse({ version: "dtf-operator-intent-v1", domainHash: journal.domainHash,
+            id: operation.id, stage: operation.stage, method: operation.method, transaction: operation.transaction,
+            nonce: nonce.toString(), startBlock: BigInt((await rpc.header()).number).toString(),
+            signedTransaction: raw, transactionHash: keccak256(raw) });
+          await journal.persistIntent(record);
+        }
+        const watch = await subscribeReceipt(rpc, record.transactionHash);
+        try {
+          const sent = hash.parse(await rpc.send("eth_sendRawTransaction", [record.signedTransaction]));
+          if (sent !== record.transactionHash) throw new ExecutionError("INTENT", "node returned another transaction hash");
+          const mined = await watch.mined();
+          if (run.faultAfterMined && ["donateMigrationCapital", "issueIndependentAllocations"].includes(record.method)) {
+            console.log(JSON.stringify({ fault: "mined-before-checkpoint", transactionHash: mined.transactionHash, nonce: record.nonce }));
+            process.kill(process.pid, "SIGKILL");
+          }
+          const result = await reconcile(rpc, domain, journal, record);
+          if (!result) throw new ExecutionError("AMBIGUOUS", "mined transaction disappeared");
+          results.push(result);
+        } finally { watch.close(); }
+      }
+      return { command: selected, mode: run.mode.kind, receipts: results, fullTask9: "open" };
+    } finally { await journal.close(); }
+  } finally { rpc.close(); }
+}
diff --git a/scripts/recovery/dtf-migration/journal.ts b/scripts/recovery/dtf-migration/journal.ts
new file mode 100644
index 00000000..3e5fb35d
--- /dev/null
+++ b/scripts/recovery/dtf-migration/journal.ts
@@ -0,0 +1,107 @@
+import { link, mkdir, open, readFile, readdir, unlink } from "node:fs/promises";
+import { join } from "node:path";
+import { randomUUID } from "node:crypto";
+import { z } from "zod";
+import { canonical, fingerprint } from "./provenance.js";
+import { completion, ExecutionError, intent } from "./execution-schema.js";
+import type { Completion, Intent } from "./execution-schema.js";
+
+async function durableCreate(path: string, value: unknown): Promise<void> {
+  const temporary = `${path}.${randomUUID()}.pending`;
+  const file = await open(temporary, "wx", 0o600);
+  try {
+    await file.writeFile(`${canonical(value)}\n`);
+    await file.sync();
+  } finally {
+    await file.close();
+  }
+  try { await link(temporary, path); } finally { await unlink(temporary); }
+}
+
+export class Journal {
+  private constructor(readonly directory: string, readonly domainHash: string) {}
+
+  static async acquire(directory: string, domain: unknown): Promise<Journal> {
+    await mkdir(directory, { recursive: true, mode: 0o700 });
+    const domainHash = fingerprint(canonical(domain));
+    const lockPath = join(directory, "lock");
+    try {
+      await durableCreate(lockPath, { pid: process.pid });
+    } catch (error) {
+      if (!(error instanceof Error) || !("code" in error) || error.code !== "EEXIST") throw error;
+      const old = z.object({ pid: z.number().int().positive() }).strict().parse(JSON.parse(await readFile(lockPath, "utf8")));
+      try {
+        process.kill(old.pid, 0);
+      } catch (cause) {
+        if (!(cause instanceof Error) || !("code" in cause) || cause.code !== "ESRCH") throw cause;
+        // Only a proven dead writer can relinquish this exclusive local lock.
+        await unlink(lockPath);
+        return Journal.acquire(directory, domain);
+      }
+      throw new ExecutionError("LOCK", "checkpoint has a live writer");
+    }
+    const journal = new Journal(directory, domainHash);
+    try {
+      const names = await readdir(directory);
+      if (names.includes("domain.json")) {
+        const previous: unknown = JSON.parse(await readFile(join(directory, "domain.json"), "utf8"));
+        if (canonical(previous) !== canonical(domain)) throw new ExecutionError("DOMAIN", "checkpoint domain changed");
+      } else {
+        await durableCreate(join(directory, "domain.json"), domain);
+      }
+      await journal.syncDirectory();
+      return journal;
+    } catch (error) {
+      await journal.close();
+      throw error;
+    }
+  }
+
+  async syncDirectory(): Promise<void> {
+    const directory = await open(this.directory, "r");
+    try { await directory.sync(); } finally { await directory.close(); }
+  }
+
+  async intents(): Promise<readonly Intent[]> {
+    const names = (await readdir(this.directory)).filter((name) => name.endsWith(".intent.json"));
+    const records = await Promise.all(names.map(async (name) => {
+      const record = intent.parse(JSON.parse(await readFile(join(this.directory, name), "utf8")));
+      if (name !== `${record.id}.intent.json`) throw new ExecutionError("INTENT", "intent filename differs from operation identity");
+      return record;
+    }));
+    for (const record of records) {
+      if (record.domainHash !== this.domainHash
+        || !names.includes(`${record.id}.intent.json`)) throw new ExecutionError("DOMAIN", "foreign intent");
+    }
+    if (new Set(records.map((r) => r.nonce)).size !== records.length) throw new ExecutionError("INTENT", "multiple intents claim the same nonce");
+    return records.sort((a, b) => BigInt(a.nonce) < BigInt(b.nonce) ? -1 : 1);
+  }
+
+  async persistIntent(record: Intent): Promise<void> {
+    if (record.domainHash !== this.domainHash) throw new ExecutionError("DOMAIN", "foreign intent");
+    await durableCreate(join(this.directory, `${record.id}.intent.json`), record);
+    await this.syncDirectory();
+  }
+
+  async completed(record: Intent): Promise<Completion | undefined> {
+    const name = `${record.id}.receipt.json`;
+    if (!(await readdir(this.directory)).includes(name)) return undefined;
+    const result = completion.parse(JSON.parse(await readFile(join(this.directory, name), "utf8")));
+    if (result.intentHash !== fingerprint(canonical(record))
+      || result.receipt.transactionHash !== record.transactionHash) {
+      throw new ExecutionError("INTENT", "receipt does not bind this exact signed intent");
+    }
+    return result;
+  }
+
+  async complete(record: Intent, result: Completion): Promise<void> {
+    if (result.intentHash !== fingerprint(canonical(record))) throw new ExecutionError("INTENT", "wrong intent receipt");
+    await durableCreate(join(this.directory, `${record.id}.receipt.json`), result);
+    await this.syncDirectory();
+  }
+
+  async close(): Promise<void> {
+    await unlink(join(this.directory, "lock"));
+    await this.syncDirectory();
+  }
+}
diff --git a/scripts/recovery/dtf-migration/payloads.ts b/scripts/recovery/dtf-migration/payloads.ts
new file mode 100644
index 00000000..8e442617
--- /dev/null
+++ b/scripts/recovery/dtf-migration/payloads.ts
@@ -0,0 +1,127 @@
+import { AbiCoder, keccak256 } from "ethers";
+import { categories, PreparationError } from "./schema.js";
+import type { Domain, NftOriginal, Original, PreparationInput } from "./schema.js";
+
+const coder = AbiCoder.defaultAbiCoder();
+const independentTuple = "tuple(address recipient,bytes32 evidenceId,tuple(bytes32 entitlementId,uint256 originalEth,uint256 originalDtf,bytes32 evidenceId)[] entitlements)";
+const nftTuple = "tuple(address collection,uint256 tokenId,uint256 originalUnits,uint256 originalEth,uint256 originalDtf,bytes32 evidenceId,bool contributionsKnown)";
+export const weightedCollection = "0xfe4cc6d5faafdf210af4e728f4108fcaad9bb65e";
+export const earlierCollection = "0x15666f0b4c8d09d046d2aa9048afcaf49e8cb391";
+export type IndependentPayload = {
+  readonly recipient: string;
+  readonly evidenceId: string;
+  readonly entitlements: readonly Original[];
+};
+export type ConfigurationPayload = {
+  readonly independent: readonly IndependentPayload[];
+  readonly nfts: readonly NftOriginal[];
+};
+
+export function configurationId(domain: Domain, input: IndependentPayload | NftOriginal): string {
+  const tuple = "recipient" in input ? independentTuple : nftTuple;
+  return keccak256(coder.encode(["uint256", "address", "bytes32", tuple],
+    [domain.chainId, domain.proxy, domain.snapshotId, input]));
+}
+
+export function nftOrigin(domain: Domain, input: NftOriginal): string {
+  return keccak256(coder.encode(["string", "uint256", "address", "bytes32", "address", "uint256"],
+    ["migration.nft", domain.chainId, domain.proxy, domain.snapshotId, input.collection, input.tokenId]));
+}
+
+const blockedGate = {
+  "weighted-liquid": "E2: ordinary-transfer contribution ancestry and consumption unproved",
+  "earlier-liquid": "E2: ordinary-transfer contribution ancestry and consumption unproved",
+  "weighted-receipt": "E2: gon ancestry and proportional consumption unproved",
+  "earlier-receipt": "E2: receipt ancestry/supply discrepancy and disabled exits",
+  "weighted-sy": "E2: wrapper look-through ancestry and nonduplication unproved",
+  "token-staking": "E1/E2: nontransferable claim composition and attribution unproved",
+  "claim-vault": "E1/E2: remaining claim ancestry and custody path unproved",
+  "underlying-se": "E1/E2: complete source discovery and contribution attribution unproved",
+  "fungible-lp": "E1/E2: complete source discovery and contribution attribution unproved",
+  "earlier-liquidation": "SB-E1/E2/E3 disabled earlier SE exits; SB-E4 liquid conversion unproved",
+} as const;
+
+export function dispositions(input: PreparationInput) {
+  return categories.map((category) => {
+    switch (category) {
+      case "independent": return { category, disposition: "bounded", gate: "verified disjoint originals only" };
+      case "weighted-nft":
+      case "earlier-nft": return { category, disposition: "bounded", gate: "configuration only; real holder surrender required" };
+      default: return { category, disposition: "blocked", gate: blockedGate[category] };
+    }
+  }).map((row) => ({ ...row, records: input.exposures.filter((e) => e.category === row.category).length.toString() }));
+}
+
+export function buildPayloads(input: PreparationInput): ConfigurationPayload {
+  const origins = new Map(input.exposures.map((e) => [e.originId, e]));
+  if (origins.size !== input.exposures.length) throw new PreparationError("PROVENANCE", "duplicate origin");
+  const used = new Set<string>();
+  const claimOrigin = (id: string, category: string): void => {
+    const origin = origins.get(id);
+    if (!origin || origin.category !== category) throw new PreparationError("PROVENANCE", `missing matching origin ${id}`);
+    if (used.has(id)) throw new PreparationError("PROVENANCE", `overlapping original ${id}`);
+    used.add(id);
+  };
+  for (const row of dispositions(input)) {
+    if (row.disposition === "blocked" && row.records !== "0") throw new PreparationError("BLOCKED", `${row.category}: ${row.gate}`);
+  }
+  const independent = input.independent.map((row) => {
+    for (const item of row.entitlements) claimOrigin(item.original.entitlementId, "independent");
+    return { recipient: row.recipient, evidenceId: row.evidenceId,
+      entitlements: row.entitlements.map((e) => e.original).sort((a, b) => a.entitlementId.localeCompare(b.entitlementId)) };
+  }).sort((a, b) => a.recipient.localeCompare(b.recipient));
+  if (new Set(independent.map((r) => r.recipient)).size !== independent.length) {
+    throw new PreparationError("INPUT", "duplicate recipient; supply one complete replacement");
+  }
+  const nfts = input.nfts.map(({ original }) => {
+    if (input.domain.chainId !== "4663") throw new PreparationError("DOMAIN", "NFT sources require chain 4663");
+    const category = original.collection === weightedCollection ? "weighted-nft"
+      : original.collection === earlierCollection ? "earlier-nft" : undefined;
+    if (!category) throw new PreparationError("BLOCKED", `unsupported NFT collection ${original.collection}`);
+    const id = nftOrigin(input.domain, original);
+    claimOrigin(id, category);
+    if (origins.get(id)?.originalUnits !== original.originalUnits) {
+      throw new PreparationError("PROVENANCE", "NFT original units differ from reconciled origin");
+    }
+    return original;
+  }).sort((a, b) => a.collection.localeCompare(b.collection)
+    || (BigInt(a.tokenId) < BigInt(b.tokenId) ? -1 : BigInt(a.tokenId) > BigInt(b.tokenId) ? 1 : 0));
+  if (used.size !== origins.size) throw new PreparationError("PROVENANCE", "unassigned origin; no silent omission");
+  if (new Set(input.issueRecipients).size !== input.issueRecipients.length) {
+    throw new PreparationError("INPUT", "duplicate issuance recipient");
+  }
+  for (const recipient of input.issueRecipients) {
+    if (!independent.some((r) => r.recipient === recipient)) throw new PreparationError("INPUT", "issuance lacks configuration");
+  }
+  if (input.harvest.steps.length > 1 && input.harvest.steps.some((step) =>
+    !["WeightedClaim", "WeightedPrincipal", "WeightedRewards"].includes(step.stage))) {
+    throw new PreparationError("INPUT", "batch bound is eight weighted claims or one other recovery step");
+  }
+  for (const step of input.harvest.steps) {
+    switch (step.stage) {
+      case "WeightedClaim":
+      case "WeightedPrincipal":
+      case "WeightedRewards":
+      case "EarlierClaim":
+      case "EarlierSale":
+        if (BigInt(step.tokenId) < 3n || step.amount !== "0"
+          || (step.stage !== "EarlierSale" && step.minimum !== "0")) {
+          throw new PreparationError("INPUT", "invalid NFT recovery fields");
+        }
+        break;
+      case "WeightedUnstake":
+      case "WeightedConvert":
+      case "Donate":
+        if (step.tokenId !== "0" || step.amount === "0"
+          || (step.stage === "WeightedUnstake" && step.minimum !== "0")) {
+          throw new PreparationError("INPUT", "invalid conversion recovery fields");
+        }
+        break;
+      default: step.stage satisfies never;
+    }
+  }
+  if (input.harvest.steps.length > 0 && (input.domain.chainId !== "4663" || input.harvest.deadline === "0")) {
+    throw new PreparationError("DOMAIN", "recovery requires chain 4663 and deadline");
+  }
+  return { independent, nfts };
+}
diff --git a/scripts/recovery/dtf-migration/preparation.fixture.ts b/scripts/recovery/dtf-migration/preparation.fixture.ts
new file mode 100644
index 00000000..1464966e
--- /dev/null
+++ b/scripts/recovery/dtf-migration/preparation.fixture.ts
@@ -0,0 +1,141 @@
+// Synthetic wire fixture only. This is not an EVM or a real pricing proof.
+import { AbiCoder, Interface, keccak256 } from "ethers";
+import type { ParamType } from "ethers";
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join, resolve } from "node:path";
+import { createServer } from "node:http";
+import { once } from "node:events";
+import { text } from "node:stream/consumers";
+import { z } from "zod";
+import { canonical, fingerprint } from "./provenance.js";
+import { earlierCollection, nftOrigin, weightedCollection } from "./payloads.js";
+import { domain as domainSchema, nftOriginal, preparationInput } from "./schema.js";
+
+export const h = (n: number): string => `0x${n.toString(16).padStart(64, "0")}`;
+export const a = (n: number): string => `0x${n.toString(16).padStart(40, "0")}`;
+const coder = AbiCoder.defaultAbiCoder();
+function zero(param: ParamType): unknown {
+  if (param.baseType === "tuple") return param.components?.map(zero);
+  if (param.baseType === "array" && param.arrayChildren) {
+    const child = param.arrayChildren;
+    return Array.from({ length: Math.max(0, param.arrayLength ?? 0) }, () => zero(child));
+  }
+  if (param.type === "address") return a(1);
+  if (param.type === "bool") return false;
+  if (param.type.startsWith("bytes")) return param.type === "bytes" ? "0x" : h(0);
+  return 0n;
+}
+
+export async function fixture() {
+  const root = await mkdtemp(join(tmpdir(), "dtf-prepare-test-"));
+  const artifactPath = resolve("out/UniswapV4DetfMigrationFacet.sol/UniswapV4DetfMigrationFacet.json");
+  const artifactBytes = await readFile(artifactPath);
+  const artifact = z.object({ abi: z.array(z.unknown()) }).parse(JSON.parse(artifactBytes.toString()));
+  const iface = new Interface(JSON.stringify(artifact.abi));
+  const fragment = iface.getFunction("migrationSnapshot");
+  const output = fragment?.outputs[0];
+  if (!fragment || !output?.components) throw new Error("warm Migration ABI required");
+  const values = output.components.map(zero);
+  const set = (name: string, value: unknown): void => {
+    const index = output.components?.findIndex((p) => p.name === name);
+    if (index === undefined || index < 0) throw new Error(`missing ${name}`);
+    values[index] = value;
+  };
+  set("version", 1n);
+  set("chainId", 4663n);
+  set("consumer", a(10));
+  set("source", [a(10), a(11), a(12), a(13)]);
+  const snapshotId = keccak256(coder.encode(["string", output], ["IndexedEx.frozen-original-credit", values]));
+  set("id", snapshotId);
+  const snapshot = iface.encodeFunctionResult(fragment, [values]);
+  const preview = new Interface(["function previewOriginalCredit(uint256,uint256) view returns(uint256)"]);
+  const changes = { chain: "0x1237", code: "0x6000", snapshot, combinedMismatch: false };
+  const methods: string[] = [];
+  const rpcRequest = z.object({ id: z.number(), method: z.string(), params: z.array(z.unknown()) });
+  const server = createServer(async (request, response) => {
+      const rpc = rpcRequest.parse(JSON.parse(await text(request)));
+      methods.push(rpc.method);
+      let result: unknown;
+      switch (rpc.method) {
+        case "eth_chainId": result = changes.chain; break;
+        case "eth_getBlockByNumber": result = { number: "0x64", hash: h(100), parentHash: h(99) }; break;
+        case "eth_getCode": result = changes.code; break;
+        case "eth_call": {
+          const call = z.object({ data: z.string() }).parse(rpc.params[0]);
+          if (call.data === iface.encodeFunctionData(fragment)) result = changes.snapshot;
+          else {
+            const args = preview.decodeFunctionData("previewOriginalCredit", call.data);
+            const eth = BigInt(args[0]);
+            const dtf = BigInt(args[1]);
+            const value = eth / 10n + dtf / 11n + (changes.combinedMismatch && eth > 0n && dtf > 0n ? 1n : 0n);
+            result = preview.encodeFunctionResult("previewOriginalCredit", [value]);
+          }
+          break;
+        }
+        default:
+          response.end(JSON.stringify({ jsonrpc: "2.0", id: rpc.id, error: { code: -32601, message: "read not supported" } }));
+          return;
+      }
+      response.setHeader("Content-Type", "application/json");
+      response.end(JSON.stringify({ jsonrpc: "2.0", id: rpc.id, result }));
+  });
+  const ready = once(server, "listening", { signal: AbortSignal.timeout(5000) });
+  server.listen(0, "127.0.0.1");
+  await ready;
+  const listener = server.address();
+  if (!listener || typeof listener === "string") throw new Error("missing TCP listener");
+  const envName = `DTF_TEST_RPC_${listener.port}`;
+  process.env[envName] = `http://127.0.0.1:${listener.port}`;
+  const domain = {
+    chainId: "4663", proxy: a(10), snapshotId, blockNumber: "100", blockHash: h(100),
+    rpcEnv: envName, snapshotArtifact: artifactPath,
+    bindings: [
+      { role: "proxy", address: a(10), codeHash: keccak256("0x6000") },
+      { role: "registry", address: a(11), codeHash: keccak256("0x6000") },
+      { role: "package", address: a(12), codeHash: keccak256("0x6000") },
+      { role: "facet", address: a(13), codeHash: keccak256("0x6000") },
+    ],
+  };
+  const original = { entitlementId: h(200), originalEth: "90071992547409931234",
+    originalDtf: "110", evidenceId: h(201) };
+  const nft = { collection: weightedCollection, tokenId: "3", originalUnits: "100",
+    originalEth: "100", originalDtf: "22", evidenceId: h(202), contributionsKnown: true };
+  const earlier = { ...nft, collection: earlierCollection, originalUnits: "2281854312954086546", evidenceId: h(204) };
+  const nftId = nftOrigin(domainSchema.parse(domain), nftOriginal.parse(nft));
+  const earlierId = nftOrigin(domainSchema.parse(domain), nftOriginal.parse(earlier));
+  const exposures = [
+    { originId: h(200), category: "independent", originalUnits: "100", descendants: [{ id: h(210), units: "80" }],
+      recoveredUnits: "10", excludedUnits: "10" },
+    { originId: nftId, category: "weighted-nft", originalUnits: "100", descendants: [{ id: h(211), units: "100" }],
+      recoveredUnits: "0", excludedUnits: "0" },
+    { originId: earlierId, category: "earlier-nft", originalUnits: earlier.originalUnits,
+      descendants: [{ id: h(212), units: earlier.originalUnits }], recoveredUnits: "0", excludedUnits: "0" },
+  ];
+  const evidence = { originals: [original, nft, earlier], exposures };
+  const evidencePath = join(root, "evidence.json");
+  const raw = canonical(evidence);
+  await writeFile(evidencePath, raw);
+  const input = preparationInput.parse({
+    version: "dtf-operator-preparation-v1", purpose: "synthetic-local", domain,
+    sources: [
+      { id: "proof", path: evidencePath, sha256: fingerprint(raw), bytes: Buffer.byteLength(raw).toString(),
+        provenance: { kind: "file", authority: "Synthetic wire fixture; not an approved historical allocation" } },
+      { id: "abi", path: artifactPath, sha256: fingerprint(artifactBytes), bytes: artifactBytes.length.toString(),
+        provenance: { kind: "file", authority: "Warm artifact from accepted source base421072a7" } },
+    ],
+    exposures: exposures.map((e, i) => ({ ...e, proof: { sourceId: "proof", pointer: `/exposures/${i}` } })),
+    independent: [{ recipient: a(20), evidenceId: h(203),
+      entitlements: [{ original, proof: { sourceId: "proof", pointer: "/originals/0" } }] }],
+    nfts: [
+      { original: nft, proof: { sourceId: "proof", pointer: "/originals/1" } },
+      { original: earlier, proof: { sourceId: "proof", pointer: "/originals/2" } },
+    ],
+    issueRecipients: [a(20)], harvest: { steps: [], deadline: "0" },
+  });
+  return { root, input, changes, methods, evidencePath, async close() {
+    await new Promise<void>((accept, reject) => server.close((error) => error ? reject(error) : accept()));
+    delete process.env[envName];
+    await rm(root, { recursive: true });
+  } };
+}
