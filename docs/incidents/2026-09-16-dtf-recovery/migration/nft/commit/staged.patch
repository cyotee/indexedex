+
+    function test_rewardOnlyWeightedAndBurnedEarlierEarnNoCredit() public {
+        _configureNft(WEIGHTED, 3);
+        address weightedHolder_ = IERC721(WEIGHTED).ownerOf(3);
+        vm.prank(weightedHolder_);
