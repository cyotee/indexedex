\"inputs\":[{\"name\":\"collection_\",\"type\":\"address\",\"internalType\":\"address\"},{\"name\":\"tokenId_\",\"type\":\"uint256\",\"internalType\":\"uint256\"}],\"outputs\":[{\"name\":\"\",\"type\":\"tuple\",\"internalType\":\"struct IUniswapV4DetfMigrationRecovery.NftRecovery\",\"components\":[{\"name\":\"principalClaimed\",\"type\":\"uint256\",\"internalType\":\"uint256\"},{\"name\":\"rewardsClaimed\",\"type\":\"uint256\",\"internalType\":\"uint256\"},{\"name\":\"receiptShares\",\"type\":\"uint256\",\"internalType\":\"uint256\"},{\"name\":\"sold\",\"type\":\"bool\",\"internalType\":\"bool\"}]}],\"stateMutability\":\"view\"},{\"type\":\"function\",\"name\":\"migrationRecoveryGons\",\"inputs\":[],\"outputs\":[{\"name\":\"\",\"type\":\"uint256\",\"internalType\":\"uint256\"}],\"stateMutability\":\"view\"},{\"type\":\"function\",\"name\":\"migrationRecoveryInventory\",\"inputs\":[{\"name\":\"token_\",\"type\":\"address\",\"internalType\":\"address\"}],\"outputs\":[{\"name\":\"\",\"type\":\"uint256\",\"internalType\":\"uint256\"}],\"stateMutability\":\"view\"},{\"type\":\"function\",\"name\":\"recoverMigrationNfts\",\"inputs\":[{\"name\":\"steps_\",\"type\":\"tuple[]\",\"internalType\":\"struct IUniswapV4DetfMigrationRecovery.Step[]\",\"components\":[{\"name\":\"stage\",\"type\":\"uint8\",\"internalType\":\"enum IUniswapV4DetfMigrationRecovery.Stage\"},{\"name\":\"tokenId\",\"type\":\"uint256\",\"internalType\":\"uint256\"},{\"name\":\"amount\",\"type\":\"uint256\",\"internalType\":\"uint256\"},{\"name\":\"minimum\",\"type\":\"uint256\",\"internalType\":\"uint256\"}]},{\"name\":\"deadline_\",\"type\":\"uint256\",\"internalType\":\"uint256\"}],\"outputs\":[],\"stateMutability\":\"nonpayable\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"migrationRecoveryInventory(address)\":{\"details\":\"Weighted receipts reflect the last recovery claim/unstake synchronization.\"},\"migrationRecoveryGons()\":{\"details\":\"Actual source debit must still preserve every unbooked gon, including fractions.\"},\"migrationEarlierReceiptInternalShares()\":{\"details\":\"Whole external representation is B/1e9; fractional internal representation is B%1e9.\"}},\"events\":{\"MigrationWeightedSyRedeemed(uint256,uint256,uint256,uint256,uint256)\":{\"details\":\"The synchronized divisor values recovery only, never configured compensation.\"},\"MigrationRecoveryRevalued(address,uint256,uint256,uint256,uint256)\":{\"details\":\"Not a claim, receipt transfer, principal issuance or compensation.\"},\"MigrationRecoveryDonated(address,uint256,uint256)\":{\"details\":\"Selected capital leaves recovery inventory once. Any unjoined remainder is held\"}},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"recoverMigrationNfts((uint8,uint256,uint256,uint256)[],uint256)\":{\"notice\":\"Execute only selected stages atomically. A later transaction cannot undo prior stages.\"},\"migrationRecoveryInventory(address)\":{\"notice\":\"Undonated native token amounts; earlier receipt inventory is external shares (scale 1e9). Later index growth is reconciled during the next such operation, not by this view.\"},\"migrationRecoveryGons()\":{\"notice\":\"Attributed weighted receipt gons; their synchronized whole value is convertible.\"},\"migrationEarlierReceiptInternalShares()\":{\"notice\":\"Standalone ER custody B in exact internal shares, separate from NFT external inventory E. Total booked internal ownership is checked E*1e9+B; neither query changes the other's unit.\"}},\"events\":{\"MigrationWeightedSyRedeemed(uint256,uint256,uint256,uint256,uint256)\":{\"notice\":\"Actual WS gons received from selected WY; conversion dust stays at the legacy wrapper.\"},\"MigrationRecoveryRevalued(address,uint256,uint256,uint256,uint256)\":{\"notice\":\"Native representation of existing attributed gons at a synchronized divisor.\"},\"MigrationRecoveryDonated(address,uint256,uint256)\":{\"notice\":\" in the existing reserve residual domain, not spendable recovery inventory.\"}},\"notice\":\"Retained current-owner recovery of admitted chain-4663 NFTs, weighted liquid, SY and fixed DTF-custody SE.\",\"version\":1}},\"settings\":{\"compilationTarget\":{\"contracts/vaults/detf/protocols/dexes/uniswap/v4/migration/interfaces/IUniswapV4DetfMigrationRecovery.sol\":\"IUniswapV4DetfMigrationRecovery\"},\"evmVersion\":\"osaka\",\"libraries\":{},\"metadata\":{\"bytecodeHash\":\"ipfs\"},\"optimizer\":{\"enabled\":true,\"runs\":1},\"remappings\":[\"@battlechain-contracts/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/src/\",\"@crane/=lib/crane/\",\"@matterlabs/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/lib/battlechain-contracts/lib/\",\"@nomicfoundation/=node_modules/@nomicfoundation/\",\"@opengsn/=node_modules/@opengsn/\",\"@openzeppelin/=node_modules/@openzeppelin/\",\"@oz/=lib/crane/lib/openzeppelin-contracts/\",\"@ozu/=lib/crane/contracts/external/openzeppelin-upgradeable/\",\"battlechain-contracts/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/lib/battlechain-contracts/\",\"battlechain-lib-mocks/=lib/crane/lib/battlechain-lib/test/mocks/\",\"battlechain-lib/=lib/crane/lib/battlechain-lib/src/\",\"battlechain-safe-harbor-contracts/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/\",\"chainlink-ccip/=lib/crane/lib/chainlink-local/lib/chainlink-ccip/chains/evm/contracts/vendor/optimism/interop-lib/v0/src/\",\"chainlink-evm/=lib/crane/lib/chainlink-local/lib/chainlink-evm/\",\"chainlink-local/=lib/crane/lib/chainlink-local/src/\",\"clones/=lib/crane/contracts/external/clones-with-immutable-args/\",\"contracts/external/solady/=lib/crane/contracts/external/solady/\",\"contracts/protocols/launchpads/uniswap/continuous-clearing/=lib/crane/contracts/protocols/launchpads/uniswap/continuous-clearing/\",\"contracts/solady/=lib/crane/contracts/external/solady/\",\"crane/=lib/crane/\",\"createx/=lib/crane/lib/battlechain-lib/lib/battlechain-safe-harbor-contracts/lib/createx/sr