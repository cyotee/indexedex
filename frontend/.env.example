# Frontend feature flags (redesign)
NEXT_PUBLIC_SHOW_DEBUG=false
NEXT_PUBLIC_SHOW_LAUNCH_BANNER=false
NEXT_PUBLIC_LAUNCH_TOKEN_ADDRESS=
NEXT_PUBLIC_FEATURED_EARN_ADDRESSES=
NEXT_PUBLIC_DOCS_URL=
NEXT_PUBLIC_AUDIT_URL=
NEXT_PUBLIC_DEFAULT_DEPLOYMENT_ENVIRONMENT=supersim_sepolia

# DETF mint/bond/sell embed on Earn detail — keep false until mint/bond e2e smoke
NEXT_PUBLIC_EARN_DETF_EMBED=false

# USD price source: none | (future adapters). When none, AmountField hides $
NEXT_PUBLIC_USD_PRICE_SOURCE=none

# Dual brand deploys (same layout; theme + name only). No runtime toggle.
# Set per Vercel project so each public URL is a single brand for testers.
# pachira = green theme | indexedex = dark blue theme
# Vercel project "pachira"  → NEXT_PUBLIC_DEFAULT_BRAND=pachira
# Vercel project "indexedex" → NEXT_PUBLIC_DEFAULT_BRAND=indexedex
NEXT_PUBLIC_DEFAULT_BRAND=pachira

# Playwright connected-wallet E2E (injected EIP-1193, not MetaMask)
# E2E_RPC_URL=http://127.0.0.1:8545
# E2E_SKIP_WEBSERVER=1
# E2E_BASE_URL=http://127.0.0.1:3000
