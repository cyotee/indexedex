{
  "name": "indexedex-frontend",
  "private": true,
  "version": "0.0.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @indexedex/app-dtf",
    "dev:dtf": "npm run dev -w @indexedex/app-dtf",
    "build": "npm run build -w @indexedex/app-dtf",
    "build:dtf": "npm run build -w @indexedex/app-dtf",
    "test": "npm run test -w @indexedex/app-dtf",
    "test:e2e": "npm run test:e2e -w @indexedex/app-dtf",
    "test:e2e:dtf": "npm run test:e2e -w @indexedex/app-dtf",
    "test:e2e:dtf:live": "npm run test:e2e:live -w @indexedex/app-dtf",
    "typecheck": "npm run typecheck -w @indexedex/app-dtf",
    "check": "npm run check -w @indexedex/app-dtf",
    "lint": "npm run lint -w @indexedex/app-dtf"
  }
}
