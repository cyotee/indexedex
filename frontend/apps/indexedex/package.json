{
  "name": "@indexedex/app-indexedex",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack -p 3002",
    "dev:indexedex": "NEXT_PUBLIC_SITE_DEPLOYMENT=indexedex next dev --webpack -p 3002",
    "dev:dtf": "NEXT_PUBLIC_SITE_DEPLOYMENT=dtf next dev --webpack -p 3003",
    "dev:fresh": "node scripts/next.mjs dev --clean -- --webpack -p 3002",
    "clean": "rm -rf .next .next-indexedex .next-dtf",
    "build": "npm run lint && next build --webpack",
    "start": "next start",
    "lint": "eslint app",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "vitest run",
    "test:deployment": "node --test scripts/site-deployment.test.cjs",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:deployment": "playwright test --config playwright.deployment.config.ts",
    "test:e2e:live": "playwright test e2e/staking-bond-live.spec.ts e2e/staking-prices-live.spec.ts e2e/staking-migration-live.spec.ts e2e/swap-routes-live.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "check": "npm run lint && npm run typecheck && npm run test && npm run test:deployment",
    "hooks": "npx wagmi generate"
  },
  "dependencies": {
    "@tanstack/react-query": "5.102.8",
    "@uniswap/permit2-sdk": "^1.4.0",
    "next": "16.3.5",
    "porto": "~0.2.35",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tevm": "^1.0.0-next.149",
    "viem": "^2.43.5",
    "voltaire": "npm:@tevm/voltaire",
    "wagmi": "^2.19.5",
    "@indexedex/protocol": "*",
    "@rainbow-me/rainbowkit": "2.2.11"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.1.12",
    "@types/node": "^20.12.10",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wagmi/chains": "^1.8.0",
    "@wagmi/cli": "^2.5.0",
    "autoprefixer": "^10.4.21",
    "bufferutil": "^4.0.8",
    "encoding": "^0.1.13",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.5",
    "lokijs": "^1.5.12",
    "pino-pretty": "^10.3.1",
    "postcss": "^8.5.6",
    "supports-color": "^9.4.0",
    "tailwindcss": "^4.1.12",
    "typescript": "5.4.5",
    "utf-8-validate": "^5.0.2",
    "vitest": "^4.1.8"
  }
}
