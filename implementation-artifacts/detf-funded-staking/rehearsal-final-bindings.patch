+        h.decimals1 = Decimals.tokenDec(tokens[1], predicted);
+        h.decimals2 = Decimals.tokenDec(tokens[2], predicted);
+        h.se0 = ses[0]; h.se1 = ses[1]; h.se2 = ses[2];
