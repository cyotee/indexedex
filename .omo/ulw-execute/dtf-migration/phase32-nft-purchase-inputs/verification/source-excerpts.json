    "contract": "0x4886f86cd0dfff8b8a836f858925ed4de3a2b291",
    "member": "contracts/vaults/detf/protocols/dexes/uniswap/v4/detf/UniswapV4DetfTarget.sol",
    "sourceSha256": "023a914aeb8535d8805b017db35fb64a1181808b2d094965d5a2edd2591c77ff",
