# All NEXT_PUBLIC values are shipped to the browser. Never use secret API keys.
# Optional browser-safe CDP key for OnchainKit identity services.
# Restrict allowed origins in https://portal.cdp.coinbase.com/
NEXT_PUBLIC_CDP_API_KEY=

# Optional: enables the WalletConnect connector.
# Create a project and allow your app origin at https://cloud.reown.com/
NEXT_PUBLIC_WC_PROJECT_ID=

# Supported: 8453 (Base, default) or 84532 (Base Sepolia).
NEXT_PUBLIC_CHAIN_ID=8453
# Optional browser-safe RPC URL for the selected chain.
NEXT_PUBLIC_RPC_URL=

# Analytics is off unless explicitly enabled.
NEXT_PUBLIC_ONCHAINKIT_ANALYTICS=false
NEXT_PUBLIC_APP_NAME="My OnchainKit App"
NEXT_PUBLIC_APP_DESCRIPTION="Connect a wallet and explore Base with OnchainKit."
