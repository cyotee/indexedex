{
  "name": "indexedex",
  "version": "0.0.1",
  "description": "Composed Indexed Liquidity",
  "private": true,
  "type": "module",
  "main": "index.js",
  "directories": {
    "lib": "lib"
  },
  "scripts": {
    "test": "forge test",
    "test:default": "forge test",
    "test:ci": "FOUNDRY_PROFILE=ci forge test",
    "test:fork": "FOUNDRY_PROFILE=fork forge test",
    "test:hardhat": "hardhat build lib/crane/contracts/test/stubs/lock/Lock.sol && hardhat test mocha --no-compile",
    "typecheck:hardhat": "tsc --project tsconfig.hardhat.json --noEmit",
    "test:ci-fork": "FOUNDRY_PROFILE=ci_fork forge test",
    "compile": "clear && forge compile --sizes",
    "coverage": "forge coverage",
    "update-file-index": "./scripts/generate-file-index.sh",
    "prepare": "husky",
    "sizes": "forge compile --sizes | tee SIZES.log"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cyotee/indexedex.git"
  },
  "keywords": [
    "defi",
    "EVM",
    "Solidity"
  ],
  "author": "cyotee doge",
  "license": "BUSL-1.1",
  "bugs": {
    "url": "https://github.com/cyotee/indexedex/issues"
  },
  "homepage": "https://github.com/cyotee/indexedex#readme",
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@babel/core": "^7.28.3",
    "@babel/runtime": "^7.28.3",
    "@nomicfoundation/hardhat-ethers": "^4.2.1",
    "@nomicfoundation/hardhat-ethers-chai-matchers": "^3.0.13",
    "@nomicfoundation/hardhat-foundry": "^3.0.5",
    "@nomicfoundation/hardhat-ignition": "^3.1.9",
    "@nomicfoundation/hardhat-ignition-ethers": "^3.1.6",
    "@nomicfoundation/hardhat-ignition-viem": "^3.1.6",
    "@nomicfoundation/hardhat-keystore": "^3.1.2",
    "@nomicfoundation/hardhat-mocha": "^4.0.1",
    "@nomicfoundation/hardhat-network-helpers": "^3.0.12",
    "@nomicfoundation/hardhat-node-test-runner": "^3.1.1",
    "@nomicfoundation/hardhat-toolbox-mocha-ethers": "^4.0.0",
    "@nomicfoundation/hardhat-toolbox-viem": "^5.0.7",
    "@nomicfoundation/hardhat-typechain": "^3.1.2",
    "@nomicfoundation/hardhat-verify": "^3.1.3",
    "@nomicfoundation/hardhat-viem": "^3.0.10",
    "@nomicfoundation/hardhat-viem-assertions": "^3.1.4",
    "@nomicfoundation/ignition-core": "^3.1.11",
    "@types/chai": "^5.2.3",
    "@types/chai-as-promised": "^8.0.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^26.6.5",
    "axios": "^1.11.0",
    "boxen": "^8.0.1",
    "chalk": "^4.1.2",
    "chai": "^6.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^11.1.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.21.2",
    "ethers": "^6.17.0",
    "figlet": "^1.8.0",
    "form-data": "^4.0.4",
    "fuse.js": "^7.0.0",
    "gradient-string": "^3.0.0",
    "hardhat": "^3.20.0",
    "helmet": "^8.1.0",
    "husky": "^9.1.7",
    "inquirer": "^12.5.0",
    "jsonwebtoken": "^9.0.2",
